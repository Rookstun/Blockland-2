var dotsTxt: string = "                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n        ● ●   ●                           ●     ●       \n                                                        \n                                                        \n                    ●     ●       ●                     \n                                                        \n                                                        \n      ● ●   ●                           ●   ●   ●       \n                                                        \n                                                        \n                      ●   ●   ●                         \n                                                        \n                                                        \n        ●   ●   ●                     ●   ●   ●         \n                                                        \n                                                        \n                            ●   ●                       \n                                                        \n                                                        "
var wallsTxt: string = "████████████████████████████████████████████████████████\n██                                                    ██\n██                                                    ██\n██                                                    ██\n██                                                    ██\n██                                                    ██\n██                                                    ██\n██                                                    ██\n██                                          []        ██\n██    ████████████                      ████████████  ██\n██                                                    ██\n██                                                    ██\n██                ████████████████████                ██\n██                                                    ██\n██                                                    ██\n██  ████████████                      ██████████████  ██\n██                                                    ██\n██                                                    ██\n██                  ██████████████                    ██\n██                                                    ██\n██                                                    ██\n██    ██████████████                ██████████████    ██\n██                                                    ██\n██              ^^^^                    ^^^^          ██\n████████████████████████████████████████████████████████\n████████████████████████████████████████████████████████"
var coinsLeft: int = 0
var score: int = 0
var high: int = 0
var best: Map<string, int>
var lives: int = 3
var level: int = 1
var lv: int = 0
var pr: int = 23
var pc: int = 2
var jt: int = 0
var pn: float = 0.0
var en: float = 0.0
var pacTxt: string = ""
var ea: int[] = [0, 0, 0, 0]
var er: int[] = [0, 0, 0, 0]
var ec: int[] = [0, 0, 0, 0]
var ed: int[] = [1, 1, 1, 1]
var gt0: string = ""
var gt1: string = ""
var gt2: string = ""
var gt3: string = ""
var dead: bool = false
var msg: string = "                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                    SIT DOWN TO PLAY                    \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        "
var msgK: int = 0            // message colour: 0 yellow, 1 red, 2 white
var hud: string = "FAIK PLATFORMER"
var info: string = ""
var pingT: float = -9.0
var pingHi: bool = false
var fxT: float = -9.0
var fxKind: int = 0
var p0: float = 1.0
var v0: float = 0.0
var p1: float = 1.0
var v1: float = 0.0

out walls_t: string = wallsTxt
out dots_t: string = dotsTxt
out pac_t: string = pacTxt
out g0_t: string = gt0
out g1_t: string = gt1
out g2_t: string = gt2
out g3_t: string = gt3
out msg_t: string = msg
out msg_c: color = if msgK.Value == 1 then ColorSRGB(255, 40, 40, 255) else if msgK.Value == 2 then ColorSRGB(255, 255, 255, 255) else ColorSRGB(255, 230, 60, 255)
out hud_t: string = hud
out info_t: string = info
out P0: float = p0
out V0: float = v0
out P1: float = p1
out V1: float = v1

mod showHud() {
  hud = "SCORE ${score}     HIGH ${high}"
  let spare = if lives >= 3 then "Ö Ö" else if lives == 2 then "Ö" else ""
  info = "${spare}   COINS LEFT ${coinsLeft}   LEVEL ${level}"
}

mod drawPac() {
  pacTxt = ROWA[pr] .. LC[pc] .. "Ö" .. RC[pc] .. ROWB[pr]
}

mod drawWalker(k: int) {
  let r = er[k]
  let c = ec[k]
  let t = if ea[k] == 1 then ROWA[r] .. LC[c] .. "Ω" .. RC[c] .. ROWB[r] else ""
  if k == 0 { gt0 = t }
  if k == 1 { gt1 = t }
  if k == 2 { gt2 = t }
  if k == 3 { gt3 = t }
}

mod resetDots() {
  dot.copyFrom(DOT0)
  dotsTxt = CT[lv]
  wallsTxt = WT[lv]
  coinsLeft = CNT[lv]
}

mod resetRound(now: float) {
  pr = SR[lv]
  pc = SC[lv]
  jt = 0
  dead = false
  ea[0] = EA0[lv * 4 + 0]
  er[0] = ER0[lv * 4 + 0]
  ec[0] = EC0[lv * 4 + 0]
  ed[0] = ED0[lv * 4 + 0]
  drawWalker(0)
  ea[1] = EA0[lv * 4 + 1]
  er[1] = ER0[lv * 4 + 1]
  ec[1] = EC0[lv * 4 + 1]
  ed[1] = ED0[lv * 4 + 1]
  drawWalker(1)
  ea[2] = EA0[lv * 4 + 2]
  er[2] = ER0[lv * 4 + 2]
  ec[2] = EC0[lv * 4 + 2]
  ed[2] = ED0[lv * 4 + 2]
  drawWalker(2)
  ea[3] = EA0[lv * 4 + 3]
  er[3] = ER0[lv * 4 + 3]
  ec[3] = EC0[lv * 4 + 3]
  ed[3] = ED0[lv * 4 + 3]
  drawWalker(3)
  drawPac()
  pn = now + 1.5
  en = now + 1.5
  msg = "                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                       GET READY!                       \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        "
  msgK = 0
  state = 1
  tState = now
  showHud()
}

mod newLevel(now: float) {
  lv = (level - 1) % 3
  resetDots()
  resetRound(now)
}

mod newGame(now: float) {
  score = 0
  lives = 3
  level = 1
  newLevel(now)
}

mod clearActors() {
  pacTxt = ""
  gt0 = ""
  gt1 = ""
  gt2 = ""
  gt3 = ""
}

mod die(now: float) {
  state = 3
  tState = now
  fxT = now
  fxKind = 2
  gt0 = ""
  gt1 = ""
  gt2 = ""
  gt3 = ""
}

mod checkWalkers() {
  if ea[0] == 1 && er[0] == pr && ec[0] == pc {
    dead = true
  }
  if ea[1] == 1 && er[1] == pr && ec[1] == pc {
    dead = true
  }
  if ea[2] == 1 && er[2] == pr && ec[2] == pc {
    dead = true
  }
  if ea[3] == 1 && er[3] == pr && ec[3] == pc {
    dead = true
  }
}

mod playerStep(ax: int, jmp: bool, now: float) {
  let base = lv * 728
  if ax != 0 {
    let nc = pc + ax
    if MAPS[base + pr * 28 + nc] != 1 {
      pc = nc
    }
  }
  let g = MAPS[base + (pr + 1) * 28 + pc] == 1
  if g && jmp && jt == 0 {
    jt = 4
    fxT = now
    fxKind = 1
  }
  if jt > 0 {
    if MAPS[base + (pr - 1) * 28 + pc] != 1 {
      pr = pr - 1
      jt = jt - 1
    } else {
      jt = 0
    }
  } else if !g {
    pr = pr + 1
  }
  let i = pr * 28 + pc
  if MAPS[base + i] == 2 {
    dead = true
  }
  if dot[base + i] == 1 {
    dot[base + i] = 0
    let p = pr * 57 + pc * 2
    dotsTxt = dotsTxt.Substring(0, p) .. "  " .. dotsTxt.Substring(p + 2, 1481 - p - 2)
    coinsLeft = coinsLeft - 1
    score = score + 10
    pingT = now
    pingHi = !pingHi
    showHud()
  }
  drawPac()
  checkWalkers()
  if coinsLeft <= 0 && pr == EXR[lv] && pc == EXC[lv] && !dead {
    state = 4
    tState = now
    score = score + 100 * level + 50 * lives
    clearActors()
    msg = "                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                      LEVEL CLEAR!                      \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        "
    msgK = 2
    showHud()
  }
}

mod enemiesStep() {
  let base = lv * 728
  if ea[0] == 1 {
    let r = er[0]
    let c = ec[0]
    let nc = c + ed[0]
    if MAPS[base + r * 28 + nc] == 1 || MAPS[base + (r + 1) * 28 + nc] != 1 {
      ed[0] = 0 - ed[0]
    } else {
      ec[0] = nc
    }
    drawWalker(0)
  }
  if ea[1] == 1 {
    let r = er[1]
    let c = ec[1]
    let nc = c + ed[1]
    if MAPS[base + r * 28 + nc] == 1 || MAPS[base + (r + 1) * 28 + nc] != 1 {
      ed[1] = 0 - ed[1]
    } else {
      ec[1] = nc
    }
    drawWalker(1)
  }
  if ea[2] == 1 {
    let r = er[2]
    let c = ec[2]
    let nc = c + ed[2]
    if MAPS[base + r * 28 + nc] == 1 || MAPS[base + (r + 1) * 28 + nc] != 1 {
      ed[2] = 0 - ed[2]
    } else {
      ec[2] = nc
    }
    drawWalker(2)
  }
  if ea[3] == 1 {
    let r = er[3]
    let c = ec[3]
    let nc = c + ed[3]
    if MAPS[base + r * 28 + nc] == 1 || MAPS[base + (r + 1) * 28 + nc] != 1 {
      ed[3] = 0 - ed[3]
    } else {
      ec[3] = nc
    }
    drawWalker(3)
  }
  checkWalkers()
}

mod gameOver(now: float) {
  state = 5
  tState = now
  clearActors()
  msg = "                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                       GAME  OVER                       \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        "
  msgK = 1
  let ctrl = player.ControllerOf()
  let coins: int = min(50, floor(score / 300.0))
  if coins > 0 {
    ctrl.IncLeaderboard("coins", coins)
  }
  let key = ctrl.GetUserId()
  let b = best.get(key)
  if !b.Found || score > b.Value {
    best.set(key, score)
  }
  info = "GAME OVER  +${coins} COINS"
}

mod idle() {
  state = 0
  clearActors()
  msg = "                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                    SIT DOWN TO PLAY                    \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        "
  msgK = 0
  hud = "FAIK PLATFORMER     HIGH ${high}"
  info = "A D WALK    W JUMP"
}

on player {
  if player == none {
    idle()
  } else {
    newGame(ServerUptime())
  }
}

let inp = player.InputReader()
on inp.Forward > 0.5 {
  if inp.Forward > 0.5 {
    if state == 6 {
      newGame(ServerUptime())
    }
  }
}

// always running (a Clock switched by 'enabled' got stuck in the DDR cabinet)
on Clock(interval = 0.02) {
  let now = ServerUptime()
  if state == 2 {
    let ax = if inp.Right > 0.5 then 1 else if inp.Right < -0.5 then -1 else 0
    let jmp = inp.Forward > 0.5
    if now >= pn {
      playerStep(ax, jmp, now)
      pn = max(pn + 0.07, now - 0.1)
    }
    if state == 2 && now >= en {
      enemiesStep()
      en = max(en + 0.2 / min(1.6, 1.0 + (level - 1) * 0.1), now - 0.1)
    }
    if dead && state == 2 {
      dead = false
      die(now)
    }
  } else if state == 1 {
    if now - tState >= 1.5 {
      state = 2
      msg = "                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        "
    }
  } else if state == 3 {
    let e = now - tState
    pacTxt = if e < 1.0 && floor(e * 6.0) % 2 == 0 then ROWA[pr] .. LC[pc] .. "Ö" .. RC[pc] .. ROWB[pr] else ""
    if e >= 1.4 {
      lives = lives - 1
      if lives <= 0 {
        if score > high {
          high = score
        }
        gameOver(now)
      } else {
        resetRound(now)
      }
    }
  } else if state == 4 {
    if now - tState >= 2.0 {
      level = level + 1
      newLevel(now)
    }
  } else if state == 5 {
    if now - tState >= 3.0 {
      state = 6
      msg = "                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                    W TO PLAY AGAIN                     \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        "
      msgK = 0
    }
  }
  if score > high {
    high = score
  }
  // sound: coin ping on speaker 0, jump / death on 1
  v0 = if now - pingT < 0.08 then 0.6 else 0.0
  p0 = if pingHi then 1.9 else 1.5
  let fe = now - fxT
  if fxKind == 1 && fe < 0.2 {
    p1 = 0.6 + fe * 3.0
    v1 = 0.4
  } else if fxKind == 2 && fe < 1.0 {
    p1 = max(0.15, 1.2 - fe * 1.0)
    v1 = 0.6
  } else {
    v1 = 0.0
  }
}
