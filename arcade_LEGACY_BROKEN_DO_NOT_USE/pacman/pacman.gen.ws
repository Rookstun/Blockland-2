mod showHud() {
  hud = "SCORE ${score}     HIGH ${high}"
  let spare = if lives >= 3 then "● ●" else if lives == 2 then "●" else ""
  info = "${spare}          LEVEL ${level}"
}

mod drawPac() {
  let g = if mouth == 1 then (if pd == 0 then "U" else (if pd == 1 then "Ɔ" else (if pd == 2 then "∩" else (if pd == 3 then "C" else "●")))) else "●"
  pacTxt = ROWA[pr] .. LC[pc] .. g .. RC[pc] .. ROWB[pr]
}

mod setMode(k: int) {
  let s = gs[k]
  let m = if s == 4 then 2 else if gf[k] == 1 then 1 else 0
  if k == 0 { gm0 = m }
  if k == 1 { gm1 = m }
  if k == 2 { gm2 = m }
  if k == 3 { gm3 = m }
}

mod drawGhost(k: int) {
  let r = gr[k]
  let c = gc[k]
  let t = ROWA[r] .. LC[c] .. (if gs[k] == 4 then "ö" else "Ω") .. RC[c] .. ROWB[r]
  if k == 0 { gt0 = t }
  if k == 1 { gt1 = t }
  if k == 2 { gt2 = t }
  if k == 3 { gt3 = t }
}

mod resetRound(now: float) {
  pr = 23
  pc = 13
  pd = 1
  want = 1
  mouth = 0
  gr = [11, 14, 14, 14]
  gc = [13, 13, 11, 15]
  gd = [1, 0, 0, 0]
  gs = [2, 0, 0, 0]
  gf = [0, 0, 0, 0]
  gn = [now + 2.2, now + 2.3, now + 2.4, now + 2.5]
  grel = [now, now + 3.0, now + 7.0, now + 11.0]
  frEnd = 0.0
  frFlash = false
  hk = -1
  phase = 0
  phaseEnd = now + 9.0
  scatter = true
  pn = now + 2.0
  gm0 = 0
  gm1 = 0
  gm2 = 0
  gm3 = 0
  drawPac()
  drawGhost(0)
  drawGhost(1)
  drawGhost(2)
  drawGhost(3)
  msg = "                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                         READY!                         \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        "
  msgK = 0
  state = 1
  tState = now
  showHud()
}

mod resetDots() {
  dot.copyFrom(DOT0)
  dotsTxt = "                                                        \n  · · · · · · · · · · · ·     · · · · · · · · · · · ·   \n  ·         ·           ·     ·           ·         ·   \n  ●         ·           ·     ·           ·         ●   \n  ·         ·           ·     ·           ·         ·   \n  · · · · · · · · · · · · · · · · · · · · · · · · · ·   \n  ·         ·     ·                 ·     ·         ·   \n  ·         ·     ·                 ·     ·         ·   \n  · · · · · ·     · · · ·     · · · ·     · · · · · ·   \n            ·                             ·             \n            ·                             ·             \n            ·                             ·             \n            ·                             ·             \n            ·                             ·             \n            ·                             ·             \n            ·                             ·             \n            ·                             ·             \n            ·                             ·             \n            ·                             ·             \n            ·                             ·             \n  · · · · · · · · · · · ·     · · · · · · · · · · · ·   \n  ·         ·           ·     ·           ·         ·   \n  ·         ·           ·     ·           ·         ·   \n  ● · ·     · · · · · · ·     · · · · · · ·     · · ●   \n      ·     ·     ·                 ·     ·     ·       \n      ·     ·     ·                 ·     ·     ·       \n  · · · · · ·     · · · ·     · · · ·     · · · · · ·   \n  ·                     ·     ·                     ·   \n  ·                     ·     ·                     ·   \n  · · · · · · · · · · · · · · · · · · · · · · · · · ·   \n                                                        "
  dotsLeft = 244
}

mod newGame(now: float) {
  score = 0
  lives = 3
  level = 1
  wallW = false
  resetDots()
  resetRound(now)
}

mod clearActors() {
  pacTxt = ""
  gt0 = ""
  gt1 = ""
  gt2 = ""
  gt3 = ""
}

mod startFright(now: float) {
  let dur = max(1.0, 7.0 - level * 1.0)
  frEnd = now + dur
  chain = 0
  if gs[0] == 2 {
    gf[0] = 1
    gd[0] = (gd[0] + 2) % 4
    gn[0] = max(gn[0], now)
  }
  setMode(0)
  if gs[1] == 2 {
    gf[1] = 1
    gd[1] = (gd[1] + 2) % 4
    gn[1] = max(gn[1], now)
  }
  setMode(1)
  if gs[2] == 2 {
    gf[2] = 1
    gd[2] = (gd[2] + 2) % 4
    gn[2] = max(gn[2], now)
  }
  setMode(2)
  if gs[3] == 2 {
    gf[3] = 1
    gd[3] = (gd[3] + 2) % 4
    gn[3] = max(gn[3], now)
  }
  setMode(3)
}

mod endFright() {
  frEnd = 0.0
  frFlash = false
  gf = [0, 0, 0, 0]
  setMode(0)
  setMode(1)
  setMode(2)
  setMode(3)
}

mod pacStep(now: float) {
  let r = pr
  let c = pc
  let ok0 = MAP[(r - 1) * 28 + c] == 1
  let ok1 = MAP[r * 28 + ((c - 1 + 28) % 28)] == 1
  let ok2 = MAP[(r + 1) * 28 + c] == 1
  let ok3 = MAP[r * 28 + ((c + 1 + 28) % 28)] == 1
  var d: int = pd
  if (if want == 0 then ok0 else if want == 1 then ok1 else if want == 2 then ok2 else ok3) {
    d = want
  }
  if (if d == 0 then ok0 else if d == 1 then ok1 else if d == 2 then ok2 else ok3) {
    let nr = r + (if d == 0 then -1 else if d == 2 then 1 else 0)
    let nc = ((c + (if d == 1 then -1 else if d == 3 then 1 else 0) + 28) % 28)
    pr = nr
    pc = nc
    pd = d
    mouth = 1 - mouth
    let i = nr * 28 + nc
    let v = dot[i]
    if v > 0 {
      dot[i] = 0
      let p = nr * 57 + nc * 2
      dotsTxt = dotsTxt.Substring(0, p) .. "  " .. dotsTxt.Substring(p + 2, 1766 - p - 2)
      dotsLeft = dotsLeft - 1
      wakaT = now
      wakaHi = !wakaHi
      if v == 2 {
        score = score + 50
        startFright(now)
      } else {
        score = score + 10
      }
      showHud()
    }
  } else {
    mouth = 0
  }
  drawPac()
  if gr[0] == pr && gc[0] == pc {
    hk = 0
  }
  if gr[1] == pr && gc[1] == pc {
    hk = 1
  }
  if gr[2] == pr && gc[2] == pc {
    hk = 2
  }
  if gr[3] == pr && gc[3] == pc {
    hk = 3
  }
}

mod ghostStep(k: int, now: float) {
  let s = gs[k]
  if s == 0 {
    if now >= grel[k] {
      gs[k] = 2
      gr[k] = 11
      gc[k] = 13
      gd[k] = 1
      gn[k] = now + 0.15
      if frEnd > 0.0 {
        gf[k] = 0
      }
      setMode(k)
    } else {
      gn[k] = now + 0.25
    }
    drawGhost(k)
  } else {
    let r = gr[k]
    let c = gc[k]
    let d = gd[k]
    let fr = gf[k]
    let ok0 = MAP[(r - 1) * 28 + c] == 1
    let ok1 = MAP[r * 28 + ((c - 1 + 28) % 28)] == 1
    let ok2 = MAP[(r + 1) * 28 + c] == 1
    let ok3 = MAP[r * 28 + ((c + 1 + 28) % 28)] == 1
    let rev = (d + 2) % 4
    var tr: int = 0
    var tc: int = 0
    if s == 4 {
      tr = 11
      tc = 13
    } else if scatter {
      if k == 0 {
        tr = -3
        tc = 25
      }       else if k == 1 {
        tr = -3
        tc = 2
      }       else if k == 2 {
        tr = 33
        tc = 27
      }       else if k == 3 {
        tr = 33
        tc = 0
      }
    } else if k == 0 {
      tr = pr
      tc = pc
    } else if k == 1 {
      tr = pr + 4 * (if pd == 0 then -1 else if pd == 2 then 1 else 0)
      tc = pc + 4 * (if pd == 1 then -1 else if pd == 3 then 1 else 0)
    } else if k == 2 {
      let br = gr[0]
      let bc = gc[0]
      tr = 2 * (pr + 2 * (if pd == 0 then -1 else if pd == 2 then 1 else 0)) - br
      tc = 2 * (pc + 2 * (if pd == 1 then -1 else if pd == 3 then 1 else 0)) - bc
    } else {
      if (r - pr) * (r - pr) + (c - pc) * (c - pc) > 64 {
        tr = pr
        tc = pc
      } else {
        tr = 33
        tc = 0
      }
    }
    var nd: int = -1
    if fr == 1 && s == 2 {
      let r0 = Random(0, 3)
      let dd0 = (r0 + 0) % 4
      if nd < 0 && dd0 != rev && (if dd0 == 0 then ok0 else if dd0 == 1 then ok1 else if dd0 == 2 then ok2 else ok3) {
        nd = dd0
      }
      let dd1 = (r0 + 1) % 4
      if nd < 0 && dd1 != rev && (if dd1 == 0 then ok0 else if dd1 == 1 then ok1 else if dd1 == 2 then ok2 else ok3) {
        nd = dd1
      }
      let dd2 = (r0 + 2) % 4
      if nd < 0 && dd2 != rev && (if dd2 == 0 then ok0 else if dd2 == 1 then ok1 else if dd2 == 2 then ok2 else ok3) {
        nd = dd2
      }
      let dd3 = (r0 + 3) % 4
      if nd < 0 && dd3 != rev && (if dd3 == 0 then ok0 else if dd3 == 1 then ok1 else if dd3 == 2 then ok2 else ok3) {
        nd = dd3
      }
    } else {
      var bv: int = 999999
      if ok0 && rev != 0 {
        let v0 = (r + -1 - tr) * (r + -1 - tr) + (c + 0 - tc) * (c + 0 - tc)
        if v0 < bv {
          bv = v0
          nd = 0
        }
      }
      if ok1 && rev != 1 {
        let v1 = (r + 0 - tr) * (r + 0 - tr) + (c + -1 - tc) * (c + -1 - tc)
        if v1 < bv {
          bv = v1
          nd = 1
        }
      }
      if ok2 && rev != 2 {
        let v2 = (r + 1 - tr) * (r + 1 - tr) + (c + 0 - tc) * (c + 0 - tc)
        if v2 < bv {
          bv = v2
          nd = 2
        }
      }
      if ok3 && rev != 3 {
        let v3 = (r + 0 - tr) * (r + 0 - tr) + (c + 1 - tc) * (c + 1 - tc)
        if v3 < bv {
          bv = v3
          nd = 3
        }
      }
    }
    if nd < 0 {
      nd = rev
    }
    let nr = r + (if nd == 0 then -1 else if nd == 2 then 1 else 0)
    let nc = ((c + (if nd == 1 then -1 else if nd == 3 then 1 else 0) + 28) % 28)
    gr[k] = nr
    gc[k] = nc
    gd[k] = nd
    let tunnel = nr == 14 && (nc < 6 || nc > 21)
    let spd = if s == 4 then 14.0 else if fr == 1 then 4.5 else if tunnel then 4.0 else 7.0 * min(1.25, 1.0 + (level - 1) * 0.05)
    gn[k] = max(gn[k] + 1.0 / spd, now - 0.1)
    if s == 4 && nr == 11 && (nc == 13 || nc == 14) {
      gs[k] = 0
      gr[k] = 14
      gc[k] = 13
      gf[k] = 0
      grel[k] = now + 1.0
      gn[k] = now + 0.25
      setMode(k)
    }
    drawGhost(k)
    if gr[k] == pr && gc[k] == pc {
      hk = k
    }
  }
}

mod touched(k: int, now: float) {
  if gs[k] == 2 {
    if gf[k] == 1 {
      gs[k] = 4
      gf[k] = 0
      chain = chain + 1
      score = score + (if chain == 1 then 200 else if chain == 2 then 400 else if chain == 3 then 800 else 1600)
      fxT = now
      fxKind = 1
      setMode(k)
      drawGhost(k)
      showHud()
    } else {
      state = 3
      tState = now
      fxT = now
      fxKind = 2
      gt0 = ""
      gt1 = ""
      gt2 = ""
      gt3 = ""
    }
  }
}

mod gameOver(now: float) {
  state = 5
  tState = now
  clearActors()
  msg = "                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                       GAME  OVER                       \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        "
  msgK = 1
  let ctrl = player.ControllerOf()
  let coins: int = min(50, floor(score / 300.0))
  if coins > 0 {
    ctrl.IncLeaderboard("coins", coins)
  }
  let key = ctrl.GetUserId()
  let b = best.get(key)
  if !b.Found || score > b.Value {
    best.set(key, score)
  }
  info = "GAME OVER  +${coins} COINS"
  BroadcastChatMessage("<color=\"ffe040\">${ctrl.GetUserName()} scored ${score} on PAC-MAN (level ${level})</>")
}

mod idle() {
  state = 0
  clearActors()
  msg = "                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                    SIT DOWN TO PLAY                    \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        "
  msgK = 0
  hud = "PAC-MAN     HIGH ${high}"
  info = "WASD TO MOVE"
}

on player {
  if player == none {
    idle()
  } else {
    newGame(ServerUptime())
  }
}

let inp = player.InputReader()
on inp.Forward > 0.5 {
  if inp.Forward > 0.5 {
    want = 0
    if state == 6 {
      newGame(ServerUptime())
    }
  }
}
on inp.Forward < -0.5 {
  if inp.Forward < -0.5 {
    want = 2
  }
}
on inp.Right < -0.5 {
  if inp.Right < -0.5 {
    want = 1
  }
}
on inp.Right > 0.5 {
  if inp.Right > 0.5 {
    want = 3
  }
}

// always running (a Clock switched by 'enabled' got stuck in the DDR cabinet)
on Clock(interval = 0.02) {
  let now = ServerUptime()
  if state == 2 {
    if now >= phaseEnd && phase < 7 {
      phase = phase + 1
      phaseEnd = now + PH[phase]
      scatter = phase % 2 == 0
      if gs[0] == 2 {
        gd[0] = (gd[0] + 2) % 4
      }
      if gs[1] == 2 {
        gd[1] = (gd[1] + 2) % 4
      }
      if gs[2] == 2 {
        gd[2] = (gd[2] + 2) % 4
      }
      if gs[3] == 2 {
        gd[3] = (gd[3] + 2) % 4
      }
    }
    if now >= pn {
      pacStep(now)
      pn = max(pn + 1.0 / (7.5 * min(1.25, 1.0 + (level - 1) * 0.05)), now - 0.1)
    }
    let m = gn.min()
    if now >= m {
      let k = gn.find(m)
      ghostStep(k, now)
    }
    if hk >= 0 {
      let h = hk
      hk = -1
      touched(h, now)
    }
    if state == 2 {
      if frEnd > 0.0 {
        if now >= frEnd {
          endFright()
        } else {
          frFlash = frEnd - now < 2.0 && floor(now * 5.0) % 2 == 0
        }
      }
      if dotsLeft <= 0 {
        state = 4
        tState = now
        clearActors()
        msg = "                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                      LEVEL CLEAR!                      \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        "
        msgK = 2
      }
    }
  } else if state == 1 {
    if now - tState >= 2.0 {
      state = 2
      msg = "                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        "
    }
  } else if state == 3 {
    let e = now - tState
    pacTxt = if e < 1.4 && floor(e * 6.0) % 2 == 0 then ROWA[pr] .. LC[pc] .. "●" .. RC[pc] .. ROWB[pr] else ""
    if e >= 1.8 {
      lives = lives - 1
      if lives <= 0 {
        if score > high {
          high = score
        }
        gameOver(now)
      } else {
        resetRound(now)
      }
    }
  } else if state == 4 {
    let e = now - tState
    wallW = floor(e * 4.0) % 2 == 0
    if e >= 2.4 {
      wallW = false
      level = level + 1
      resetDots()
      resetRound(now)
    }
  } else if state == 5 {
    if now - tState >= 3.0 {
      state = 6
      msg = "                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                    W TO PLAY AGAIN                     \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        \n                                                        "
      msgK = 0
    }
  }
  if score > high {
    high = score
  }
  // sound: waka on the speaker 0, siren on 1, effects (ghost eaten, death) on 2
  v0 = if now - wakaT < 0.09 then 0.7 else 0.0
  p0 = if wakaHi then 0.62 else 0.48
  if state == 2 {
    if frEnd > 0.0 {
      p1 = 0.3 + 0.08 * sin(now * 30.0)
    } else {
      p1 = (0.85 + 0.1 * level) * (1.0 + 0.18 * sin(now * 9.0))
    }
    v1 = 0.22
  } else {
    v1 = 0.0
  }
  let fe = now - fxT
  if fxKind == 1 && fe < 0.45 {
    p2 = 0.5 + fe * 5.0
    v2 = 0.6
  } else if fxKind == 2 && fe < 1.5 {
    p2 = max(0.15, 1.3 - fe * 0.8) * (1.0 + 0.25 * sin(fe * 60.0))
    v2 = 0.7
  } else {
    v2 = 0.0
  }
}
