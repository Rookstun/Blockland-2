out pad3: color = pcol3
out P0: float = vp0
out V0: float = min(vv0, Dampen(vv0, 0.025))
out P1: float = vp1
out V1: float = min(vv1, Dampen(vv1, 0.025))
out P2: float = vp2
out V2: float = min(vv2, Dampen(vv2, 0.025))
out P3: float = vp3
out V3: float = min(vv3, Dampen(vv3, 0.025))
out P4: float = vp4
out V4: float = min(vv4, Dampen(vv4, 0.025))
out P5: float = vp5
out V5: float = min(vv5, Dampen(vv5, 0.025))
out P6: float = vp6
out V6: float = min(vv6, Dampen(vv6, 0.025))
out P7: float = vp7
out V7: float = min(vv7, Dampen(vv7, 0.025))
out P8: float = vp8
out V8: float = vv8
out P9: float = vp9
out V9: float = vv9
out P10: float = vp10
out V10: float = vv10   // smooth voices tween only incoming; clicky ones snap
let e0 = min(1.0, max(0.0, dn0 - Tween(dn0, 0.16)))   // kick
out DP0: float = ds0 * (0.12 + 0.38 * e0 * e0)
out DA0: float = dg0 * e0
let e1 = min(1.0, max(0.0, dn1 - Tween(dn1, 0.11)))   // snare
out DP1: float = ds1 * (0.55 + 0.55 * e1 * e1)
out DA1: float = dg1 * e1
let e2 = min(1.0, max(0.0, dn2 - Tween(dn2, 0.04)))   // hat
out DP2: float = ds2 * (8.6 + 0.9 * e2 * e2)
out DA2: float = dg2 * e2
let e3 = min(1.0, max(0.0, dn3 - Tween(dn3, 0.2)))   // tom
out DP3: float = ds3 * (0.32 + 0.38 * e3 * e3)
out DA3: float = dg3 * e3
let e4 = min(1.0, max(0.0, dn4 - Tween(dn4, 0.45)))   // cymbal
out DP4: float = ds4 * (8.0 + 1.5 * e4 * e4)
out DA4: float = dg4 * e4

