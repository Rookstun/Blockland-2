mod seats() {
  if player0 == none && player1 == none {
    state = 0
    silence()
    clearScreen()
    title = "SIT DOWN TO DANCE\n1 OR 2 PLAYERS"
  } else if state == 2 {
    if player0 == none && act0 {
      act0 = false
      ne00 = ni00
      ne01 = ni01
      ne02 = ni02
      ne03 = ni03
      judge0 = "LEFT"
      redraw()
    }
    if player1 == none && act1 {
      act1 = false
      ne10 = ni10
      ne11 = ni11
      ne12 = ni12
      ne13 = ni13
      judge1 = "LEFT"
      redraw()
    }
    if !act0 && !act1 {
      menu()                  // nobody dancing is still seated (e.g. P1 hopped into P2's seat): back to song select
    } else {
      if player0 != none && !act0 {
        info0 = "NEXT SONG"
      }
      if player1 != none && !act1 {
        info1 = "NEXT SONG"
      }
    }
  } else {
    menu()
  }
}

on player0 {
  seats()
}
let inp0 = player0.InputReader()
on inp0.Right < -0.5 {
  if inp0.Right < -0.5 {
    pcol00 = ColorSRGB(255, 70, 210, 255)
    press00()
  } else {
    pcol00 = ColorSRGB(40, 40, 50, 255)
  }
}
on inp0.Forward < -0.5 {
  if inp0.Forward < -0.5 {
    pcol01 = ColorSRGB(60, 210, 255, 255)
    press01()
  } else {
    pcol01 = ColorSRGB(40, 40, 50, 255)
  }
}
on inp0.Forward > 0.5 {
  if inp0.Forward > 0.5 {
    pcol02 = ColorSRGB(90, 255, 120, 255)
    press02()
  } else {
    pcol02 = ColorSRGB(40, 40, 50, 255)
  }
}
on inp0.Right > 0.5 {
  if inp0.Right > 0.5 {
    pcol03 = ColorSRGB(255, 170, 40, 255)
    press03()
  } else {
    pcol03 = ColorSRGB(40, 40, 50, 255)
  }
}
on player1 {
  seats()
}
let inp1 = player1.InputReader()
on inp1.Right < -0.5 {
  if inp1.Right < -0.5 {
    pcol10 = ColorSRGB(255, 70, 210, 255)
    press10()
  } else {
    pcol10 = ColorSRGB(40, 40, 50, 255)
  }
}
on inp1.Forward < -0.5 {
  if inp1.Forward < -0.5 {
    pcol11 = ColorSRGB(60, 210, 255, 255)
    press11()
  } else {
    pcol11 = ColorSRGB(40, 40, 50, 255)
  }
}
on inp1.Forward > 0.5 {
  if inp1.Forward > 0.5 {
    pcol12 = ColorSRGB(90, 255, 120, 255)
    press12()
  } else {
    pcol12 = ColorSRGB(40, 40, 50, 255)
  }
}
on inp1.Right > 0.5 {
  if inp1.Right > 0.5 {
    pcol13 = ColorSRGB(255, 170, 40, 255)
    press13()
  } else {
    pcol13 = ColorSRGB(40, 40, 50, 255)
  }
}

on Clock(interval = 0.02, enabled = state == 2) {
  let t = ServerUptime() - t0
  if t > LEN[song] + 1.5 {
    finish()
  } else {
    let rows = t / rowD
    let row: int = floor(rows)
    frac = rows - row
    if row != lastRow {
      lastRow = row
      redraw()
    }
    if ni00 < ne00 && t > NT0[ni00] + 0.16 {
      missed0()
      ni00 = ni00 + 1
    }
    rcol00 = if t - flash00 < 0.12 then ColorSRGB(255, 70, 210, 255) else ColorSRGB(70, 70, 80, 255)
    if ni01 < ne01 && t > NT1[ni01] + 0.16 {
      missed0()
      ni01 = ni01 + 1
    }
    rcol01 = if t - flash01 < 0.12 then ColorSRGB(60, 210, 255, 255) else ColorSRGB(70, 70, 80, 255)
    if ni02 < ne02 && t > NT2[ni02] + 0.16 {
      missed0()
      ni02 = ni02 + 1
    }
    rcol02 = if t - flash02 < 0.12 then ColorSRGB(90, 255, 120, 255) else ColorSRGB(70, 70, 80, 255)
    if ni03 < ne03 && t > NT3[ni03] + 0.16 {
      missed0()
      ni03 = ni03 + 1
    }
    rcol03 = if t - flash03 < 0.12 then ColorSRGB(255, 170, 40, 255) else ColorSRGB(70, 70, 80, 255)
    if ni10 < ne10 && t > NT0[ni10] + 0.16 {
      missed1()
      ni10 = ni10 + 1
    }
    rcol10 = if t - flash10 < 0.12 then ColorSRGB(255, 70, 210, 255) else ColorSRGB(70, 70, 80, 255)
    if ni11 < ne11 && t > NT1[ni11] + 0.16 {
      missed1()
      ni11 = ni11 + 1
    }
    rcol11 = if t - flash11 < 0.12 then ColorSRGB(60, 210, 255, 255) else ColorSRGB(70, 70, 80, 255)
    if ni12 < ne12 && t > NT2[ni12] + 0.16 {
      missed1()
      ni12 = ni12 + 1
    }
    rcol12 = if t - flash12 < 0.12 then ColorSRGB(90, 255, 120, 255) else ColorSRGB(70, 70, 80, 255)
    if ni13 < ne13 && t > NT3[ni13] + 0.16 {
      missed1()
      ni13 = ni13 + 1
    }
    rcol13 = if t - flash13 < 0.12 then ColorSRGB(255, 170, 40, 255) else ColorSRGB(70, 70, 80, 255)
    if vi0 < ve0 && t >= VT0[vi0] {
      vp0 = VP0[vi0]
      vo0 = VE0[vi0]
      vv0 = VV0[vi0]
      vi0 = vi0 + 1
    } else if t >= vo0 {
      vv0 = 0.0
    }
    if vi1 < ve1 && t >= VT1[vi1] {
      vp1 = VP1[vi1]
      vo1 = VE1[vi1]
      vv1 = VV1[vi1]
      vi1 = vi1 + 1
    } else if t >= vo1 {
      vv1 = 0.0
    }
    if t < 0.0 {
      let c: int = ceil(-t)
      title = "${NAMES[song]}\nGET READY\n${c}"
    } else if t < 1.0 {
      title = "${NAMES[song]}\nGO!"
    } else if title != NAMES[song] {
      title = NAMES[song]
    }
    if act0 && t < 0.0 {
      judge0 = "READY"
    } else if act0 && t < 1.0 && judge0 == "READY" {
      judge0 = "GO!"
    }
    if act1 && t < 0.0 {
      judge1 = "READY"
    } else if act1 && t < 1.0 && judge1 == "READY" {
      judge1 = "GO!"
    }
  }
}
