var VO6: int[] = [0, 0, 113, 195, 195, 195, 195, 195, 195, 195, 195]

var none: character
var state: int = 0          // 0 seat empty, 1 song select, 2 dancing, 3 results
var song: int = 0
var t0: float = 0.0
var lastRow: int = -99999
var lead: int = 0
var rowD: float = 0.1
var sync: float = 0.0       // /ddrsync: chart delay vs the music, seconds
var title: string = "SIT DOWN TO DANCE"
var best: Map<string, int>
var score: int = 0
var combo: int = 0
var maxCombo: int = 0
var nP: int = 0
var nG: int = 0
var nO: int = 0
var nM: int = 0
var judge: string = ""
var jcol: color = ColorSRGB(255, 255, 255, 255)
var info: string = ""
var comboTxt: string = ""
var live0: string = ""
var scr0: string = ""
var ni0: int = 0
var ne0: int = 0
var flash0: float = -9.0
var rcol0: color = ColorSRGB(70, 70, 80, 255)
var pcol0: color = ColorSRGB(40, 40, 50, 255)
var live1: string = ""
var scr1: string = ""
var ni1: int = 0
var ne1: int = 0
var flash1: float = -9.0
var rcol1: color = ColorSRGB(70, 70, 80, 255)
var pcol1: color = ColorSRGB(40, 40, 50, 255)
var live2: string = ""
var scr2: string = ""
var ni2: int = 0
var ne2: int = 0
var flash2: float = -9.0
var rcol2: color = ColorSRGB(70, 70, 80, 255)
var pcol2: color = ColorSRGB(40, 40, 50, 255)
var live3: string = ""
var scr3: string = ""
var ni3: int = 0
var ne3: int = 0
var flash3: float = -9.0
var rcol3: color = ColorSRGB(70, 70, 80, 255)
var pcol3: color = ColorSRGB(40, 40, 50, 255)
var vi0: int = 0
var ve0: int = 0
var vp0: float = 1.0
var vv0: float = 0.0
var vo0: float = 0.0
var va0: float = 0.0
var vs0: float = 0.0
var vi1: int = 0
var ve1: int = 0
var vp1: float = 1.0
var vv1: float = 0.0
var vo1: float = 0.0
var va1: float = 0.0
var vs1: float = 0.0
var vi2: int = 0
var ve2: int = 0
var vp2: float = 1.0
var vv2: float = 0.0
var vo2: float = 0.0
var va2: float = 0.0
var vs2: float = 0.0
var vi3: int = 0
var ve3: int = 0
var vp3: float = 1.0
var vv3: float = 0.0
var vo3: float = 0.0
var va3: float = 0.0
var vs3: float = 0.0
var vi4: int = 0
var ve4: int = 0
var vp4: float = 1.0
var vv4: float = 0.0
var vo4: float = 0.0
var va4: float = 0.0
var vs4: float = 0.0
var vi5: int = 0
var ve5: int = 0
var vp5: float = 1.0
var vv5: float = 0.0
var vo5: float = 0.0
var va5: float = 0.0
var vs5: float = 0.0
var vi6: int = 0
var ve6: int = 0
var vp6: float = 1.0
var vv6: float = 0.0
var vo6: float = 0.0
var va6: float = 0.0
var vs6: float = 0.0

out title_t: string = title
out judge_t: string = judge
out judge_c: color = jcol
out info_t: string = info
out combo_t: string = comboTxt
out lane0: string = scr0
out rec0: color = rcol0
out pad0: color = pcol0
out lane1: string = scr1
out rec1: color = rcol1
out pad1: color = pcol1
out lane2: string = scr2
out rec2: color = rcol2
out pad2: color = pcol2
out lane3: string = scr3
out rec3: color = rcol3
out pad3: color = pcol3
out P0: float = vp0
out V0: float = Dampen(vv0, 0.025)
out P1: float = vp1
out V1: float = Dampen(vv1, 0.025)
out P2: float = vp2
out V2: float = Dampen(vv2, 0.025)
out P3: float = vp3
out V3: float = Dampen(vv3, 0.025)
out P4: float = vp4
out V4: float = Dampen(vv4, 0.025)
out P5: float = vp5
out V5: float = Dampen(vv5, 0.025)
out P6: float = vp6
out V6: float = Dampen(vv6, 0.025)   // smoothed: no clicks between notes

mod silence() {
  vv0 = 0.0
  vv1 = 0.0
  vv2 = 0.0
  vv3 = 0.0
  vv4 = 0.0
  vv5 = 0.0
  vv6 = 0.0
}

mod redraw() {
  let base: int = max(0, lastRow + lead) * 2
  scr0 = live0.Substring(base, 24)
  scr1 = live1.Substring(base, 24)
  scr2 = live2.Substring(base, 24)
  scr3 = live3.Substring(base, 24)
}

mod clearScreen() {
  scr0 = ""
  scr1 = ""
  scr2 = ""
  scr3 = ""
  judge = ""
  info = ""
  comboTxt = ""
}

mod menu() {
  BroadcastChatMessage("<color=\"8080ff\">[ddr] menu</>")
  state = 1
  silence()
  clearScreen()
  let key = "${song}:${player.ControllerOf().GetUserId()}"
  let b = best.get(key)
  let bestTxt = if b.Found then "BEST ${b.Value}" else "NO SCORE YET"
  title = "◄ ${NAMES[song]} ►\n${BPM[song]} BPM  ${STEPS[song]} STEPS\n${bestTxt}\n← → PICK  ↑ START  Q STOP"
}

mod start() {
  rowD = ROWD[song]
  lead = LEAD[song]
  score = 0
  combo = 0
  maxCombo = 0
  nP = 0
  nG = 0
  nO = 0
  nM = 0
  judge = "READY"
  jcol = ColorSRGB(255, 255, 255, 255)
  info = "0"
  comboTxt = ""
  live0 = LS0[song]
  ni0 = NO0[song]
  ne0 = NO0[song + 1]
  live1 = LS1[song]
  ni1 = NO1[song]
  ne1 = NO1[song + 1]
  live2 = LS2[song]
  ni2 = NO2[song]
  ne2 = NO2[song + 1]
  live3 = LS3[song]
  ni3 = NO3[song]
  ne3 = NO3[song + 1]
  vi0 = VO0[song]
  ve0 = VO0[song + 1]
  vi1 = VO1[song]
  ve1 = VO1[song + 1]
  vi2 = VO2[song]
  ve2 = VO2[song + 1]
  vi3 = VO3[song]
  ve3 = VO3[song + 1]
  vi4 = VO4[song]
  ve4 = VO4[song + 1]
  vi5 = VO5[song]
  ve5 = VO5[song + 1]
  vi6 = VO6[song]
  ve6 = VO6[song + 1]
  t0 = ServerUptime() + 4.0
  lastRow = -99999
  title = NAMES[song]
  state = 2
  BroadcastChatMessage("<color=\"8080ff\">[ddr] start ${NAMES[song]} t0=${t0}</>")
}

mod points() {
  info = "${floor(score * 1000000.0 / max(1.0, 3.0 * STEPS[song]))}"
  comboTxt = if combo >= 4 then "${combo} COMBO" else ""
}

mod judgeHit(dt: float) {
  if dt <= 0.05 {
    nP = nP + 1
    score = score + 3
    judge = "PERFECT"
    jcol = ColorSRGB(255, 225, 60, 255)
  } else if dt <= 0.1 {
    nG = nG + 1
    score = score + 2
    judge = "GREAT"
    jcol = ColorSRGB(90, 255, 120, 255)
  } else {
    nO = nO + 1
    score = score + 1
    judge = "GOOD"
    jcol = ColorSRGB(80, 180, 255, 255)
  }
  combo = combo + 1
  maxCombo = max(maxCombo, combo)
  points()
}

mod missed() {
  nM = nM + 1
  combo = 0
  judge = "MISS"
  jcol = ColorSRGB(255, 50, 50, 255)
  points()
}

mod finish() {
  state = 3
  silence()
  clearScreen()
  let pct = score / max(1.0, 3.0 * STEPS[song])
  let pts: int = floor(pct * 1000000.0)
  let grade = if nG + nO + nM == 0 then "AAA" else if pct >= 0.93 then "AA" else if pct >= 0.8 then "A" else if pct >= 0.65 then "B" else if pct >= 0.45 then "C" else "D"
  let coins: int = floor(25.0 * pct * pct)
  let ctrl = player.ControllerOf()
  if coins > 0 {
    ctrl.IncLeaderboard("coins", coins)
  }
  let key = "${song}:${ctrl.GetUserId()}"
  let b = best.get(key)
  if !b.Found || pts > b.Value {
    best.set(key, pts)
  }
  judge = "${grade}  ${pts}"
  jcol = ColorSRGB(255, 225, 60, 255)
  info = "P${nP} G${nG} OK${nO} X${nM}"
  comboTxt = "MAX ${maxCombo}  +${coins}c"
  title = "${NAMES[song]}\nCLEARED!\n↑ NEXT"
  BroadcastChatMessage("<color=\"ff60d0\">${ctrl.GetUserName()} danced ${NAMES[song]}: ${grade} (${pts})</>")
}

mod menuKey(k: int) {
  if k == 0 {
    song = (song + 9) % 10
    menu()
  } else if k == 3 {
    song = (song + 1) % 10
    menu()
  } else if k == 2 {
    start()
  }
}

mod press0() {
  if state == 2 {
    if ni0 < ne0 {
      let t = ServerUptime() - t0 - sync
      let dt = abs(t - NT0[ni0])
      if dt <= 0.16 {
        judgeHit(dt)
        flash0 = t
        let at: int = (NR0[ni0] + lead) * 2
        live0 = live0.Substring(0, at) .. " " .. live0.Substring(at + 1, live0.Length() - at - 1)
        ni0 = ni0 + 1
        redraw()
      }
    }
  } else if state == 1 {
    menuKey(0)
  } else if state == 3 {
    menu()
  }
}

mod press1() {
  if state == 2 {
    if ni1 < ne1 {
      let t = ServerUptime() - t0 - sync
      let dt = abs(t - NT1[ni1])
      if dt <= 0.16 {
        judgeHit(dt)
        flash1 = t
        let at: int = (NR1[ni1] + lead) * 2
        live1 = live1.Substring(0, at) .. " " .. live1.Substring(at + 1, live1.Length() - at - 1)
        ni1 = ni1 + 1
        redraw()
      }
    }
  } else if state == 1 {
    menuKey(1)
  } else if state == 3 {
    menu()
  }
}

mod press2() {
  if state == 2 {
    if ni2 < ne2 {
      let t = ServerUptime() - t0 - sync
      let dt = abs(t - NT2[ni2])
      if dt <= 0.16 {
        judgeHit(dt)
        flash2 = t
        let at: int = (NR2[ni2] + lead) * 2
        live2 = live2.Substring(0, at) .. " " .. live2.Substring(at + 1, live2.Length() - at - 1)
        ni2 = ni2 + 1
        redraw()
      }
    }
  } else if state == 1 {
    menuKey(2)
  } else if state == 3 {
    menu()
  }
}

mod press3() {
  if state == 2 {
    if ni3 < ne3 {
      let t = ServerUptime() - t0 - sync
      let dt = abs(t - NT3[ni3])
      if dt <= 0.16 {
        judgeHit(dt)
        flash3 = t
        let at: int = (NR3[ni3] + lead) * 2
        live3 = live3.Substring(0, at) .. " " .. live3.Substring(at + 1, live3.Length() - at - 1)
        ni3 = ni3 + 1
        redraw()
      }
    }
  } else if state == 1 {
    menuKey(3)
  } else if state == 3 {
    menu()
  }
}

on player {
  BroadcastChatMessage("<color=\"8080ff\">[ddr] seat state=${state} sat=${player != none}</>")
  if player == none {
    state = 0
    silence()
    clearScreen()
    title = "SIT DOWN TO DANCE"
  } else {
    menu()
  }
}

let inp = player.InputReader()
on inp.Right < -0.5 {
  if inp.Right < -0.5 {
    pcol0 = ColorSRGB(255, 70, 210, 255)
    press0()
  } else {
    pcol0 = ColorSRGB(40, 40, 50, 255)
  }
}
on inp.Forward < -0.5 {
  if inp.Forward < -0.5 {
    pcol1 = ColorSRGB(60, 210, 255, 255)
    press1()
  } else {
    pcol1 = ColorSRGB(40, 40, 50, 255)
  }
}
on inp.Forward > 0.5 {
  if inp.Forward > 0.5 {
    pcol2 = ColorSRGB(90, 255, 120, 255)
    press2()
  } else {
    pcol2 = ColorSRGB(40, 40, 50, 255)
  }
}
on inp.Right > 0.5 {
  if inp.Right > 0.5 {
    pcol3 = ColorSRGB(255, 170, 40, 255)
    press3()
  } else {
    pcol3 = ColorSRGB(40, 40, 50, 255)
  }
}
on ChatCommand("ddrsync", "DDR: shift the arrows vs the music, in ms (+ = arrows later)") -> (ctrl, args) {
  sync = args.Trim().ParseNumber() / 1000.0
  BroadcastChatMessage("<color=\"ff60d0\">DDR sync now ${floor(sync * 1000.0 + 0.5)} ms</>")
}

// Q or E: stop the song, back to song select
on inp.PressedQ || inp.PressedE {
  if (inp.PressedQ || inp.PressedE) && state == 2 {
  BroadcastChatMessage("<color=\"8080ff\">[ddr] stopped</>")
    menu()
  }
}

// always running (a Clock switched on/off through 'enabled' got stuck): only works while dancing
on Clock(interval = 0.02) {
  if state == 2 {
    let t = ServerUptime() - t0
    let tc = t - sync
    if t > LEN[song] + 1.5 {
      finish()
    } else {
      let row: int = floor(tc / rowD + 0.5)   // rounded: an arrow sits on the receptor row centred on its time
      if row != lastRow {
        lastRow = row
        redraw()
      }
      if ni0 < ne0 && tc > NT0[ni0] + 0.16 {
        missed()
        ni0 = ni0 + 1
      }
      rcol0 = if tc - flash0 < 0.12 then ColorSRGB(255, 70, 210, 255) else ColorSRGB(70, 70, 80, 255)
      if ni1 < ne1 && tc > NT1[ni1] + 0.16 {
        missed()
        ni1 = ni1 + 1
      }
      rcol1 = if tc - flash1 < 0.12 then ColorSRGB(60, 210, 255, 255) else ColorSRGB(70, 70, 80, 255)
      if ni2 < ne2 && tc > NT2[ni2] + 0.16 {
        missed()
        ni2 = ni2 + 1
      }
      rcol2 = if tc - flash2 < 0.12 then ColorSRGB(90, 255, 120, 255) else ColorSRGB(70, 70, 80, 255)
      if ni3 < ne3 && tc > NT3[ni3] + 0.16 {
        missed()
        ni3 = ni3 + 1
      }
      rcol3 = if tc - flash3 < 0.12 then ColorSRGB(255, 170, 40, 255) else ColorSRGB(70, 70, 80, 255)
      if vi0 < ve0 && t >= VT0[vi0] {
        vp0 = VP0[vi0]
        vo0 = VE0[vi0]
        va0 = VV0[vi0] * 2.0
        vs0 = t
        vv0 = va0
        vi0 = vi0 + 1
      } else if t >= vo0 {
        vv0 = 0.0
      } else {
        vv0 = va0 * max(0.7, 1.0 - (t - vs0) * 1.0)    // pluck: decay to a 70% sustain
      }
      if vi1 < ve1 && t >= VT1[vi1] {
        vp1 = VP1[vi1]
        vo1 = VE1[vi1]
        va1 = VV1[vi1] * 2.0
        vs1 = t
        vv1 = va1
        vi1 = vi1 + 1
      } else if t >= vo1 {
        vv1 = 0.0
      } else {
        vv1 = va1 * max(0.7, 1.0 - (t - vs1) * 1.0)    // pluck: decay to a 70% sustain
      }
      if vi2 < ve2 && t >= VT2[vi2] {
        vp2 = VP2[vi2]
        vo2 = VE2[vi2]
        va2 = VV2[vi2] * 2.0
        vs2 = t
        vv2 = va2
        vi2 = vi2 + 1
      } else if t >= vo2 {
        vv2 = 0.0
      } else {
        vv2 = va2 * max(0.7, 1.0 - (t - vs2) * 1.0)    // pluck: decay to a 70% sustain
      }
      if vi3 < ve3 && t >= VT3[vi3] {
        vp3 = VP3[vi3]
        vo3 = VE3[vi3]
        va3 = VV3[vi3] * 2.0
        vs3 = t
        vv3 = va3
        vi3 = vi3 + 1
      } else if t >= vo3 {
        vv3 = 0.0
      } else {
        vv3 = va3 * max(0.7, 1.0 - (t - vs3) * 1.0)    // pluck: decay to a 70% sustain
      }
      if vi4 < ve4 && t >= VT4[vi4] {
        vp4 = VP4[vi4]
        vo4 = VE4[vi4]
        va4 = VV4[vi4] * 2.0
        vs4 = t
        vv4 = va4
        vi4 = vi4 + 1
      } else if t >= vo4 {
        vv4 = 0.0
      } else {
        vv4 = va4 * max(0.7, 1.0 - (t - vs4) * 1.0)    // pluck: decay to a 70% sustain
      }
      if vi5 < ve5 && t >= VT5[vi5] {
        vp5 = VP5[vi5]
        vo5 = VE5[vi5]
        va5 = VV5[vi5] * 2.0
        vs5 = t
        vv5 = va5
        vi5 = vi5 + 1
      } else if t >= vo5 {
        vv5 = 0.0
      } else {
        vv5 = va5 * max(0.7, 1.0 - (t - vs5) * 1.0)    // pluck: decay to a 70% sustain
      }
      if vi6 < ve6 && t >= VT6[vi6] {
        vp6 = VP6[vi6]
        vo6 = VE6[vi6]
        va6 = VV6[vi6] * 2.0
        vs6 = t
        vv6 = va6
        vi6 = vi6 + 1
      } else if t >= vo6 {
        vv6 = 0.0
      } else {
        vv6 = va6 * max(0.7, 1.0 - (t - vs6) * 1.0)    // pluck: decay to a 70% sustain
      }
      if t < 0.0 {
        let c: int = ceil(-t)
        title = "${NAMES[song]}\nGET READY  ${c}"
      } else if t < 1.0 {
        title = "${NAMES[song]}\nGO!"
        judge = if judge == "READY" then "GO!" else judge
      } else if title != NAMES[song] {
        title = NAMES[song]
      }
    }
  }
}
