      if di3 < de3 && t >= DT3[di3] {
        dn3 = dn3 + 1.0
        dg3 = DV3[di3] * fade
        ds3 = DS3[di3]
        di3 = di3 + 1
      }
      if di4 < de4 && t >= DT4[di4] {
        dn4 = dn4 + 1.0
        dg4 = DV4[di4] * fade
        di4 = di4 + 1
