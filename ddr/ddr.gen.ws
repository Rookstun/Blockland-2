      } else if t >= vo8 {
        vv8 = 0.0
      } else {
        vv8 = va8 * max(0.3, 1.0 - (t - vs8) * 5.0)    // clicky: fast decay
      }
      if vi9 < ve9 && t >= VT9[vi9] {
        vp9 = VP9[vi9]
        vo9 = VE9[vi9]
        va9 = VV9[vi9] * 2.0
        vs9 = t
        vv9 = va9
        vi9 = vi9 + 1
      } else if t >= vo9 {
