var none: character
var state: int = 0          // 0 nobody seated, 1 song select, 2 dancing, 3 results
var song: int = 0
var t0: float = 0.0
var lastRow: int = -99999
var lead: int = 0
var rowD: float = 0.1
var frac: float = 0.0
var title: string = "SIT DOWN TO DANCE\n1 OR 2 PLAYERS"
var best: Map<string, int>
var act0: bool = false
var rdy0: bool = false
var score0: int = 0
var combo0: int = 0
var maxCombo0: int = 0
var nP0: int = 0
var nG0: int = 0
var nO0: int = 0
var nM0: int = 0
var judge0: string = ""
var jcol0: color = ColorSRGB(255, 255, 255, 255)
var info0: string = ""
var comboTxt0: string = ""
var act1: bool = false
var rdy1: bool = false
var score1: int = 0
var combo1: int = 0
var maxCombo1: int = 0
var nP1: int = 0
var nG1: int = 0
var nO1: int = 0
var nM1: int = 0
var judge1: string = ""
var jcol1: color = ColorSRGB(255, 255, 255, 255)
var info1: string = ""
var comboTxt1: string = ""
var live00: string = ""
var scr00: string = ""
var ni00: int = 0
var ne00: int = 0
var flash00: float = -9.0
var rcol00: color = ColorSRGB(70, 70, 80, 255)
var pcol00: color = ColorSRGB(40, 40, 50, 255)
var live01: string = ""
var scr01: string = ""
var ni01: int = 0
var ne01: int = 0
var flash01: float = -9.0
var rcol01: color = ColorSRGB(70, 70, 80, 255)
var pcol01: color = ColorSRGB(40, 40, 50, 255)
var live02: string = ""
var scr02: string = ""
var ni02: int = 0
var ne02: int = 0
var flash02: float = -9.0
var rcol02: color = ColorSRGB(70, 70, 80, 255)
var pcol02: color = ColorSRGB(40, 40, 50, 255)
var live03: string = ""
var scr03: string = ""
var ni03: int = 0
var ne03: int = 0
var flash03: float = -9.0
var rcol03: color = ColorSRGB(70, 70, 80, 255)
var pcol03: color = ColorSRGB(40, 40, 50, 255)
var live10: string = ""
var scr10: string = ""
var ni10: int = 0
var ne10: int = 0
var flash10: float = -9.0
var rcol10: color = ColorSRGB(70, 70, 80, 255)
var pcol10: color = ColorSRGB(40, 40, 50, 255)
var live11: string = ""
var scr11: string = ""
var ni11: int = 0
var ne11: int = 0
var flash11: float = -9.0
var rcol11: color = ColorSRGB(70, 70, 80, 255)
var pcol11: color = ColorSRGB(40, 40, 50, 255)
var live12: string = ""
var scr12: string = ""
var ni12: int = 0
var ne12: int = 0
var flash12: float = -9.0
var rcol12: color = ColorSRGB(70, 70, 80, 255)
var pcol12: color = ColorSRGB(40, 40, 50, 255)
var live13: string = ""
var scr13: string = ""
var ni13: int = 0
var ne13: int = 0
var flash13: float = -9.0
var rcol13: color = ColorSRGB(70, 70, 80, 255)
var pcol13: color = ColorSRGB(40, 40, 50, 255)
var vi0: int = 0
var ve0: int = 0
var vp0: float = 1.0
var vv0: float = 0.0
var vo0: float = 0.0
var vi1: int = 0
var ve1: int = 0
var vp1: float = 1.0
var vv1: float = 0.0
var vo1: float = 0.0

out title_t: string = title
out scroll: float = frac
out judge0_t: string = judge0
out judge0_c: color = jcol0
out info0_t: string = info0
out combo0_t: string = comboTxt0
out judge1_t: string = judge1
out judge1_c: color = jcol1
out info1_t: string = info1
out combo1_t: string = comboTxt1
out lane00: string = scr00
out rec00: color = rcol00
out pad00: color = pcol00
out lane01: string = scr01
out rec01: color = rcol01
out pad01: color = pcol01
out lane02: string = scr02
out rec02: color = rcol02
out pad02: color = pcol02
out lane03: string = scr03
out rec03: color = rcol03
out pad03: color = pcol03
out lane10: string = scr10
out rec10: color = rcol10
out pad10: color = pcol10
out lane11: string = scr11
out rec11: color = rcol11
out pad11: color = pcol11
out lane12: string = scr12
out rec12: color = rcol12
out pad12: color = pcol12
out lane13: string = scr13
out rec13: color = rcol13
out pad13: color = pcol13
out P0: float = vp0
out V0: float = vv0
out P1: float = vp1
out V1: float = vv1

mod silence() {
  vv0 = 0.0
  vv1 = 0.0
}

mod redraw() {
  let base: int = max(0, lastRow + lead) * 2
  scr00 = if act0 then live00.Substring(base, 26) else ""
  scr01 = if act0 then live01.Substring(base, 26) else ""
  scr02 = if act0 then live02.Substring(base, 26) else ""
  scr03 = if act0 then live03.Substring(base, 26) else ""
  scr10 = if act1 then live10.Substring(base, 26) else ""
  scr11 = if act1 then live11.Substring(base, 26) else ""
  scr12 = if act1 then live12.Substring(base, 26) else ""
  scr13 = if act1 then live13.Substring(base, 26) else ""
}

mod clearScreen() {
  scr00 = ""
  scr01 = ""
  scr02 = ""
  scr03 = ""
  scr10 = ""
  scr11 = ""
  scr12 = ""
  scr13 = ""
  judge0 = ""
  info0 = ""
  comboTxt0 = ""
  judge1 = ""
  info1 = ""
  comboTxt1 = ""
  frac = 0.0
}

// the ready-up: every seated dancer presses UP, then the song starts
mod readyInfo() {
  info0 = if player0 == none then "P1 SIT DOWN" else if rdy0 then "P1 READY!" else "P1 PRESS ↑"
  info1 = if player1 == none then "P2 SIT DOWN" else if rdy1 then "P2 READY!" else "P2 PRESS ↑"
}

mod menu() {
  state = 1
  silence()
  clearScreen()
  let who = if player0 != none then player0 else player1
  let key = "${song}:${who.ControllerOf().GetUserId()}"
  let b = best.get(key)
  let bestTxt = if b.Found then "BEST ${b.Value}" else "NO SCORE YET"
  title = "◄ ${NAMES[song]} ►\n${BPM[song]} BPM  ${STEPS[song]} STEPS  ${bestTxt}\n← → PICK   ↑ START"
  rdy0 = false
  rdy1 = false
  readyInfo()
}


mod start() {
  rowD = ROWD[song]
  lead = LEAD[song]
  act0 = player0 != none
  score0 = 0
  combo0 = 0
  maxCombo0 = 0
  nP0 = 0
  nG0 = 0
  nO0 = 0
  nM0 = 0
  judge0 = if act0 then "READY" else ""
  jcol0 = ColorSRGB(255, 255, 255, 255)
  info0 = if act0 then "0" else ""
  comboTxt0 = ""
  act1 = player1 != none
  score1 = 0
  combo1 = 0
  maxCombo1 = 0
  nP1 = 0
  nG1 = 0
  nO1 = 0
  nM1 = 0
  judge1 = if act1 then "READY" else ""
  jcol1 = ColorSRGB(255, 255, 255, 255)
  info1 = if act1 then "0" else ""
  comboTxt1 = ""
  live00 = LS0[song]
  ni00 = NO0[song]
  ne00 = if act0 then NO0[song + 1] else NO0[song]
  live01 = LS1[song]
  ni01 = NO1[song]
  ne01 = if act0 then NO1[song + 1] else NO1[song]
  live02 = LS2[song]
  ni02 = NO2[song]
  ne02 = if act0 then NO2[song + 1] else NO2[song]
  live03 = LS3[song]
  ni03 = NO3[song]
  ne03 = if act0 then NO3[song + 1] else NO3[song]
  live10 = LS0[song]
  ni10 = NO0[song]
  ne10 = if act1 then NO0[song + 1] else NO0[song]
  live11 = LS1[song]
  ni11 = NO1[song]
  ne11 = if act1 then NO1[song + 1] else NO1[song]
  live12 = LS2[song]
  ni12 = NO2[song]
  ne12 = if act1 then NO2[song + 1] else NO2[song]
  live13 = LS3[song]
  ni13 = NO3[song]
  ne13 = if act1 then NO3[song + 1] else NO3[song]
  vi0 = VO0[song]
  ve0 = VO0[song + 1]
  vi1 = VO1[song]
  ve1 = VO1[song + 1]
  t0 = ServerUptime() + 4.0
  lastRow = -99999
  title = NAMES[song]
  state = 2
}

mod points0() {
  info0 = "${floor(score0 * 1000000.0 / max(1.0, 3.0 * STEPS[song]))}"
  comboTxt0 = if combo0 >= 4 then "${combo0} COMBO" else ""
}

mod judgeHit0(dt: float) {
  if dt <= 0.05 {
    nP0 = nP0 + 1
    score0 = score0 + 3
    judge0 = "PERFECT"
    jcol0 = ColorSRGB(255, 225, 60, 255)
  } else if dt <= 0.1 {
    nG0 = nG0 + 1
    score0 = score0 + 2
    judge0 = "GREAT"
    jcol0 = ColorSRGB(90, 255, 120, 255)
  } else {
    nO0 = nO0 + 1
    score0 = score0 + 1
    judge0 = "GOOD"
    jcol0 = ColorSRGB(80, 180, 255, 255)
  }
  combo0 = combo0 + 1
  maxCombo0 = max(maxCombo0, combo0)
  points0()
}

mod missed0() {
  nM0 = nM0 + 1
  combo0 = 0
  judge0 = "MISS"
  jcol0 = ColorSRGB(255, 50, 50, 255)
  points0()
}

mod result0() {
  if act0 && player0 != none {
    let pct = score0 / max(1.0, 3.0 * STEPS[song])
    let pts: int = floor(pct * 1000000.0)
    let grade = if nG0 + nO0 + nM0 == 0 then "AAA" else if pct >= 0.93 then "AA" else if pct >= 0.8 then "A" else if pct >= 0.65 then "B" else if pct >= 0.45 then "C" else "D"
    let coins: int = floor(25.0 * pct * pct)
    let ctrl = player0.ControllerOf()
    if coins > 0 {
      ctrl.IncLeaderboard("coins", coins)
    }
    let key = "${song}:${ctrl.GetUserId()}"
    let b = best.get(key)
    if !b.Found || pts > b.Value {
      best.set(key, pts)
    }
    judge0 = "${grade}  ${pts}"
    jcol0 = ColorSRGB(255, 225, 60, 255)
    info0 = "P${nP0} G${nG0} OK${nO0} X${nM0}"
    comboTxt0 = "MAX ${maxCombo0}  +${coins}c"
    BroadcastChatMessage("<color=\"ff60d0\">${ctrl.GetUserName()} danced ${NAMES[song]}: ${grade} (${pts})</>")
  }
}
mod points1() {
  info1 = "${floor(score1 * 1000000.0 / max(1.0, 3.0 * STEPS[song]))}"
  comboTxt1 = if combo1 >= 4 then "${combo1} COMBO" else ""
}

mod judgeHit1(dt: float) {
  if dt <= 0.05 {
    nP1 = nP1 + 1
    score1 = score1 + 3
    judge1 = "PERFECT"
    jcol1 = ColorSRGB(255, 225, 60, 255)
  } else if dt <= 0.1 {
    nG1 = nG1 + 1
    score1 = score1 + 2
    judge1 = "GREAT"
    jcol1 = ColorSRGB(90, 255, 120, 255)
  } else {
    nO1 = nO1 + 1
    score1 = score1 + 1
    judge1 = "GOOD"
    jcol1 = ColorSRGB(80, 180, 255, 255)
  }
  combo1 = combo1 + 1
  maxCombo1 = max(maxCombo1, combo1)
  points1()
}

mod missed1() {
  nM1 = nM1 + 1
  combo1 = 0
  judge1 = "MISS"
  jcol1 = ColorSRGB(255, 50, 50, 255)
  points1()
}

mod result1() {
  if act1 && player1 != none {
    let pct = score1 / max(1.0, 3.0 * STEPS[song])
    let pts: int = floor(pct * 1000000.0)
    let grade = if nG1 + nO1 + nM1 == 0 then "AAA" else if pct >= 0.93 then "AA" else if pct >= 0.8 then "A" else if pct >= 0.65 then "B" else if pct >= 0.45 then "C" else "D"
    let coins: int = floor(25.0 * pct * pct)
    let ctrl = player1.ControllerOf()
    if coins > 0 {
      ctrl.IncLeaderboard("coins", coins)
    }
    let key = "${song}:${ctrl.GetUserId()}"
    let b = best.get(key)
    if !b.Found || pts > b.Value {
      best.set(key, pts)
    }
    judge1 = "${grade}  ${pts}"
    jcol1 = ColorSRGB(255, 225, 60, 255)
    info1 = "P${nP1} G${nG1} OK${nO1} X${nM1}"
    comboTxt1 = "MAX ${maxCombo1}  +${coins}c"
    BroadcastChatMessage("<color=\"ff60d0\">${ctrl.GetUserName()} danced ${NAMES[song]}: ${grade} (${pts})</>")
  }
}

mod finish() {
  state = 3
  silence()
  clearScreen()
  result0()
  result1()
  title = "${NAMES[song]}\nCLEARED!\n↑ NEXT"
}

mod menuKey0(k: int) {
  if k == 0 {
    song = (song + 1) % 2
    menu()
  } else if k == 3 {
    song = (song + 1) % 2
    menu()
  } else if k == 1 {
    rdy0 = false
    readyInfo()
  } else if k == 2 {
    rdy0 = true
    readyInfo()
    if (player0 == none || rdy0) && (player1 == none || rdy1) {
      start()
    }
  }
}
mod menuKey1(k: int) {
  if k == 0 {
    song = (song + 1) % 2
    menu()
  } else if k == 3 {
    song = (song + 1) % 2
    menu()
  } else if k == 1 {
    rdy1 = false
    readyInfo()
  } else if k == 2 {
    rdy1 = true
    readyInfo()
    if (player0 == none || rdy0) && (player1 == none || rdy1) {
      start()
    }
  }
}

mod press00() {
  if state == 2 {
    if act0 && ni00 < ne00 {
      let t = ServerUptime() - t0
      let dt = abs(t - NT0[ni00])
      if dt <= 0.16 {
        judgeHit0(dt)
        flash00 = t
        let at: int = (NR0[ni00] + lead) * 2
        live00 = live00.Substring(0, at) .. " " .. live00.Substring(at + 1, live00.Length() - at - 1)
        ni00 = ni00 + 1
        redraw()
      }
    }
  } else if state == 1 {
    menuKey0(0)
  } else if state == 3 {
    menu()
  }
}
