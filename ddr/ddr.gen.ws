        vi10 = vi10 + 1
      } else if t >= vo10 {
        vv10 = 0.0
      } else {
        vv10 = va10 * fade * max(0.3, 1.0 - (t - vs10) * 5.0)    // clicky: fast decay
      }
      if di0 < de0 && t >= DT0[di0] {
        dn0 = dn0 + 1.0
        dg0 = DV0[di0] * fade
        di0 = di0 + 1
      }
      if di1 < de1 && t >= DT1[di1] {
        dn1 = dn1 + 1.0
        dg1 = DV1[di1] * fade
        di1 = di1 + 1
      }
      if di2 < de2 && t >= DT2[di2] {
        dn2 = dn2 + 1.0
        dg2 = DV2[di2] * fade
