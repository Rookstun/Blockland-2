mod showHud() {
  hud = if state == 0 then "W A S D MOVE   GRAB COINS   REACH GREEN" else ("LEVEL " .. (lvl + 1) .. "   COINS LEFT " .. coins .. "   DEATHS " .. deaths)
}

mod say(s: string, n: int) {
  msg = s
  msgT = n
}

mod put(i: int, k: int) {
  act[i] = k
  oldA[nA] = i
  nA += 1
}

mod stamp() {
  for k in 0..16 { act[oldA[k]] = 0 }
  for k in 0..16 { oldA[k] = 0 }
  nA = 0
  if state == 1 || state == 2 || state == 3 {
    for i in 0..ne {
      let ix: int = floor(ex[i])
      let iy: int = floor(ey[i])
      put(iy * 24 + ix, 7)
    }
    let qx: int = floor(px)
    let qy: int = floor(py)
    put(qy * 24 + qx, 6)
  }
}

mod spawn() {
  px = 8
  py = 7.5
  let m = lvl % 3
  ne = NEN[m]
  for i in 0..12 {
    ex[i] = DC[m * 12 + i]
    ey[i] = DR[m * 12 + i]
    evx[i] = DVX[m * 12 + i]
    evy[i] = DVY[m * 12 + i]
  }
}

mod loadLevel() {
  let m = lvl % 3
  for i in 0..384 { cur[i] = MAPK[m * 384 + i] }
  coins = COINS[m]
  spawn()
  state = 1
  stT = 0
  say(LVNAME[m], 40)
  showHud()
}

mod newGame() {
  lvl = 0
  deaths = 0
  loadLevel()
}

mod moveDots() {
  for i in 0..ne {
    let nx = ex[i] + evx[i]
    let ny = ey[i] + evy[i]
    let ix: int = floor(nx)
    let iy: int = floor(ny)
    if cur[iy * 24 + ix] == 1 {
      evx[i] = 0.0 - evx[i]
      evy[i] = 0.0 - evy[i]
    } else {
      ex[i] = nx
      ey[i] = ny
    }
  }
}

mod movePlayer(kL: bool, kR: bool, kU: bool, kD: bool) {
  var dx: float = 0.0
  var dy: float = 0.0
  if kL { dx -= 0.2 }
  if kR { dx += 0.2 }
  if kU { dy -= 0.2 }
  if kD { dy += 0.2 }
  let tx = px + dx
  let ix: int = floor(tx)
  let iy: int = floor(py)
  if cur[iy * 24 + ix] != 1 { px = tx }
  let ty = py + dy
  let jx: int = floor(px)
  let jy: int = floor(ty)
  if cur[jy * 24 + jx] != 1 { py = ty }
}

mod touch() {
  let qx: int = floor(px)
  let qy: int = floor(py)
  let i = qy * 24 + qx
  if cur[i] == 5 {
    cur[i] = if (qx + qy) % 2 == 1 then 2 else 0
    coins -= 1
    blipT = t
    showHud()
  }
  if cur[i] == 4 && coins <= 0 {
    state = 3
    stT = 0
    say("LEVEL CLEAR", 0)
  }
  for k in 0..ne {
    let dx = px - ex[k]
    let dy = py - ey[k]
    if dx < 0.8 && dx > -0.8 && dy < 0.8 && dy > -0.8 && state == 1 {
      deaths += 1
      hitT = t
      state = 2
      stT = 0
      say("OUCH", 0)
      showHud()
    }
  }
}

mod compose(r0: int, r1: int) {
  for ty in r0..r1 {
    var sT: string = ""
    var cT: int = -1
    var nT: int = 0
    var sB: string = ""
    var cB: int = -1
    var nB: int = 0
    for tx in 0..24 {
      let i = ty * 24 + tx
      var k: int = act[i]
      if k == 0 { k = cur[i] }
      let o = k * 4
      let a = LOOK[o]
      let b = LOOK[o + 1]
      let c = LOOK[o + 2]
      let d = LOOK[o + 3]
      if a == cT { nT += 1 } else {
        if nT > 0 { sT = sT .. OPEN[cT] .. BLK[nT] .. CLOSE[cT] }
        cT = a
        nT = 1
      }
      if b == cT { nT += 1 } else {
        if nT > 0 { sT = sT .. OPEN[cT] .. BLK[nT] .. CLOSE[cT] }
        cT = b
        nT = 1
      }
      if c == cB { nB += 1 } else {
        if nB > 0 { sB = sB .. OPEN[cB] .. BLK[nB] .. CLOSE[cB] }
        cB = c
        nB = 1
      }
      if d == cB { nB += 1 } else {
        if nB > 0 { sB = sB .. OPEN[cB] .. BLK[nB] .. CLOSE[cB] }
        cB = d
        nB = 1
      }
    }
    rows[ty * 2] = sT .. OPEN[cT] .. BLK[nT] .. CLOSE[cT]
    rows[ty * 2 + 1] = sB .. OPEN[cB] .. BLK[nB] .. CLOSE[cB]
  }
}

mod powerOn() {
  booted = true
  lvl = 0
  deaths = 0
  loadLevel()
  state = 0
  say("HOLD SPACE TO START", 0)
  showHud()
}

mod powerOff() {
  booted = false
  state = 0
  msg = ""
  hud = ""
  st0 = ""
  st1 = ""
  st2 = ""
  st3 = ""
  st4 = ""
  st5 = ""
  st6 = ""
  st7 = ""
  aV0 = 0.0
  aV1 = 0.0
}

on tick {
  let pwr = seated
  if !pwr {
    if booted { powerOff() }
  } else {
    if !booted { powerOn() }
    let ia = a || b
    let kL = left
    let kR = right
    let kU = up
    let kD = down
    t += 1
    let aE = ia && !pA
    if state == 0 {
      if stT < 100 { stT += 1 }
      if stT > 20 && aE { newGame() }
    } else if state == 1 {
      movePlayer(kL, kR, kU, kD)
      moveDots()
      touch()
    } else if state == 2 {
      stT += 1
      if stT >= 14 {
        spawn()
        state = 1
        stT = 0
        say("", 0)
      }
    } else if state == 3 {
      stT += 1
      if stT >= 40 {
        lvl += 1
        loadLevel()
      }
    }
    if msgT > 0 {
      msgT -= 1
      if msgT == 0 { msg = "" }
    }
    let be = t - blipT
    aV0 = if be < 4 then 0.4 else 0.0
    aP0 = 1.6 + be * 0.15
    let he = t - hitT
    aV1 = if he < 8 then 0.6 else 0.0
    aP1 = 1.0
    stamp()
    let ph = t % 2
    compose(ph * 8, ph * 8 + 8)
    if ph == 0 {
    st0 = rows[0] .. "\n" .. rows[1] .. "\n" .. rows[2] .. "\n" .. rows[3]
    st1 = rows[4] .. "\n" .. rows[5] .. "\n" .. rows[6] .. "\n" .. rows[7]
    st2 = rows[8] .. "\n" .. rows[9] .. "\n" .. rows[10] .. "\n" .. rows[11]
    st3 = rows[12] .. "\n" .. rows[13] .. "\n" .. rows[14] .. "\n" .. rows[15]
    } else {
    st4 = rows[16] .. "\n" .. rows[17] .. "\n" .. rows[18] .. "\n" .. rows[19]
    st5 = rows[20] .. "\n" .. rows[21] .. "\n" .. rows[22] .. "\n" .. rows[23]
    st6 = rows[24] .. "\n" .. rows[25] .. "\n" .. rows[26] .. "\n" .. rows[27]
    st7 = rows[28] .. "\n" .. rows[29] .. "\n" .. rows[30] .. "\n" .. rows[31]
    }
    pA = ia
  }
}
