@right out msg_: string = msg
@right out hud_: string = hud
@right out title_: string = if state == 0 then "FREDDY GOT FINGERED" else ""
@right out P0: float = aP0
@right out V0: float = aV0
@right out P1: float = aP1
@right out V1: float = aV1
@right out P2: float = aP2
@right out V2: float = aV2
@right out state_: int = state

// ---------- helpers
mod say(s: string, n: int) {
  msg = s
  msgT = n
}
mod playSong(s: int) {
  song = s
  mi0 = 0
  md0 = 0
  mi1 = 0
  md1 = 0
  mp0 = 0.0
  mp1 = 0.0
}
mod sfx(k: int) {
  fxId = k
  fxI = 0
}
mod overlap(ax: float, ay: float, aw: float, ah: float, bx0: float, by0: float, bw: float, bh: float) -> bool {
  return ax < bx0 + bw && bx0 < ax + aw && ay < by0 + bh && by0 < ay + ah
}

// ---------- sound
mod audio() {
  if song >= 0 {
    md0 -= 1
    if md0 <= 0 {
      if mi0 >= VL0[song] && SLOOP[song] > 0 { mi0 = 0 }
      if mi0 < VL0[song] {
        let n = VO0[song] + mi0
        mp0 = NP0[n]
        md0 = ND0[n]
        mt0 = 0
        mi0 += 1
      } else {
        mp0 = 0.0
        md0 = 100000
      }
    }
    md1 -= 1
    if md1 <= 0 {
      if mi1 >= VL1[song] && SLOOP[song] > 0 { mi1 = 0 }
      if mi1 < VL1[song] {
        let n = VO1[song] + mi1
        mp1 = NP1[n]
        md1 = ND1[n]
        mi1 += 1
      } else {
        mp1 = 0.0
        md1 = 100000
      }
    }
    mt0 += 1
  }
  if mp0 > 0.0 {
    aP0 = mp0
    aV0 = if md0 <= 1 then 0.0 else 0.3 * max(0.4, 1.0 - mt0 * 0.06)
  } else { aV0 = 0.0 }
  if mp1 > 0.0 {
    aP1 = mp1
    aV1 = if md1 <= 1 then 0.0 else 0.55
  } else { aV1 = 0.0 }
  if fxId >= 0 {
    if fxI < FXL[fxId] {
      aP2 = FXP[FXO[fxId] + fxI]
      aV2 = 0.5
      fxI += 1
    } else {
      fxId = -1
      aV2 = 0.0
    }
  } else { aV2 = 0.0 }
}

// ---------- drawing
mod eraseRect(x: int, y: int, w: int, h: int) {
  for j in 0..w * h {
    let cx = x + j % w
    let cy = y + j / w
    if cx >= 0 && cx < W && cy >= 0 && cy < H {
      let i = cy * W + cx
      if fb[i] != bg[i] {
        fb[i] = bg[i]
        dirty[cy] = 1
      }
    }
  }
}
mod put(cx: int, cy: int, c: int) {
  if cx >= 0 && cx < W && cy >= 0 && cy < H {
    let i = cy * W + cx
    if fb[i] != c {
      fb[i] = c
      dirty[cy] = 1
    }
  }
}
mod drawSpr(s: int, x: int, y: int, white: int) {
  let w = SW[s]
  let o = SOFF[s]
  for j in 0..w * SH[s] {
    let c = SPR[o + j]
    if c >= 0 { put(x + j % w, y + j / w, if white > 0 then 7 else c) }
  }
  rx.push(x)
  ry.push(y)
  rw.push(w)
  rh.push(SH[s])
}
mod encRow(r: int) {
  var s: string = ""
  var c0: int = -1
  var n: int = 0
  for c in 0..W {
    let p = fb[r * W + c]
    if p == c0 {
      n += 1
    } else {
      if n > 0 { s = s .. OPEN[c0] .. BLK[n] .. CLOSE[c0] }
      c0 = p
      n = 1
    }
  }
  rows[r] = s .. OPEN[c0] .. BLK[n] .. CLOSE[c0]
}
mod setScene(which: int) {
  if which == 1 { bg.copyFrom(BGSKATE) }
  else if which == 2 { bg.copyFrom(BGKEYS) }
  else if which == 4 { bg.copyFrom(BGHOME) }
  else { bg.copyFrom(BGOFFICE) }
  fb.copyFrom(bg)
  for i in 0..H { dirty[i] = 1 }
  rx.clear()
  ry.clear()
  rw.clear()
  rh.clear()
}
mod render() {
  for i in 0..rx.length() { eraseRect(rx[i], ry[i], rw[i], rh[i]) }
  rx.clear()
  ry.clear()
  rw.clear()
  rh.clear()
  if state == 0 || state == 1 || state == 5 {
    // lane dashes on the road roll by
    for x in 0..W { put(x, 33, if (x + dash) % 10 < 5 then 7 else 14) }
    for k in 0..NK {
      if kt[k] > 0 { drawSpr(KSPR[kt[k]], floor(kx[k]), ky[k], 0) }
    }
    let fy: int = floor(gy)
    if state != 5 && (inv == 0 || t % 4 < 2) {
      drawSpr(if air then 1 else 0, 8, fy - 8, 0)
      let bs: int = if flipT > 0 then (if (flipT / 2) % 2 == 0 then 3 else 4) else 2
      drawSpr(bs, 7, fy, 0)
    }
    for i in 0..5 { put(1 + i * 2, 0, if i < boards then 8 else 6) }
    let prog: int = min(46, floor(dist / goal * 46.0))
    for i in 0..46 { put(1 + i, 1, if i < prog then 4 else 3) }
  } else if state == 2 {
    // sausages on strings falling onto the keys
    for i in nShown..NN {
      let dt = CHT[i] - stT
      if nh[i] == 0 && dt < 40 && dt > -6 {
        let y: int = 28 - floor(dt * 0.6) - 3
        drawSpr(10, LANES[CHL[i]] + 3, y, 0)
        for sy in 3..max(3, y) { put(LANES[CHL[i]] + 4, sy, 7) }
        rx.push(LANES[CHL[i]] + 4)
        ry.push(3)
        rw.push(1)
        rh.push(max(1, y - 3))
      }
    }
    for l in 0..4 {
      let lit = (l == 0 && kL) || (l == 1 && kU) || (l == 2 && kD) || (l == 3 && kR)
      for i in 0..8 { put(LANES[l] + i, 30, if lit then 4 else 7) }
    }
  } else if state == 6 {
    // the swing meter (yellow = sweet spot), Gord with the board, Freddy's legs
    for x in 8..40 { put(x, 4, if x >= zone && x < zone + 4 then 4 else 6) }
    for x in 8..40 { put(x, 5, if x == floor(legX) then 8 else 0) }
    drawSpr(12, 14, 22, 0)
    drawSpr(18, if swingT > 20 then 18 else 13, if swingT > 20 then 24 else 17, 0)
    drawSpr(if cracks > 0 then 16 else 15, 20, 21, if swingT > 26 then 1 else 0)
    if cracks > 0 { drawSpr(17, 23, 23, 0) }
    if swingT > 18 && cracks > 0 { drawSpr(19, 21 + t % 2, 26, 0) }
    for i in 0..3 { put(1 + i * 2, 0, if i < 3 - swings then 4 else 6) }
  } else {
    drawSpr(11, 27, 20, 0)
    drawSpr(12, 10, 24, 0)
    if state == 4 && imp > 0 {
      for i in 0..3 { drawSpr(13, 20 + i * 6 + (t / 4 + i) % 2, 18 - (t + i * 7) % 12, 0) }
    }
  }
  for r in 0..H {
    if dirty[r] > 0 {
      encRow(r)
      dirty[r] = 0
      sdirty[r / 4] = 1
    }
  }
  if sdirty[0] > 0 {
    st0 = rows[0] .. "\n" .. rows[1] .. "\n" .. rows[2] .. "\n" .. rows[3]
    sdirty[0] = 0
  }
  if sdirty[1] > 0 {
    st1 = rows[4] .. "\n" .. rows[5] .. "\n" .. rows[6] .. "\n" .. rows[7]
    sdirty[1] = 0
  }
  if sdirty[2] > 0 {
    st2 = rows[8] .. "\n" .. rows[9] .. "\n" .. rows[10] .. "\n" .. rows[11]
    sdirty[2] = 0
  }
  if sdirty[3] > 0 {
    st3 = rows[12] .. "\n" .. rows[13] .. "\n" .. rows[14] .. "\n" .. rows[15]
    sdirty[3] = 0
  }
  if sdirty[4] > 0 {
    st4 = rows[16] .. "\n" .. rows[17] .. "\n" .. rows[18] .. "\n" .. rows[19]
    sdirty[4] = 0
  }
  if sdirty[5] > 0 {
    st5 = rows[20] .. "\n" .. rows[21] .. "\n" .. rows[22] .. "\n" .. rows[23]
    sdirty[5] = 0
  }
  if sdirty[6] > 0 {
    st6 = rows[24] .. "\n" .. rows[25] .. "\n" .. rows[26] .. "\n" .. rows[27]
    sdirty[6] = 0
  }
  if sdirty[7] > 0 {
    st7 = rows[28] .. "\n" .. rows[29] .. "\n" .. rows[30] .. "\n" .. rows[31]
    sdirty[7] = 0
  }
  if sdirty[8] > 0 {
    st8 = rows[32] .. "\n" .. rows[33] .. "\n" .. rows[34] .. "\n" .. rows[35]
    sdirty[8] = 0
  }
}

// ---------- stage 3: the pitch
mod startPitch() {
  state = 3
  stT = 0
  setScene(3)
  pq = 0
  imp = 0
  playSong(2)
  say("Hollywood. The big pitch. A or D to answer.", 60)
}
mod verdict() {
  let total = score + sausages * 20 + imp * 100
  let need = 900 + day * 300
  state = 4
  stT = 0
  if total >= need {
    imp = 1
    score = total
    if score > hi { hi = score }
    playSong(3)
    sfx(8)
    say("Exec: 'Here's a MILLION DOLLARS.' SPACE = sequel", 100000)
  } else {
    imp = 0
    if score > hi { hi = score }
    playSong(4)
    say("Exec: 'Get out of my office.' (" .. total .. "/" .. need .. ") SPACE", 100000)
  }
}

mod pitchTick() {
  if stT > 20 {
    msg = PQ[pq]
    msgT = 0
    var a: int = 0
    if kL && !pL { a = 1 }
    if kR && !pR { a = 2 }
    if a > 0 {
      imp += if a == 1 then PAS[pq] else PDS[pq]
      sfx(7)
      pq += 1
      stT = 0
      if pq >= 3 { verdict() }
    }
  }
}
// ---------- stage 3: brotherly love (Freddy wants a turn on the board)
mod startLeg() {
  state = 6
  stT = 0
  setScene(4)
  swings = 0
  cracks = 0
  legX = 8.0
  legV = 0.7 + day * 0.15
  zone = Random(12, 34)
  swingT = 0
  playSong(2)
  say("Freddy wants a turn on the board. Gord says no. With the board. E when it's yellow!", 100000)
}
mod legTick() {
  if swingT > 0 {
    swingT -= 1
    if swingT == 0 {
      if swings >= 3 { startPitch() } else { zone = Random(12, 34) }
    }
  } else {
    legX = legX + legV
    if legX > 39.0 || legX < 8.0 { legV = 0.0 - legV }
    if kS && !pS {
      swings += 1
      swingT = 30
      let cx: int = floor(legX)
      if cx >= zone && cx < zone + 4 {
        cracks += 1
        score += 300
        sfx(3)
        say(if cracks == 1 then "*CRACK* Freddy: 'MY LEG!!' (+300)" else (if cracks == 2 then "*CRACK* The other one. Symmetry. (+300)" else "*CRACK* Freddy has run out of legs. (+300)"), 30)
      } else {
        sfx(6)
        say("Whiff. Freddy: 'Ha! Missed!'", 30)
      }
    }
  }
}
// ---------- stage 2: the sausage serenade
mod startSerenade() {
  state = 2
  stT = 0
  setScene(2)
  for i in 0..NN { nh[i] = 0 }
  ni = 0
  nShown = 0
  hits = 0
  combo = 0
  playSong(1)
  say("Back home. Dad needs cheering up. Sausages on strings. A W S D!", 100000)
}
mod serenadeTick() {
  var press: int = -1
  if kL && !pL { press = 0 }
  if kU && !pU { press = 1 }
  if kD && !pD { press = 2 }
  if kR && !pR { press = 3 }
  if press >= 0 {
    var got: int = -1
    for i in nShown..NN {
      if got < 0 && nh[i] == 0 && CHL[i] == press && abs(CHT[i] - stT) <= 4 { got = i }
    }
    if got >= 0 {
      nh[got] = 1
      hits += 1
      combo += 1
      score += 20 * min(combo, 8)
      sfx(9 + press)
      if combo % 6 == 0 { say("Gord: 'DADDY, WOULD YOU LIKE SOME SAUSAGE?'", 40) }
    } else {
      combo = 0
      sfx(6)
    }
  }
  // notes that went past
  for i in nShown..NN {
    if nh[i] == 0 && stT - CHT[i] > 4 {
      nh[i] = 2
      combo = 0
      if msgT == 0 { say("Dad: 'What are you DOING?!'", 25) }
    }
  }
  for i in 0..NN {
    if nShown < NN && nh[nShown] > 0 { nShown += 1 }
  }
  if nShown >= NN && stT > CHT[NN - 1] + 20 { startLeg() }
}

// ---------- stage 1: skate to Hollywood
mod startSkate() {
  state = 1
  stT = 0
  setScene(1)
  for k in 0..NK { kt[k] = 0 }
  gy = 29.0
  vy = 0.0
  air = false
  flipT = 0
  inv = 0
  dist = 0.0
  spd = 0.55 + day * 0.05
  spawnT = 20.0
  playSong(0)
  say("Day " .. day .. ". Gord skates to Hollywood. Space jump, E kickflip.", 80)
}
mod spawnThing(kind: int, y: int) {
  let k = kt.find(0)
  if k >= 0 {
    kt[k] = kind
    kx[k] = 48.0
    ky[k] = y
  }
}
mod crash() {
  if inv == 0 {
    boards -= 1
    inv = 40
    flipT = 0
    sfx(3)
    if boards <= 0 {
      state = 5
      stT = 0
      if score > hi { hi = score }
      playSong(4)
      say("Gord ate the pavement. Dad: 'GET A JOB!' SPACE retry", 100000)
    } else { say("Gord eats pavement. " .. boards .. " boards left.", 40) }
  }
}
mod skateTick() {
  if (kJ && !pJ) || (kU && !pU) {
    if !air {
      vy = -1.05
      air = true
      sfx(0)
    }
  }
  if kS && !pS && air && flipT == 0 {
    flipT = 10
    sfx(1)
  }
  if flipT > 0 { flipT -= 1 }
  if air {
    vy = vy + 0.075
    gy = gy + vy
    if gy >= 29.0 {
      gy = 29.0
      vy = 0.0
      air = false
      if flipT > 0 {
        flipT = 0
        sfx(2)
        say("Sketchy landing. No points, but Gord lives.", 25)
      } else {
        sfx(2)
        if flips > 0 {
          score += 50 * flips
          say("KICKFLIP x" .. flips .. "! +" .. 50 * flips, 30)
        }
      }
      flips = 0
    }
    if flipT == 9 { flips += 1 }
  }
  if inv > 0 { inv -= 1 }
  dist = dist + spd
  dash = (dash + 1) % 10
  spawnT = spawnT - spd
  if spawnT <= 0.0 {
    let r = Random(0, 9)
    if r < 3 { spawnThing(1, 26) }
    else if r < 5 { spawnThing(2, 26) }
    else if r < 7 { spawnThing(3, 27) }
    else if r < 8 && dist > 200.0 {
      spawnThing(4, 22)
      sfx(5)
      say("DAD: 'GOOORD!!'", 30)
    }
    else {
      spawnThing(5, Random(20, 25))
      spawnThing(5, Random(18, 25))
    }
    spawnT = Random(18.0, 34.0) - day * 2.0
  }
  for k in 0..NK {
    let kind = kt[k]
    if kind > 0 {
      kx[k] = kx[k] - spd - (if kind == 4 then 0.35 else 0.0)
      if kx[k] < -6.0 { kt[k] = 0 }
      else if overlap(8.0, gy - 8.0, 3.0, 9.0, kx[k], ky[k], KW[kind], KH[kind]) {
        if kind == 5 {
          kt[k] = 0
          sausages += 1
          score += 10
          sfx(4)
        } else { crash() }
      }
    }
  }
  if dist >= goal && state == 1 { startSerenade() }
}

// ---------- power
mod powerOn() {
  booted = true
  state = 0
  stT = 0
  setScene(1)
  for k in 0..NK { kt[k] = 0 }
  gy = 29.0
  air = false
  flipT = 0
  inv = 0
  boards = 5
  dist = 0.0
  playSong(0)
  say("SPACE start. A parody. Licensed by absolutely no one.", 100000)
}
mod powerOff() {
  booted = false
  state = -1
  song = -1
  fxId = -1
  aV0 = 0.0
  aV1 = 0.0
  aV2 = 0.0
  msg = ""
  hud = ""
  st0 = ""
  st1 = ""
  st2 = ""
  st3 = ""
  st4 = ""
  st5 = ""
  st6 = ""
  st7 = ""
  st8 = ""
}

on tick {
  let pwr = seated
  if !pwr {
    if booted { powerOff() }
  } else {
    if !booted { powerOn() }
    kL = left
    kR = right
    kU = up
    kD = down
    kJ = jump
    kS = trick
    t += 1
    stT += 1
    if state == 0 {
      dash = (dash + 1) % 10
      if (kJ && !pJ) || (kS && !pS) {
        day = 1
        score = 0
        sausages = 0
        boards = 5
        startSkate()
        pJ = true
        pS = true
      }
    } else if state == 1 {
      skateTick()
    } else if state == 2 {
      serenadeTick()
    } else if state == 6 {
      legTick()
    } else if state == 3 {
      pitchTick()
    } else if state == 4 {
      if stT > 30 && kJ && !pJ {
        if imp > 0 { day += 1 } else {
          day = 1
          score = 0
          sausages = 0
          boards = 5
        }
        startSkate()
        pJ = true
      }
    } else if state == 5 {
      if stT > 30 && kJ && !pJ {
        day = 1
        score = 0
        sausages = 0
        boards = 5
        startSkate()
        pJ = true
      }
    }
    if msgT > 0 {
      msgT -= 1
      if msgT == 0 { msg = "" }
    }
    hud = if state == 0 then ("THE OFFICIAL GAME (not official). HI " .. hi)
      else (if state == 3 then ("A: " .. PA[min(pq, 2)] .. "    D: " .. PD[min(pq, 2)])
      else ("SCORE " .. score .. "  SAUSAGES " .. sausages .. "  DAY " .. day .. (if state == 2 then ("  COMBO " .. combo) else (if state == 6 then ("  SWINGS " .. (3 - swings) .. "  LEGS BROKEN " .. cracks) else ""))))
    audio()
    render()
    pL = kL
    pR = kR
    pU = kU
    pD = kD
    pJ = kJ
    pS = kS
  }
}
