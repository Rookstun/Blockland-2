var state: int = -1         // -1 off, 0 title, 1 playing, 2 grounded (game over)
var ph: int = 0             // 0 sneak, 1 Tyler stunned, 2 Tyler runs to Mom, 3 Mom listens, 4 Mom to your room,
                            // 5 inspects it, 6 Mom to his room, 7 inspects it, 8 verdict, 9 he's grounded (next level)
var phT: int = 0
var lvl: int = 1
var score: int = 0
var hi: int = 0
var t: int = 0
var px: float = 8.0
var py: float = 8.0
var pf: int = 1
var walking: bool = false
var hold: int = -1
var itx: float[] = [16.0, 32.0, 28.0]
var ity: float[] = [4.0, 22.0, 22.0]
var inbox: bool = false
var cracked: bool = false
var scribbled: bool = false
var cryN: int = 0
var crying: bool = false
var cried: bool = false
var sus: int = 0
var susCd: int = 0
var blame: int = 0
var bx: float = 10.0
var by: float = 24.0
var bi: int = 0
var blT: int = 0
var blWarned: bool = false
var mx: float = 40.0
var my: float = 24.0
var mf: int = 0
var mi: int = 0
var mlT: int = 0
var dx: float = 40.0
var dd: float = -1.0
var kL: bool = false
var kR: bool = false
var kU: bool = false
var kD: bool = false
var kJ: bool = false
var kS: bool = false
var pJ: bool = false
var pS: bool = false
var rx: int[] = []
var ry: int[] = []
var rw: int[] = []
var rh: int[] = []
var hx: float = 0.0
var hy: float = 0.0
var hhx: bool = false
var hhy: bool = false

var song: int = -1
var mi0: int = 0
var md0: int = 0
var mt0: int = 0
var mp0: float = 0.0
var mi1: int = 0
var md1: int = 0
var mp1: float = 0.0
var fxId: int = -1
var fxI: int = 0
var aP0: float = 1.0
var aV0: float = 0.0
var aP1: float = 1.0
var aV1: float = 0.0
var aP2: float = 1.0
var aV2: float = 0.0

@right out strip0: string = st0
@right out strip1: string = st1
@right out strip2: string = st2
@right out strip3: string = st3
@right out strip4: string = st4
@right out strip5: string = st5
@right out strip6: string = st6
@right out strip7: string = st7
@right out strip8: string = st8
@right out msg_: string = msg
@right out hud_: string = hud
@right out title_: string = if state == 0 then "IT WASN'T ME" else ""
@right out P0: float = aP0
@right out V0: float = aV0
@right out P1: float = aP1
@right out V1: float = aV1
@right out P2: float = aP2
@right out V2: float = aV2
@right out state_: int = state

// ---------- helpers
mod say(s: string, n: int) {
  msg = s
  msgT = n
}
mod queue(s: string) {
  if qn < NQ {
    qs[qn] = s
    qn += 1
  }
}
mod playSong(s: int) {
  song = s
  mi0 = 0
  md0 = 0
  mi1 = 0
  md1 = 0
  mp0 = 0.0
  mp1 = 0.0
}
mod sfx(k: int) {
  fxId = k
  fxI = 0
}
mod solid(cx: int, cy: int) -> int {
  if cx < 0 || cx >= W || cy < 0 || cy >= H { return 1 }
  return SOLID[cur[floor(cy / 2.0) * 24 + floor(cx / 2.0)]]
}
mod roomAt(x: float, y: float) -> int {
  let cx: int = floor(x)
  let cy: int = floor(y)
  if cx < 0 || cx >= W || cy < 0 || cy >= H { return 0 }
  return ROOM[floor(cy / 2.0) * 24 + floor(cx / 2.0)]
}
mod dist(ax: float, ay: float, bx0: float, by0: float) -> float {
  return sqrt((ax - bx0) * (ax - bx0) + (ay - by0) * (ay - by0))
}
// move a 3 x 4 box against solid tiles: result in hx, hy
mod moveBox(x: float, y: float, ddx: float, ddy: float) {
  var nx: float = x + ddx
  if ddx > 0.0 {
    let e: int = floor(nx + 2.99)
    if solid(e, floor(y + 2.0)) + solid(e, floor(y + 3.99)) > 0 { nx = e - 3 }
  } else if ddx < 0.0 {
    let e: int = floor(nx)
    if solid(e, floor(y + 2.0)) + solid(e, floor(y + 3.99)) > 0 { nx = e + 1 }
  }
  var ny: float = y + ddy
  if ddy > 0.0 {
    let e: int = floor(ny + 3.99)
    if solid(floor(nx), e) + solid(floor(nx + 2.99), e) > 0 { ny = e - 4 }
  } else if ddy < 0.0 {
    let e: int = floor(ny + 2.0)
    if solid(floor(nx), e) + solid(floor(nx + 2.99), e) > 0 { ny = e - 1 }
  }
  hx = nx
  hy = ny
}
// does someone at (ox, oy) facing f (0 up 1 down 2 left 3 right) see you? same room and in front, or up close
mod sees(ox: float, oy: float, f: int) -> bool {
  let cx = px + 1.5
  let cy = py + 2.0
  let ocx = ox + 1.5
  let ocy = oy + 2.0
  if dist(cx, cy, ocx, ocy) < 5.0 { return true }
  let r = roomAt(cx, cy)
  if r == 0 || r != roomAt(ocx, ocy) { return false }
  if f == 0 { return cy < ocy }
  if f == 1 { return cy > ocy }
  if f == 2 { return cx < ocx }
  return cx > ocx
}
mod momSees() -> bool {
  return sees(mx, my, mf)
}
mod dadSees() -> bool {
  return lvl >= 2 && sees(dx, 16.0, if dd < 0.0 then 2 else 3)
}
mod blPeriod() -> int {
  return max(70, 170 - lvl * 20)
}
mod itemRoom(i: int) -> int {
  if hold == i { return roomAt(px + 1.5, py + 2.0) }
  return roomAt(itx[i] + 1.0, ity[i] + 1.0)
}

// ---------- sound
mod audio() {
  if song >= 0 {
    md0 -= 1
    if md0 <= 0 {
      if mi0 >= VL0[song] && SLOOP[song] > 0 { mi0 = 0 }
      if mi0 < VL0[song] {
        let n = VO0[song] + mi0
        mp0 = NP0[n]
        md0 = ND0[n]
        mt0 = 0
        mi0 += 1
      } else {
        mp0 = 0.0
        md0 = 100000
      }
    }
    md1 -= 1
    if md1 <= 0 {
      if mi1 >= VL1[song] && SLOOP[song] > 0 { mi1 = 0 }
      if mi1 < VL1[song] {
        let n = VO1[song] + mi1
        mp1 = NP1[n]
        md1 = ND1[n]
        mi1 += 1
      } else {
        mp1 = 0.0
        md1 = 100000
      }
    }
    mt0 += 1
  }
  if mp0 > 0.0 {
    aP0 = mp0
    aV0 = if md0 <= 1 then 0.0 else 0.3 * max(0.4, 1.0 - mt0 * 0.08)
  } else { aV0 = 0.0 }
  if mp1 > 0.0 {
    aP1 = mp1
    aV1 = if md1 <= 1 then 0.0 else 0.6
  } else { aV1 = 0.0 }
  if fxId >= 0 {
    if fxI < FXL[fxId] {
      aP2 = FXP[FXO[fxId] + fxI]
      aV2 = 0.5
      fxI += 1
    } else {
      fxId = -1
      aV2 = 0.0
    }
  } else { aV2 = 0.0 }
}

// ---------- drawing
mod tileCells(ti: int) {
  let tx = ti % 24
  let ty = floor(ti / 24.0)
  for j in 0..4 {
    let cx = tx * 2 + j % 2
    let cy = ty * 2 + j / 2
    let i = cy * W + cx
    let c = TILEPIX[cur[ti] * 4 + j]
    bg[i] = c
    if fb[i] != c {
      fb[i] = c
      dirty[cy] = 1
    }
  }
}
mod eraseRect(x: int, y: int, w: int, h: int) {
  for j in 0..w * h {
    let cx = x + j % w
    let cy = y + j / w
    if cx >= 0 && cx < W && cy >= 0 && cy < H {
      let i = cy * W + cx
      if fb[i] != bg[i] {
        fb[i] = bg[i]
        dirty[cy] = 1
      }
    }
  }
}
mod put(cx: int, cy: int, c: int) {
  if cx >= 0 && cx < W && cy >= 0 && cy < H {
    let i = cy * W + cx
    if fb[i] != c {
      fb[i] = c
      dirty[cy] = 1
    }
  }
}
mod drawSpr(s: int, x: int, y: int) {
  let w = SW[s]
  let o = SOFF[s]
  for j in 0..w * SH[s] {
    let c = SPR[o + j]
    if c >= 0 { put(x + j % w, y + j / w, c) }
  }
  rx.push(x)
  ry.push(y)
  rw.push(w)
  rh.push(SH[s])
}
mod encRow(r: int) {
  var s: string = ""
  var c0: int = -1
  var n: int = 0
  for c in 0..W {
    let p = fb[r * W + c]
    if p == c0 {
      n += 1
    } else {
      if n > 0 { s = s .. OPEN[c0] .. BLK[n] .. CLOSE[c0] }
      c0 = p
      n = 1
    }
  }
  rows[r] = s .. OPEN[c0] .. BLK[n] .. CLOSE[c0]
}
mod itemSpr(i: int) -> int {
  if i == 0 { return if cracked then 11 else 10 }
  if i == 1 { return 12 }
  return 13
}
mod render() {
  for i in 0..rx.length() { eraseRect(rx[i], ry[i], rw[i], rh[i]) }
  rx.clear()
  ry.clear()
  rw.clear()
  rh.clear()
  // items lying around
  for i in 0..3 {
    if hold != i { drawSpr(itemSpr(i), floor(itx[i]), floor(ity[i])) }
  }
  // Tyler: back to you at the TV, looking round, stunned, crying on his way to Mom
  let bl = ph == 0 && blT >= blPeriod() - 25
  var bs: int = if bl then 3 else 4
  if ph >= 1 { bs = 5 }
  drawSpr(bs, floor(bx), floor(by))
  if ph == 0 && blT >= blPeriod() - 40 && blT < blPeriod() - 25 { drawSpr(16, floor(bx) + 1, floor(by) - 5) }
  if ph == 1 { drawSpr(14, floor(bx) + (t / 3) % 2 - 1 + 1, floor(by) - 3) }
  if ph == 2 && t % 6 < 3 { drawSpr(17, floor(bx) + 3, floor(by) + 1) }
  // Mom (turns round at the stove: ! first), Dad in the hall
  drawSpr(if mf == 1 then 6 else 7, floor(mx), floor(my))
  if ph == 0 && mlT % 160 >= 105 && mlT % 160 < 120 { drawSpr(15, floor(mx) + 1, floor(my) - 5) }
  if lvl >= 2 { drawSpr(if t % 8 < 4 then 8 else 9, floor(dx), 16) }
  // you, with what you carry over your head
  let ys: int = if pf == 0 then 1 else (if walking && (t / 3) % 2 > 0 then 2 else 0)
  drawSpr(ys, floor(px), floor(py))
  if hold >= 0 { drawSpr(itemSpr(hold), floor(px) + (if hold == 0 then 0 else 1), floor(py) - 2) }
  if crying && t % 6 < 3 { drawSpr(17, floor(px) - 1, floor(py) + 1) }
  // HUD: suspicion pips, level pips
  for i in 0..6 { put(1 + i * 2, 1, if i < sus then 8 else 1) }
  for i in 0..5 { put(W - 10 + i * 2, 1, if i < lvl then 4 else 1) }
  for r in 0..H {
    if dirty[r] > 0 {
      encRow(r)
      dirty[r] = 0
      sdirty[r / 4] = 1
    }
  }
  if sdirty[0] > 0 {
    st0 = rows[0] .. "\n" .. rows[1] .. "\n" .. rows[2] .. "\n" .. rows[3]
    sdirty[0] = 0
  }
  if sdirty[1] > 0 {
    st1 = rows[4] .. "\n" .. rows[5] .. "\n" .. rows[6] .. "\n" .. rows[7]
    sdirty[1] = 0
  }
  if sdirty[2] > 0 {
    st2 = rows[8] .. "\n" .. rows[9] .. "\n" .. rows[10] .. "\n" .. rows[11]
    sdirty[2] = 0
  }
  if sdirty[3] > 0 {
    st3 = rows[12] .. "\n" .. rows[13] .. "\n" .. rows[14] .. "\n" .. rows[15]
    sdirty[3] = 0
  }
  if sdirty[4] > 0 {
    st4 = rows[16] .. "\n" .. rows[17] .. "\n" .. rows[18] .. "\n" .. rows[19]
    sdirty[4] = 0
  }
  if sdirty[5] > 0 {
    st5 = rows[20] .. "\n" .. rows[21] .. "\n" .. rows[22] .. "\n" .. rows[23]
    sdirty[5] = 0
  }
  if sdirty[6] > 0 {
    st6 = rows[24] .. "\n" .. rows[25] .. "\n" .. rows[26] .. "\n" .. rows[27]
    sdirty[6] = 0
  }
  if sdirty[7] > 0 {
    st7 = rows[28] .. "\n" .. rows[29] .. "\n" .. rows[30] .. "\n" .. rows[31]
    sdirty[7] = 0
  }
  if sdirty[8] > 0 {
    st8 = rows[32] .. "\n" .. rows[33] .. "\n" .. rows[34] .. "\n" .. rows[35]
    sdirty[8] = 0
  }
}

// ---------- game
mod resetHouse() {
  cur.copyFrom(HOUSE)
  bg.copyFrom(HOUSEPIX)
  fb.copyFrom(HOUSEPIX)
  for i in 0..H { dirty[i] = 1 }
  rx.clear()
  ry.clear()
  rw.clear()
  rh.clear()
}
mod startLevel() {
  state = 1
  ph = 0
  phT = 0
  resetHouse()
  px = 8.0
  py = 8.0
  pf = 1
  hold = -1
  itx.copyFrom(ITX0)
  ity.copyFrom(ITY0)
  inbox = false
  cracked = false
  scribbled = false
  cryN = 0
  crying = false
  cried = false
  sus = 0
  susCd = 0
  blame = 0
  bx = 10.0
  by = 24.0
  bi = 0
  blT = 0
  mx = 40.0
  my = 24.0
  mf = 0
  mi = 0
  mlT = 0
  dx = 40.0
  dd = -1.0
  qn = 0
  qi = 0
  qT = 0
  playSong(0)
  say(if lvl == 1 then "Tyler took the TV. AGAIN. Get your portal." else ("Day " .. lvl .. ". Tyler is on the TV again." .. (if lvl == 2 then " Dad's home." else "")), 90)
}
mod caught(why: string) {
  state = 2
  phT = 0
  if score > hi { hi = score }
  playSong(2)
  sfx(5)
  say(why, 100000)
}
mod addSus(who: string) {
  if susCd == 0 {
    sus += 1
    susCd = 70
    sfx(5)
    say(who, 50)
  }
}
mod swingIt() {
  let cx = px + 1.5
  let cy = py + 2.0
  if hold == 0 && ph == 0 && dist(cx, cy, bx + 1.5, by + 2.0) < 6.0 {
    sfx(7)
    if blT >= blPeriod() - 25 || cy < by + 1.0 {
      caught("Tyler saw it coming. 'MOOOOM!' You are SO grounded.")
    } else if momSees() {
      caught("Mom saw the whole thing. Grounded. Forever.")
    } else if dadSees() {
      caught("Dad saw. Dad is not mad, just disappointed. Grounded.")
    } else {
      cracked = true
      ph = 1
      phT = 0
      sfx(0)
      playSong(1)
      say("*BONK*  Tyler: 'WAAAAAAAAAH!!'  Now frame him. Fast.", 70)
    }
  } else if hold == 1 && !scribbled && cy < 8.0 && cx > 24.0 && cx < 34.0 {
    scribbled = true
    for i in 0..3 {
      cur[24 + 13 + i] = 3
      tileCells(24 + 13 + i)
    }
    sfx(4)
    say("You draw a stick man on his wall. Labeled TYLER.", 60)
  } else if hold >= 0 {
    sfx(7)
    say("You swing " .. ITNAME[hold] .. " at nothing.", 30)
  } else {
    say("You flail. It's not very effective.", 30)
  }
}
mod grabIt() {
  let cx = px + 1.5
  let cy = py + 2.0
  if hold >= 0 {
    let i = hold
    hold = -1
    itx[i] = px
    ity[i] = py + 2.0
    if i == 0 && dist(cx, cy, 42.0, 13.0) < 7.0 {
      itx[i] = 41.0
      ity[i] = 11.0
      inbox = true
      say("You bury the " .. (if cracked then "cracked " else "") .. "portal in HIS toy box.", 50)
    } else { say("You put down " .. ITNAME[i] .. ".", 30) }
    sfx(3)
  } else {
    var best: int = -1
    var bd: float = 5.0
    for i in 0..3 {
      let d = dist(cx, cy, itx[i] + 1.0, ity[i] + 1.0)
      if d < bd {
        bd = d
        best = i
      }
    }
    if best >= 0 {
      hold = best
      if best == 0 { inbox = false }
      sfx(2)
      say("You grab " .. ITNAME[best] .. ".", 30)
    }
  }
}
mod inspectYours() {
  sfx(6)
  queue("Mom checks YOUR room first...")
  if crying {
    cried = true
    blame += 1
    queue("Mom: 'Oh sweetie, why are you crying?' (+1)")
  }
  if itemRoom(0) == 1 {
    sus += 2
    queue("Mom: 'Why is the cracked portal in YOUR room?' (+2 sus)")
  }
  if itemRoom(1) == 1 && scribbled {
    sus += 1
    queue("Mom: 'Your marker. Hm.' (+1 sus)")
  }
  if itemRoom(2) == 1 {
    sus += 1
    queue("Mom: 'And the cookie jar is in here because...?' (+1 sus)")
  }
  if hold >= 0 {
    sus += 1
    queue("Mom: 'Put that down. Now.' (+1 sus)")
  }
  if qn == 1 { queue("Mom: 'Hm. Clean.'") }
}
mod inspectHis() {
  sfx(6)
  let n0 = qn
  queue("Then Mom checks Tyler's room...")
  if itemRoom(0) == 2 {
    blame += if inbox then 2 else 1
    queue(if inbox then "Mom: 'The portal. In HIS toy box. Cracked.' (+2)" else "Mom: 'Is that the portal on his floor?' (+1)")
  }
  if scribbled {
    blame += 1
    queue("Mom: 'He drew on his WALL?! A stick man?!' (+1)")
  }
  if itemRoom(1) == 2 {
    blame += 1
    queue("Mom: 'With YOUR marker, Tyler?!' (+1)")
  }
  if itemRoom(2) == 2 {
    blame += 1
    queue("Mom: 'AND the cookie jar. Unbelievable.' (+1)")
  }
  if qn == n0 + 1 { queue("Mom: 'Nothing in here. Interesting.'") }
}
mod verdict() {
  let need = 1 + lvl
  let net = blame - sus
  queue("Evidence " .. blame .. " - suspicion " .. sus .. " = " .. net .. " (need " .. need .. ")")
  if net >= need {
    queue("Mom: 'TYLER. Room. Now. No TV for a week.'")
  } else {
    queue("Mom: 'Nice try. YOU are grounded.'")
  }
}
mod playerTick() {
  let mvx: int = kR - kL
  let mvy: int = kD - kU
  walking = mvx != 0 || mvy != 0
  if mvy < 0 { pf = 0 } else if mvy > 0 || mvx != 0 { pf = 1 }
  moveBox(px, py, mvx * 0.4, mvy * 0.4)
  px = hx
  py = hy
  if kS && !pS { swingIt() }
  if kJ && !pJ { grabIt() }
  // fake tears: hold grab, empty-handed, at your bed
  let atBed = hold < 0 && kJ && dist(px + 1.5, py + 2.0, 4.0, 6.0) < 7.0
  if atBed { cryN += 1 } else { cryN = 0 }
  let was = crying
  crying = cryN > 10
  if crying && !was {
    sfx(8)
    say("You summon real tears. Method acting.", 40)
  }
}
mod npcTick() {
  // Tyler looks round now and then while you sneak up
  if ph == 0 {
    blT += 1
    if blT >= blPeriod() {
      blT = 0
      blWarned = false
    }
    if blT >= blPeriod() - 25 && hold == 0 && !blWarned && dist(px, py, bx, by) < 12.0 {
      blWarned = true
      sus += 1
      sfx(5)
      say("Tyler: 'Why are you holding the portal like that?' (+1 sus)", 60)
    }
  } else if ph == 1 {
    if phT > 50 {
      ph = 2
      phT = 0
      sfx(1)
      say("Tyler runs to Mom, crying. Mom will want answers.", 60)
    }
  } else if ph == 2 {
    let gx = BX[bi]
    let gy = BY[bi]
    let d = dist(bx, by, gx, gy)
    if d < 0.2 {
      if bi < 1 { bi += 1 } else {
        ph = 3
        phT = 0
        mf = 2
        say("Mom: 'WHAT?! Who did this?!' (she is coming)", 60)
      }
    } else {
      bx = bx + (gx - bx) / d * min(d, 0.14)
      by = by + (gy - by) / d * min(d, 0.14)
    }
  }
  // Mom: at the stove she turns round every 8 s; then the investigation walk
  if ph <= 2 {
    mlT += 1
    mf = if mlT % 160 >= 120 then 1 else 0
  } else if ph == 3 {
    if phT > 50 {
      ph = 4
      phT = 0
    }
  } else if ph == 4 || ph == 6 {
    let gx = MX[mi]
    let gy = MY[mi]
    let d = dist(mx, my, gx, gy)
    let sp = 0.22 + lvl * 0.03
    if d < 0.2 {
      if mi == 4 {
        ph = 5
        phT = 0
        mf = 1
        inspectYours()
      } else if mi == 7 {
        ph = 7
        phT = 0
        mf = 0
        inspectHis()
      } else { mi += 1 }
    } else {
      let ddx = gx - mx
      let ddy = gy - my
      mf = if abs(ddx) > abs(ddy) then (if ddx < 0.0 then 2 else 3) else (if ddy < 0.0 then 0 else 1)
      mx = mx + ddx / d * min(d, sp)
      my = my + ddy / d * min(d, sp)
    }
  } else if ph == 5 {
    if crying && !cried {
      cried = true
      blame += 1
      queue("Mom: 'Oh sweetie, why are you crying?' (+1)")
    }
    if phT > 90 {
      ph = 6
      phT = 0
      mi = 5
    }
  } else if ph == 7 {
    if phT > 90 {
      ph = 8
      phT = 0
      verdict()
    }
  }
  // Dad paces the hall
  if lvl >= 2 {
    dx = dx + dd * (0.12 + lvl * 0.02)
    if dx < 3.0 { dd = 1.0 }
    if dx > 42.0 { dd = -1.0 }
  }
  // after the bonk, getting seen carrying evidence or lurking in his room costs you
  if ph >= 1 && ph <= 7 {
    if susCd > 0 { susCd -= 1 }
    let inHis = roomAt(px + 1.5, py + 2.0) == 2
    if hold >= 0 || inHis {
      if momSees() {
        addSus(if hold >= 0 then ("Mom: 'Why do you have " .. ITNAME[hold] .. "?' (+1 sus)") else "Mom: 'What are you doing in Tyler's room?' (+1 sus)")
      } else if dadSees() {
        addSus(if hold >= 0 then ("Dad: 'Put " .. ITNAME[hold] .. " back, bud.' (+1 sus)") else "Dad: 'That's not your room, champ.' (+1 sus)")
      }
    }
  }
}
mod finish() {
  // called once the verdict queue has been read out
  if blame - sus >= 1 + lvl {
    score += (blame - sus) * 100 + lvl * 50
    if score > hi { hi = score }
    ph = 9
    phT = 0
    playSong(3)
    say("TYLER IS GROUNDED. It wasn't you. SPACE = next day", 100000)
  } else {
    caught("You're grounded. No portal for a week. SPACE = retry")
  }
}

// ---------- power: the screen runs only while someone sits
mod powerOn() {
  booted = true
  state = 0
  lvl = 1
  resetHouse()
  bx = 10.0
  by = 24.0
  mx = 40.0
  my = 24.0
  mf = 0
  px = 8.0
  py = 8.0
  hold = -1
  itx.copyFrom(ITX0)
  ity.copyFrom(ITY0)
  cracked = false
  playSong(0)
  say("SPACE start. LMB/E swing, SPACE grab/drop/cry", 100000)
}
mod powerOff() {
  booted = false
  state = -1
  song = -1
  fxId = -1
  aV0 = 0.0
  aV1 = 0.0
  aV2 = 0.0
  msg = ""
  hud = ""
  st0 = ""
  st1 = ""
  st2 = ""
  st3 = ""
  st4 = ""
  st5 = ""
  st6 = ""
  st7 = ""
  st8 = ""
}

on tick {
  let pwr = seated
  if !pwr {
    if booted { powerOff() }
  } else {
    if !booted { powerOn() }
    kL = left
    kR = right
    kU = up
    kD = down
    kJ = grab
    kS = swing
    t += 1
    phT += 1
    if state == 0 {
      if (kJ && !pJ) || (kS && !pS) {
        lvl = 1
        score = 0
        startLevel()
        pJ = true
        pS = true
      }
    } else if state == 1 {
      if ph < 8 {
        playerTick()
        npcTick()
      } else if ph == 8 {
        if qi >= qn && qT == 0 { finish() }
      } else if ph == 9 {
        if phT > 30 && kJ && !pJ {
          lvl = min(lvl + 1, 5)
          startLevel()
          pJ = true
        }
      }
    } else if state == 2 {
      if phT > 40 && kJ && !pJ {
        lvl = 1
        score = 0
        startLevel()
        pJ = true
      }
    }
    // the investigation's lines, one every 2.5 s
    if qT > 0 { qT -= 1 }
    else if qi < qn {
      say(qs[qi], 50)
      qi += 1
      qT = 50
    }
    if msgT > 0 {
      msgT -= 1
      if msgT == 0 { msg = "" }
    }
    let phase = if ph == 0 then "BONK TYLER" else (if ph <= 3 then "FRAME HIM" else (if ph <= 7 then "MOM IS COMING" else "VERDICT"))
    hud = if state == 0 then ("a game about family. HI " .. hi) else ("DAY " .. lvl .. "  SUS " .. sus .. "  SCORE " .. score .. "  " .. phase)
    audio()
    render()
    pJ = kJ
    pS = kS
  }
}
