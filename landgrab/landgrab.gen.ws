@right out V0: float = aV0
@right out P1: float = aP1
@right out V1: float = aV1
@right out state_: int = state

mod showHud() {
  hud = "R " .. sc[0] .. "  B " .. sc[1] .. "  G " .. sc[2] .. "  Y " .. sc[3] .. "   " .. floor(timer / 20) .. "s"
}

mod say(s: string, n: int) {
  msg = s
  msgT = n
}

mod recount() {
  for p in 0..4 { sc[p] = 0 }
  for i in 0..384 {
    let o = own[i]
    if o > 0 { sc[o - 1] = sc[o - 1] + 1 }
  }
  showHud()
}

mod respawn(p: int) {
  pxp[p] = SX[p]
  pyp[p] = SY[p]
  dr[p] = SD[p]
  tl[p] = 0
}

mod join(p: int) {
  act[p] = 1
  respawn(p)
  for j in 0..9 {
    let r = SY[p] - 1 + floor(j / 3)
    let c = SX[p] - 1 + j % 3
    own[r * 24 + c] = p + 1
    trl[r * 24 + c] = 0
  }
  recount()
}

mod clearTrail(p: int) {
  for i in 0..384 {
    if trl[i] == p + 1 { trl[i] = 0 }
  }
  tl[p] = 0
}

mod leave(p: int) {
  act[p] = 0
  for i in 0..384 {
    if own[i] == p + 1 { own[i] = 0 }
    if trl[i] == p + 1 { trl[i] = 0 }
  }
  tl[p] = 0
  recount()
}

mod die(p: int) {
  clearTrail(p)
  respawn(p)
  hitT = t
}

mod pushQ(i: int) {
  if seen[i] == 0 && own[i] != fillP + 1 {
    seen[i] = 1
    q[qt] = i
    qt += 1
  }
}

mod closeLoop(p: int) {
  if !fillOn {
    for i in 0..384 {
      if trl[i] == p + 1 {
        trl[i] = 0
        own[i] = p + 1
      }
    }
    tl[p] = 0
    fillP = p
    fillOn = true
    qh = 0
    qt = 0
    for i in 0..384 { seen[i] = 0 }
    for c in 0..24 {
      pushQ(c)
      pushQ(360 + c)
    }
    for r in 1..15 {
      pushQ(r * 24)
      pushQ(r * 24 + 23)
    }
    blipT = t
  }
}

mod fillStep() {
  for k in 0..64 {
    if qh < qt {
      let i = q[qh]
      qh += 1
      let r = floor(i / 24)
      let c = i % 24
      if c > 0 { pushQ(i - 1) }
      if c < 23 { pushQ(i + 1) }
      if r > 0 { pushQ(i - 24) }
      if r < 15 { pushQ(i + 24) }
    }
  }
  if qh >= qt {
    for i in 0..384 {
      if seen[i] == 0 && own[i] != fillP + 1 {
        own[i] = fillP + 1
        trl[i] = 0
      }
    }
    fillOn = false
    fillP = -1
    recount()
  }
}

mod stepPlayer(p: int) {
  var d = dr[p]
  if key[p * 4 + 2] { d = 3 }
  else if key[p * 4 + 3] { d = 1 }
  else if key[p * 4] { d = 2 }
  else if key[p * 4 + 1] { d = 0 }
  if (d + 2) % 4 == dr[p] { d = dr[p] }
  dr[p] = d
  var nx = pxp[p]
  var ny = pyp[p]
  if d == 0 { nx += 1 }
  else if d == 1 { ny += 1 }
  else if d == 2 { nx -= 1 }
  else { ny -= 1 }
  if nx >= 0 && nx < 24 && ny >= 0 && ny < 16 {
    let i = ny * 24 + nx
    let tq = trl[i]
    if tq > 0 && tq != p + 1 { die(tq - 1) }
    pxp[p] = nx
    pyp[p] = ny
    if tq == p + 1 || (own[i] == p + 1 && tl[p] > 0) {
      closeLoop(p)
    } else if own[i] != p + 1 {
      trl[i] = p + 1
      tl[p] += 1
    }
  }
}

mod resetRound() {
  for i in 0..384 {
    own[i] = 0
    trl[i] = 0
  }
  fillOn = false
  fillP = -1
  timer = 2400
  state = 1
  stepT = 0
  for p in 0..4 {
    if act[p] == 1 { join(p) }
  }
  recount()
  say("GO", 30)
}

mod endRound() {
  state = 2
  stT = 0
  var best: int = 0
  for p in 1..4 {
    if sc[p] > sc[best] { best = p }
  }
  say(NAMES[best] .. " WINS " .. sc[best], 0)
}

mod stamp() {
  for p in 0..4 { heads[p] = 0 }
}

mod compose(r0: int, r1: int) {
  for ty in r0..r1 {
    var sT: string = ""
    var cT: int = -1
    var nT: int = 0
    var sB: string = ""
    var cB: int = -1
    var nB: int = 0
    for tx in 0..24 {
      let i = ty * 24 + tx
      var k: int = own[i]
      if trl[i] > 0 { k = 4 + trl[i] }
      for p in 0..4 {
        if act[p] == 1 && pxp[p] == tx && pyp[p] == ty { k = 9 + p }
      }
      let o = k * 4
      let a = LOOK[o]
      let b = LOOK[o + 1]
      let c = LOOK[o + 2]
      let d = LOOK[o + 3]
      if a == cT { nT += 1 } else {
        if nT > 0 { sT = sT .. OPEN[cT] .. BLK[nT] .. CLOSE[cT] }
        cT = a
        nT = 1
      }
      if b == cT { nT += 1 } else {
        if nT > 0 { sT = sT .. OPEN[cT] .. BLK[nT] .. CLOSE[cT] }
        cT = b
        nT = 1
      }
      if c == cB { nB += 1 } else {
        if nB > 0 { sB = sB .. OPEN[cB] .. BLK[nB] .. CLOSE[cB] }
        cB = c
        nB = 1
      }
      if d == cB { nB += 1 } else {
        if nB > 0 { sB = sB .. OPEN[cB] .. BLK[nB] .. CLOSE[cB] }
        cB = d
        nB = 1
      }
    }
    rows[ty * 2] = sT .. OPEN[cT] .. BLK[nT] .. CLOSE[cT]
    rows[ty * 2 + 1] = sB .. OPEN[cB] .. BLK[nB] .. CLOSE[cB]
  }
}

mod powerOn() {
  booted = true
  for p in 0..4 { act[p] = 0 }
  resetRound()
  say("DROP IN: SIT IN ANY SEAT", 60)
}

mod powerOff() {
  booted = false
  state = 0
  msg = ""
  hud = ""
  st0 = ""
  st1 = ""
  st2 = ""
  st3 = ""
  st4 = ""
  st5 = ""
  st6 = ""
  st7 = ""
  aV0 = 0.0
  aV1 = 0.0
}

on tick {
  let s0 = seat0
  let s1 = seat1
  let s2 = seat2
  let s3 = seat3
  let any = s0 || s1 || s2 || s3
  if !any {
    if booted { powerOff() }
  } else {
    if !booted { powerOn() }
    sit[0] = s0
    sit[1] = s1
    sit[2] = s2
    sit[3] = s3
    key[0] = key[0] || l0
    key[1] = key[1] || r0
    key[2] = key[2] || u0
    key[3] = key[3] || d0
    key[4] = key[4] || l1
    key[5] = key[5] || r1
    key[6] = key[6] || u1
    key[7] = key[7] || d1
    key[8] = key[8] || l2
    key[9] = key[9] || r2
    key[10] = key[10] || u2
    key[11] = key[11] || d2
    key[12] = key[12] || l3
    key[13] = key[13] || r3
    key[14] = key[14] || u3
    key[15] = key[15] || d3

    t += 1
    for p in 0..4 {
      if sit[p] && act[p] == 0 { join(p) }
      if !sit[p] && act[p] == 1 { leave(p) }
    }
    if state == 1 {
      stepT += 1
      if stepT >= 4 {
        stepT = 0
        for p in 0..4 {
          if act[p] == 1 { stepPlayer(p) }
        }
        for k in 0..16 { key[k] = false }
      }
      if fillOn { fillStep() }
      timer -= 1
      if timer % 20 == 0 { showHud() }
      if timer <= 0 { endRound() }
    } else if state == 2 {
      stT += 1
      if stT >= 100 { resetRound() }
    }
    if msgT > 0 {
      msgT -= 1
      if msgT == 0 { msg = "" }
    }
    let be = t - blipT
    aV0 = if be < 5 then 0.4 else 0.0
    aP0 = 1.4 + be * 0.2
    let he = t - hitT
    aV1 = if he < 8 then 0.6 else 0.0
    aP1 = 1.0
    let ph = t % 2
    compose(ph * 8, ph * 8 + 8)
    if ph == 0 {
    st0 = rows[0] .. "\n" .. rows[1] .. "\n" .. rows[2] .. "\n" .. rows[3]
    st1 = rows[4] .. "\n" .. rows[5] .. "\n" .. rows[6] .. "\n" .. rows[7]
    st2 = rows[8] .. "\n" .. rows[9] .. "\n" .. rows[10] .. "\n" .. rows[11]
    st3 = rows[12] .. "\n" .. rows[13] .. "\n" .. rows[14] .. "\n" .. rows[15]
    } else {
    st4 = rows[16] .. "\n" .. rows[17] .. "\n" .. rows[18] .. "\n" .. rows[19]
    st5 = rows[20] .. "\n" .. rows[21] .. "\n" .. rows[22] .. "\n" .. rows[23]
    st6 = rows[24] .. "\n" .. rows[25] .. "\n" .. rows[26] .. "\n" .. rows[27]
    st7 = rows[28] .. "\n" .. rows[29] .. "\n" .. rows[30] .. "\n" .. rows[31]
    }
  }
}
