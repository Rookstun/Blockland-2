  const t = 5 + Math.floor(hash(x, y, 81) * 5); // trunk, bricks
  for (let z = h + 1; z <= Math.min(NZ - 1, h + t + 1); z++) if (V[vi(x, y, z)]) return false;
  const [wx, wy, wz] = at(x, y, h + 1);
