  const [lx, ly] = alongX ? [ex0 - 40, (ey0 + ey1) / 2] : [(ex0 + ex1) / 2, ey0 - 40];
  const p = [d.origin[0] + lx, d.origin[1] + ly, d.topVox * VZ + 2];
