{
  const ends = [];
  for (let x = 0; x < N; x++) for (let y = 0; y < N; y++) if (pathCell[x * N + y] && !swampCell[x * N + y]) ends.push([Math.hypot(x - swamp.x, y - swamp.y), x, y]);
  ends.sort((a, b) => a[0] - b[0]);
