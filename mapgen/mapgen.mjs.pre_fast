    else if (pathDist[i] < 3) continue; // keep the verges clear
    else if (dw > 0.5) kind = u < 0.45 ? 'bones' : u < 0.7 ? 'cairn' : u < 0.85 ? 'cart' : 'firering';
    else if (h > 96) kind = u < 0.7 ? 'cairn' : 'shrine';
