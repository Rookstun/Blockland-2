// ---------- world
mod solid(cx: int, cy: int) -> int {
  if cx < 0 { return EXL[room] < 0 }
  if cx >= W { return EXR[room] < 0 }
  if cy < 0 { return EXU[room] < 0 }
  if cy >= H { return EXD[room] < 0 }
  return SOLID[cur[floor(cy / 2.0) * 32 + floor(cx / 2.0)]]
}
mod tileAt(cx: int, cy: int) -> int {
  if cx < 0 || cx >= W || cy < 0 || cy >= H { return 0 }
  return cur[floor(cy / 2.0) * 32 + floor(cx / 2.0)]
}
// move a w x h box by (dx, dy) against solid tiles: result in mx, my; mhx / mhy = blocked
mod moveBox(x: float, y: float, dx: float, dy: float, w: int, h: int) {
  var nx: float = x + dx
  mhx = false
  if dx > 0.0 {
    let e: int = floor(nx + w - 0.01)
    if solid(e, floor(y)) + solid(e, floor(y + h * 0.5)) + solid(e, floor(y + h - 0.01)) > 0 {
      nx = e - w
      mhx = true
    }
  } else if dx < 0.0 {
    let e: int = floor(nx)
    if solid(e, floor(y)) + solid(e, floor(y + h * 0.5)) + solid(e, floor(y + h - 0.01)) > 0 {
      nx = e + 1
      mhx = true
    }
  }
  var ny: float = y + dy
  mhy = false
  if dy > 0.0 {
    let e: int = floor(ny + h - 0.01)
    if solid(floor(nx), e) + solid(floor(nx + w * 0.5), e) + solid(floor(nx + w - 0.01), e) > 0 {
      ny = e - h
      mhy = true
    }
  } else if dy < 0.0 {
    let e: int = floor(ny)
    if solid(floor(nx), e) + solid(floor(nx + w * 0.5), e) + solid(floor(nx + w - 0.01), e) > 0 {
      ny = e + 1
      mhy = true
    }
  }
  mx = nx
  my = ny
}
mod tileCells(ti: int) {
  let tx = ti % 32
  let ty = floor(ti / 32.0)
  for j in 0..4 {
    let cx = tx * 2 + j % 2
    let cy = ty * 2 + j / 2
    let i = cy * W + cx
    let c = TILEPIX[cur[ti] * 4 + j]
    bg[i] = c
    if fb[i] != c {
      fb[i] = c
      dirty[cy] = 1
    }
  }
}
mod spawn(ty: int, x: float, y: float, svx: float, svy: float) {
  let k = kt.find(0)
  if k >= 0 {
    kt[k] = ty
    kx[k] = x
    ky[k] = y
    kvx[k] = svx
    kvy[k] = svy
    khp[k] = KHP[ty]
    ktm[k] = 0
    kfl[k] = 0
    kgr[k] = 0
    if ty == 2 { kvy[k] = y }
  }
}
mod say(s: string, n: int) {
  msg = s
  msgT = n
}

mod playSong(s: int) {
  song = s
  mi0 = 0
  md0 = 0
  mi1 = 0
  md1 = 0
  mp0 = 0.0
  mp1 = 0.0
}
mod sfx(k: int) {
  fxId = k
  fxI = 0
}
mod loadRoom(r: int) {
  room = r
  cur.slice(ROOMT, r * 576, 576)
  if bossDead {
    for i in 0..576 {
      if cur[i] == 8 { cur[i] = 0 }
    }
  }
  for i in 0..2304 {
    let cx = i % W
    let cy = i / W
    bg[i] = TILEPIX[cur[floor(cy / 2.0) * 32 + floor(cx / 2.0)] * 4 + (cy % 2) * 2 + cx % 2]
  }
  fb.copyFrom(bg)
  for i in 0..H { dirty[i] = 1 }
  rx.clear()
  ry.clear()
  rw.clear()
  rh.clear()
  for k in 0..NK { kt[k] = 0 }
  for i in 0..NB { bt[i] = 0 }
  for i in SPO[r]..SPO[r + 1] {
    let ty = SPK[i]
    if !(ty == 6 && capTaken) && !(ty == 3 && bossDead) {
      spawn(ty, SPX[i], SPY[i], 0.0, 0.0)
    }
  }
  say(RNAME[r] .. ": " .. RMSG[r], if r == TITLE then 100000 else 80)
  var s: int = RSONG[r]
  if r == 4 && bossDead { s = 0 }
  if s != song { playSong(s) }
}

// ---------- sound
mod audio() {
  if song >= 0 {
    md0 -= 1
    if md0 <= 0 {
      if mi0 >= VL0[song] && SLOOP[song] > 0 { mi0 = 0 }
      if mi0 < VL0[song] {
        let n = VO0[song] + mi0
        mp0 = NP0[n]
        md0 = ND0[n]
        mt0 = 0
        mi0 += 1
      } else {
        mp0 = 0.0
        md0 = 100000
      }
    }
    md1 -= 1
    if md1 <= 0 {
      if mi1 >= VL1[song] && SLOOP[song] > 0 { mi1 = 0 }
      if mi1 < VL1[song] {
        let n = VO1[song] + mi1
        mp1 = NP1[n]
        md1 = ND1[n]
        mt1 = 0
        mi1 += 1
      } else {
        mp1 = 0.0
        md1 = 100000
      }
    }
    mt0 += 1
    mt1 += 1
  }
  if mp0 > 0.0 {
    aP0 = mp0
    aV0 = if md0 <= 1 then 0.0 else 0.35 * max(0.45, 1.0 - mt0 * 0.05)
  } else { aV0 = 0.0 }
  if mp1 > 0.0 {
    aP1 = mp1
    aV1 = if md1 <= 1 then 0.0 else 0.6
  } else { aV1 = 0.0 }
  if fxId >= 0 {
    if fxI < FXL[fxId] {
      aP2 = FXP[FXO[fxId] + fxI]
      aV2 = 0.5
      fxI += 1
    } else {
      fxId = -1
      aV2 = 0.0
    }
  } else { aV2 = 0.0 }
}

// ---------- player
mod level() -> int {
  return 1 + (xp >= 10) + (xp >= 20)
}
mod gainXp(n: int) {
  let before = level()
  xp = min(xp + n, 30)
  if level() > before {
    sfx(4)
    say("Weapon level up! Lv " .. level(), 40)
  } else { sfx(3) }
}
mod hurt(d: int, dir: float) {
  if inv == 0 && state == 1 {
    hp -= d
    inv = 40
    vy = -0.6
    vx = dir * 0.45
    let before = level()
    xp = max(xp - 3 * d, 0)
    if level() < before { say("Weapon level down. The gun is disappointed in you.", 50) }
    sfx(2)
    if hp <= 0 {
      hp = 0
      state = 2
      stT = 0
      spawn(8, px, py + 1.0, 0.0, 0.0)
      say("You have died. The cave seems smug about it.", 100000)
      playSong(-1)
    }
  }
}
mod fire() {
  let i = bt.find(0)
  if i >= 0 {
    let lv = level()
    bt[i] = 6 + lv * 4
    bl[i] = lv
    if kU {
      bx[i] = px + 0.5
      by[i] = py - 1.0
      bvx[i] = 0.0
      bvy[i] = -1.5
    } else if kD && !ground {
      bx[i] = px + 0.5
      by[i] = py + 3.0
      bvx[i] = 0.0
      bvy[i] = 1.5
    } else {
      bx[i] = if face > 0 then px + 2.5 else px - 1.5
      by[i] = py + 1.0
      bvx[i] = face * 1.5
      bvy[i] = 0.0
    }
    sfx(0)
  }
}
mod respawn() {
  hp = maxhp
  inv = 0
  vx = 0.0
  vy = 0.0
  face = 1
  state = 1
  playSong(-2)
  pend = saveRoom
  px = saveX
  py = saveY
}
mod newGame() {
  hp = 3
  maxhp = 3
  xp = 0
  inv = 0
  capTaken = false
  bossDead = false
  saveRoom = 0
  saveX = 6.0
  saveY = 29.0
  respawn()
}
mod playerTick() {
  let want: int = kR - kL
  if want != 0 {
    face = want
    vx = clamp(vx + want * 0.12, -0.5, 0.5)
  } else {
    vx = vx * (if ground then 0.5 else 0.85)
  }
  if kJ && !pJ && ground {
    vy = -1.05
    sfx(1)
  }
  vy = min(vy + (if kJ && vy < 0.0 then 0.06 else 0.12), 1.0)
  moveBox(px, py, vx, vy, 2, 3)
  px = mx
  if mhx { vx = 0.0 }
  ground = mhy && vy > 0.0
  if mhy {
    if vy < -0.2 { sfx(11) }
    vy = 0.0
  }
  py = my
  if kS && !pS { fire() }
  if inv > 0 { inv -= 1 }
  // spikes (standing on or touching), save points
  let fy: int = floor(py + 3.05)
  let cx0: int = floor(px)
  let cx1: int = floor(px + 1.99)
  if tileAt(cx0, fy) == 5 || tileAt(cx1, fy) == 5 || tileAt(cx0 - 1, floor(py + 2.0)) == 5 || tileAt(cx1 + 1, floor(py + 2.0)) == 5 {
    hurt(1, -face)
    vy = -0.9
  }
  let mid: int = floor(py + 1.5)
  let sv = tileAt(cx0, mid) == 6 || tileAt(cx1, mid) == 6 || tileAt(cx0, floor(py + 2.5)) == 6 || tileAt(cx1, floor(py + 2.5)) == 6
  if sv && !onSave {
    saveRoom = room
    saveX = px
    saveY = py
    hp = maxhp
    sfx(8)
    say("Game saved. Health restored. Dignity pending.", 60)
  }
  onSave = sv
  // room exits (positions carry across the edge)
  if px < -1.0 && EXL[room] >= 0 {
    pend = EXL[room]
    px = px + W
  } else if px > W - 1.0 && EXR[room] >= 0 {
    pend = EXR[room]
    px = px - W
  } else if py < -1.5 && EXU[room] >= 0 {
    pend = EXU[room]
    py = py + H
  } else if py > H - 1.5 {
    if EXD[room] >= 0 {
      pend = EXD[room]
      py = py - H
    } else { hurt(100, 0.0) }
  }
  if room == 5 && state == 1 {
    endT += 1
    if endT == 160 { say("You escaped the cave. Somewhere, a mole king weeps into his tiny crown.", 140) }
    if endT == 320 {
      state = 3
      stT = 0
      say("THE END. Thanks for playing! Press JUMP.", 100000)
    }
  }
}

// ---------- bullets and entities
mod overlap(ax: float, ay: float, aw: float, ah: float, bx0: float, by0: float, bw: float, bh: float) -> bool {
  return ax < bx0 + bw && bx0 < ax + aw && ay < by0 + bh && by0 < ay + ah
}
mod kill(k: int) {
  let ty = kt[k]
  let cxk = kx[k] + KW[ty] * 0.5
  let cyk = ky[k] + KH[ty] * 0.5
  kt[k] = 8
  ktm[k] = 0
  kx[k] = cxk - 1.0
  ky[k] = cyk - 1.0
  sfx(6)
  for j in 0..KDROP[ty] {
    spawn(4, cxk + Random(-1.0, 1.0), cyk, Random(-0.4, 0.4), Random(-1.0, -0.5))
  }
  if Random(0, 3) == 0 { spawn(5, cxk - 1.0, cyk - 1.0, 0.0, -0.5) }
  if ty == 3 {
    bossDead = true
    for i in 0..576 {
      if cur[i] == 8 {
        cur[i] = 0
        tileCells(i)
      }
    }
    for i in 0..NK {
      if kt[i] == 7 { kt[i] = 0 }
    }
    playSong(0)
    say("The Mole King is defeated. He was just a mole with a crown.", 100)
  }
}
mod bulletTick() {
  for i in 0..NB {
    if bt[i] > 0 {
      bt[i] -= 1
      bx[i] = bx[i] + bvx[i]
      by[i] = by[i] + bvy[i]
      let cx: int = floor(bx[i])
      let cy: int = floor(by[i])
      let tl = tileAt(cx, cy)
      if tl == 7 {
        cur[floor(cy / 2.0) * 32 + floor(cx / 2.0)] = 0
        tileCells(floor(cy / 2.0) * 32 + floor(cx / 2.0))
        sfx(7)
        bt[i] = 0
      } else if solid(cx, cy) > 0 || cx < -1 || cx > W || cy < -1 || cy > H {
        bt[i] = 0
      } else {
        for k in 0..NK {
          let ty = kt[k]
          if bt[i] > 0 && (ty == 1 || ty == 2 || ty == 3) && overlap(bx[i], by[i], 1.0, 1.0, kx[k], ky[k], KW[ty], KH[ty]) {
            khp[k] = khp[k] - bl[i]
            kfl[k] = 3
            bt[i] = 0
            if khp[k] <= 0 { kill(k) } else { sfx(11) }
          }
        }
      }
    }
  }
}
mod entityTick() {
  for k in 0..NK {
    let ty = kt[k]
    if ty > 0 {
      ktm[k] = ktm[k] + 1
      if kfl[k] > 0 { kfl[k] = kfl[k] - 1 }
      let dxp = px + 1.0 - (kx[k] + KW[ty] * 0.5)
      if ty == 1 {
        // hopper: waits on the ground, then hops at you
        kvy[k] = min(kvy[k] + 0.1, 1.0)
        if kgr[k] > 0 && ktm[k] > 25 && abs(dxp) < 26.0 {
          kvy[k] = -0.95
          kvx[k] = sign(dxp) * 0.35
          ktm[k] = 0
        }
        moveBox(kx[k], ky[k], kvx[k], kvy[k], 2, 2)
        kx[k] = mx
        ky[k] = my
        kgr[k] = mhy && kvy[k] > 0.0
        if mhy {
          kvy[k] = 0.0
          if kgr[k] > 0 { kvx[k] = 0.0 }
        }
        if mhx { kvx[k] = -kvx[k] }
      } else if ty == 2 {
        // bat: bobs on a sine round its spawn height, drifts toward you
        if abs(dxp) < 34.0 { kx[k] = kx[k] + sign(dxp) * 0.12 }
        ky[k] = kvy[k] + SINT[(ktm[k] * 2) % 32] * 2.5
      } else if ty == 3 {
        // the Mole King: stomps toward you, leaps, rocks fall when he lands
        kvy[k] = min(kvy[k] + 0.08, 1.2)
        if kgr[k] > 0 {
          kvx[k] = sign(dxp) * 0.22
          if ktm[k] > 45 {
            kvy[k] = -1.25
            kvx[k] = sign(dxp) * 0.45
            ktm[k] = 0
            sfx(9)
          }
        }
        let wasAir = kgr[k] == 0
        moveBox(kx[k], ky[k], kvx[k], kvy[k], 6, 5)
        kx[k] = mx
        ky[k] = my
        kgr[k] = mhy && kvy[k] > 0.0
        if mhy {
          if wasAir && kgr[k] > 0 {
            sfx(12)
            spawn(7, clamp(px + Random(-6.0, 6.0), 4.0, 58.0), 4.0, 0.0, 0.0)
            spawn(7, Random(4.0, 58.0), 4.0, 0.0, 0.0)
          }
          kvy[k] = 0.0
        }
      } else if ty == 4 || ty == 5 || ty == 6 {
        // pickups fall and bounce; shards fade
        kvy[k] = min(kvy[k] + 0.08, 0.8)
        kvx[k] = kvx[k] * 0.95
        moveBox(kx[k], ky[k], kvx[k], kvy[k], KW[ty], KH[ty])
        kx[k] = mx
        ky[k] = my
        if mhy { kvy[k] = if kvy[k] > 0.3 then -kvy[k] * 0.5 else 0.0 }
        if mhx { kvx[k] = -kvx[k] }
        if ty == 4 && ktm[k] > 160 { kt[k] = 0 }
      } else if ty == 7 {
        kvy[k] = min(kvy[k] + 0.05, 0.9)
        ky[k] = ky[k] + kvy[k]
        if ky[k] > 6.0 && solid(floor(kx[k] + 1.0), floor(ky[k] + 2.0)) > 0 {
          kt[k] = 8
          ktm[k] = 0
        }
      } else if ty == 8 {
        if ktm[k] > 6 { kt[k] = 0 }
      }
      // touching the player
      let ty2 = kt[k]
      if state == 1 && ty2 > 0 && ty2 != 8 && overlap(px, py, 2.0, 3.0, kx[k], ky[k], KW[ty2], KH[ty2]) {
        if ty2 == 4 {
          kt[k] = 0
          gainXp(1)
        } else if ty2 == 5 {
          kt[k] = 0
          hp = min(hp + 2, maxhp)
          sfx(10)
        } else if ty2 == 6 {
          kt[k] = 0
          capTaken = true
          maxhp += 3
          hp = maxhp
          sfx(4)
          say("Life Capsule! Max health +3. Your heart is now slightly larger, like a balloon animal.", 90)
        } else {
          hurt(KDMG[ty2], if dxp > 0.0 then 1.0 else -1.0)
        }
      }
    }
  }
}

// ---------- drawing
mod eraseRect(x: int, y: int, w: int, h: int) {
  for j in 0..w * h {
    let cx = x + j % w
    let cy = y + j / w
    if cx >= 0 && cx < W && cy >= 0 && cy < H {
      let i = cy * W + cx
      if fb[i] != bg[i] {
        fb[i] = bg[i]
        dirty[cy] = 1
      }
    }
  }
}
mod drawSpr(s: int, x: int, y: int, flip: int, white: int) {
  let w = SW[s]
  let o = SOFF[s]
  for j in 0..w * SH[s] {
    let sx = j % w
    let sy = j / w
    let c = SPR[o + sy * w + (if flip > 0 then w - 1 - sx else sx)]
    let cx = x + sx
    let cy = y + sy
    if c >= 0 && cx >= 0 && cx < W && cy >= 0 && cy < H {
      let i = cy * W + cx
      let col = if white > 0 then 7 else c
      if fb[i] != col {
        fb[i] = col
        dirty[cy] = 1
      }
    }
  }
  rx.push(x)
  ry.push(y)
  rw.push(w)
  rh.push(SH[s])
}
mod put(cx: int, cy: int, c: int) {
  let i = cy * W + cx
  if fb[i] != c {
    fb[i] = c
    dirty[cy] = 1
  }
}
mod encRow(r: int) {
  var s: string = ""
  var c0: int = -1
  var n: int = 0
  for c in 0..W {
    let p = fb[r * W + c]
    if p == c0 {
      n += 1
    } else {
      if n > 0 { s = s .. OPEN[c0] .. BLK[n] .. CLOSE[c0] }
      c0 = p
      n = 1
    }
  }
  rows[r] = s .. OPEN[c0] .. BLK[n] .. CLOSE[c0]
}
mod paintRow(r: int) {
  for c in 0..W {
    let i = r * W + c
    let p = fb[i]
    if p != shown[i] {
      shown[i] = p
      scr[i].SetBrickProperty(Color, ColorSRGB(PR[p], PG[p], PB[p], 255))
    }
  }
}
mod hexRow(r: int) -> string {
  var s: string = ""
  for c in 0..W { s = s .. HEXD[fb[r * W + c]] }
  return s
}
mod drawHud() {
  let lv = level()
  for i in 0..3 { put(1 + i * 2, 1, if i < lv then 9 else 2) }
  let fill: int = if xp >= 30 then 16 else ((xp - (lv - 1) * 10) * 16) / 10
  for i in 0..16 { put(8 + i, 1, if i < fill then (if xp >= 30 then 12 else 9) else 2) }
  for i in 0..maxhp * 2 { put(1 + i, 3, if i < hp * 2 then 8 else 15) }
}
mod render() {
  for i in 0..rx.length() { eraseRect(rx[i], ry[i], rw[i], rh[i]) }
  rx.clear()
  ry.clear()
  rw.clear()
  rh.clear()
  if state != 0 {
    for k in 0..NK {
      let ty = kt[k]
      if ty > 0 {
        let a = (ktm[k] / 4) % 2
        var s: int = 0
        if ty == 1 { s = if kgr[k] > 0 then 3 else 4 }
        else if ty == 2 { s = 5 + a }
        else if ty == 3 { s = 7 + (if kgr[k] > 0 then a else 0) }
        else if ty == 4 { s = 9 + a }
        else if ty == 5 { s = 11 }
        else if ty == 6 { s = 12 }
        else if ty == 7 { s = 13 }
        else { s = 14 + (ktm[k] / 3) % 2 }
        let fl: int = if ty < 4 && kx[k] + KW[ty] * 0.5 < px + 1.0 then 0 else 1
        drawSpr(s, floor(kx[k]), floor(ky[k]), if ty == 2 then 0 else fl, kfl[k] > 0)
      }
    }
    for i in 0..NB {
      if bt[i] > 0 { drawSpr(16 + bl[i] - 1, floor(bx[i]), floor(by[i]), 0, 0) }
    }
    if state == 1 && (inv == 0 || t % 4 < 2) {
      let ps: int = if !ground then 2 else (if abs(vx) > 0.1 then 0 + (t / 3) % 2 else 0)
      drawSpr(ps, if face > 0 then floor(px) else floor(px) - 1, floor(py), face < 0, 0)
    }
    drawHud()
  }
  var painted: int = 0
  for r in 0..H {
    if dirty[r] > 0 && painted < 12 {
      paintRow(r)
      dirty[r] = 0
      painted += 1
    }
  }
}

// ---------- the frame
fn boot() {
  booted = true
  state = 0
  playSong(0)
  pend = TITLE
  say(RNAME[TITLE] .. " " .. RMSG[TITLE], 100000)
}
on tick {
  if !booted { boot() }
  kL = left
  kR = right
  kU = up
  kD = down
  kJ = jump
  kS = shoot
  t += 1
  stT += 1
  if state == 0 {
    if (kJ && !pJ) || (kS && !pS) { newGame() }
  } else if state == 1 {
    playerTick()
    bulletTick()
    entityTick()
  } else if state == 2 {
    bulletTick()
    entityTick()
    if stT == 40 { say("You have died. The cave seems smug about it. Press JUMP to try again.", 100000) }
    if stT > 40 && kJ && !pJ { respawn() }
  } else {
    if stT > 20 && kJ && !pJ { boot() }
  }
  if pend >= 0 {
    let pr = pend
    pend = -1
    loadRoom(pr)
  }
  if msgT > 0 {
    msgT -= 1
    if msgT == 0 { msg = "" }
  }
  hud = "HP " .. hp .. "/" .. maxhp .. "  Lv " .. level() .. "  EXP " .. xp
  audio()
  render()
  pJ = kJ
  pS = kS
}
