mod encRow(src: string, off: int) {
  var s: string = ""
  var c0: int = -1
  var n: int = 0
  for c in 0..W {
    let p = MAP[src.Substring(off + c, 1).ToCharCode().Codepoint - 33]
    if p == c0 {
      n += 1
    } else {
      if n > 0 { s = s .. OPEN[c0] .. BLK[n] .. CLOSE[c0] }
      c0 = p
      n = 1
    }
  }
  rowOut = s .. OPEN[c0] .. BLK[n] .. CLOSE[c0]
}
mod setStrip(k: int, v: string) {
  if k == 0 { st0 = v }
  if k == 1 { st1 = v }
  if k == 2 { st2 = v }
  if k == 3 { st3 = v }
  if k == 4 { st4 = v }
  if k == 5 { st5 = v }
  if k == 6 { st6 = v }
  if k == 7 { st7 = v }
  if k == 8 { st8 = v }
}

on ChatCommand("nes", "NES frame feed (host.mjs)") -> (ctrl, args) {
  let k0 = args.Substring(0, 1).ToCharCode().Codepoint - 48
  let n = (args.Length() - 1) / 192
  for s in 0..n {
    var acc: string = ""
    acc = ""
    for r in 0..4 {
      encRow(args, 1 + (s * 4 + r) * W)
      if r < 3 { acc = acc .. rowOut .. "\n" } else { acc = acc .. rowOut }
    }
    setStrip(k0 + s, acc)
  }
}

on tick {
  var m: int = 0
  if seated { m = 256 }
  if ba { m += 1 }
  if bb { m += 2 }
  if up && down { m += 8 } else {
    if up { m += 16 }
    if down { m += 32 }
  }
  if left && right { m += 4 } else {
    if left { m += 64 }
    if right { m += 128 }
  }
  if m != last {
    last = m
    PrintToConsole("nesin|" .. m)
  }
}
