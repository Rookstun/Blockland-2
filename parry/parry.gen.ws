var hp: int = 5
var foe: int = 5
var combo: int = 0
var rnd: int = 12345
var idleT: int = 30
var wind: int = 28
var atk: int = 0
var feint: bool = false
var pT: int = -1
var pK: int = -1
var resKind: int = 0
var pA: bool = false
var pB: bool = false
