var aV3: float = 0.0
var aP0: float = 1.0
var aV0: float = 0.0
var aP1: float = 1.0
var aV1: float = 0.0
var rows: string[] = ["", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""]
var st0: string = ""
var st1: string = ""
var st2: string = ""
var st3: string = ""
var st4: string = ""
var st5: string = ""
var st6: string = ""
