@right out strip0: string = st0
@right out strip1: string = st1
@right out strip2: string = st2
@right out strip3: string = st3
@right out strip4: string = st4
@right out strip5: string = st5
@right out strip6: string = st6
@right out strip7: string = st7
@right out msg_: string = msg
@right out hud_: string = hud
@right out title_: string = if state == 0 then "PARRY OR PERISH" else ""
@right out P0: float = aP0
@right out V0: float = aV0
@right out P1: float = aP1
@right out V1: float = aV1
@right out P2: float = aP2
@right out V2: float = aV2
@right out P3: float = aP3
@right out V3: float = aV3
@right out state_: int = state

mod showHud() {
  hud = if state == 0 then "SPACE = HIGH PARRY     E / LMB = LOW PARRY" else ("HP " .. BAR[hp] .. "  FOE " .. BAR[foe] .. "  COMBO " .. combo .. "  SCORE " .. score)
}

mod say(s: string, n: int) {
  msg = s
  msgT = n
}

mod put(i: int, k: int) {
  act[i] = k
  oldA[nA] = i
  nA += 1
}

mod stamp() {
  for k in 0..16 { act[oldA[k]] = 0 }
  for k in 0..16 { oldA[k] = 0 }
  nA = 0
  let row = if atk == 0 then 11 else 13
  if state == 2 {
    for c in 17..20 { put(10 * 24 + c, 16) }
    let late = wind - stT
    var k: int = if atk == 0 then 9 else 11
    if late <= 7 && !feint { k = 6 }
    put(row * 24 + 16, k)
  }
  if state == 3 && resKind == 0 {
    put(row * 24 + 6, 6)
    put(row * 24 + 7, 6)
    put(row * 24 + 8, 13)
    if stT < 8 { for c in 9..16 { put(row * 24 + c, 12) } }
  }
  if state == 3 && resKind == 1 {
    if stT < 8 {
      for c in 6..16 { put(row * 24 + c, 12) }
      put(row * 24 + 5, 13)
    }
  }
}

mod loadLevel() {
  let m = lvl % 3
  for i in 0..384 { cur[i] = MAP[i] }
  foe = FOES[m] + (lvl / 3) * 2
  if foe > 12 { foe = 12 }
  wind = 30 - lvl * 3
  if wind < 16 { wind = 16 }
  state = 1
  stT = 0
  idleT = 24
  pT = -1
  say("DEMON " .. (lvl + 1), 40)
  showHud()
}

mod newGame() {
  lvl = 0
  score = 0
  hp = 5
  combo = 0
  loadLevel()
}

mod hurt() {
  hp -= 1
  combo = 0
  hitT = t
}

mod resolve() {
  stT = 0
  state = 3
  resKind = 1
  if feint {
    resKind = 2
    if pT >= 0 {
      hurt()
      say("FEINT! FOOLED", 25)
    } else {
      say("FEINT", 20)
    }
  } else if pT >= 0 && pK == atk && wind - pT <= 7 {
    resKind = 0
    combo += 1
    clangT = t
    if wind - pT <= 3 {
      foe -= 2
      score += 150 * combo
      clangP = 2.2
      say("PERFECT", 25)
    } else {
      foe -= 1
      score += 100 * combo
      clangP = 1.5
      say("PARRY", 20)
    }
    if foe < 0 { foe = 0 }
  } else {
    hurt()
    if pT < 0 { say("TOO SLOW", 25) } else if pK != atk { say("WRONG PARRY", 25) } else { say("TOO EARLY", 25) }
  }
  showHud()
}

mod compose(r0: int, r1: int) {
  for ty in r0..r1 {
    var sT: string = ""
    var cT: int = -1
    var nT: int = 0
    var sB: string = ""
    var cB: int = -1
    var nB: int = 0
    for tx in 0..24 {
      let i = ty * 24 + tx
      var k: int = act[i]
      if k == 0 { k = cur[i] }
      let o = k * 4
      let a = LOOK[o]
      let b = LOOK[o + 1]
      let c = LOOK[o + 2]
      let d = LOOK[o + 3]
      if a == cT { nT += 1 } else {
        if nT > 0 { sT = sT .. OPEN[cT] .. BLK[nT] .. CLOSE[cT] }
        cT = a
        nT = 1
      }
      if b == cT { nT += 1 } else {
        if nT > 0 { sT = sT .. OPEN[cT] .. BLK[nT] .. CLOSE[cT] }
        cT = b
        nT = 1
      }
      if c == cB { nB += 1 } else {
        if nB > 0 { sB = sB .. OPEN[cB] .. BLK[nB] .. CLOSE[cB] }
        cB = c
        nB = 1
      }
      if d == cB { nB += 1 } else {
        if nB > 0 { sB = sB .. OPEN[cB] .. BLK[nB] .. CLOSE[cB] }
        cB = d
        nB = 1
      }
    }
    rows[ty * 2] = sT .. OPEN[cT] .. BLK[nT] .. CLOSE[cT]
    rows[ty * 2 + 1] = sB .. OPEN[cB] .. BLK[nB] .. CLOSE[cB]
  }
}

mod powerOn() {
  booted = true
  lvl = 0
  score = 0
  hp = 5
  combo = 0
  loadLevel()
  state = 0
  mi = 0
  mt = LT[0]
  bi = 0
  bt = BT[0]
  say("HOLD SPACE TO START", 0)
  showHud()
}

mod powerOff() {
  booted = false
  state = 0
  msg = ""
  hud = ""
  st0 = ""
  st1 = ""
  st2 = ""
  st3 = ""
  st4 = ""
  st5 = ""
  st6 = ""
  st7 = ""
  aV0 = 0.0
  aV1 = 0.0
  aV2 = 0.0
  aV3 = 0.0
}

on tick {
  let pwr = seated
  if !pwr {
    if booted { powerOff() }
  } else {
    if !booted { powerOn() }
    let ia = a
    let ib = b
    t += 1
    rnd = (rnd * 75 + 74) % 65537
    let aE = ia && !pA
    let bE = ib && !pB
    if state == 0 || state == 5 {
      if stT < 100 { stT += 1 }
      if stT > 20 && (aE || bE) { newGame() }
    } else if state == 1 {
      stT += 1
      if stT >= idleT {
        atk = rnd % 2
        feint = lvl >= 1 && (rnd / 2) % 5 == 0
        pT = -1
        pK = -1
        state = 2
        stT = 0
      }
    } else if state == 2 {
      stT += 1
      if pT < 0 {
        if aE {
          pT = stT
          pK = 0
        } else if bE {
          pT = stT
          pK = 1
        }
      }
      if stT >= wind { resolve() }
    } else if state == 3 {
      stT += 1
      if stT >= 14 {
        if foe <= 0 {
          state = 4
          stT = 0
          score += 500
          say("DEMON DOWN", 0)
        } else if hp <= 0 {
          state = 5
          stT = 0
          say("YOU PERISHED", 0)
        } else {
          state = 1
          stT = 0
          idleT = 16 + (rnd / 4) % 24
        }
        showHud()
      }
    } else if state == 4 {
      stT += 1
      if stT >= 50 {
        lvl += 1
        if hp < 5 { hp += 1 }
        loadLevel()
      }
    }
    if msgT > 0 {
      msgT -= 1
      if msgT == 0 { msg = "" }
    }
    // music: lead voice 2, bass voice 3
    mt -= 1
    if mt <= 0 {
      mi = (mi + 1) % 45
      mt = LT[mi]
    }
    bt -= 1
    if bt <= 0 {
      bi = (bi + 1) % 64
      bt = BT[bi]
    }
    aP2 = if LP[mi] > 0.0 then LP[mi] else 1.0
    aV2 = if LP[mi] > 0.0 then 0.14 else 0.0
    aP3 = if BP[bi] > 0.0 then BP[bi] else 1.0
    aV3 = if BP[bi] > 0.0 then 0.2 else 0.0
    // sfx: parry clang (voice 0), hit (voice 1, noise)
    let ce = t - clangT
    aV0 = if ce < 6 then 0.5 else 0.0
    aP0 = clangP + ce * 0.05
    let he = t - hitT
    aV1 = if he < 8 then 0.6 else 0.0
    aP1 = 1.0
    stamp()
    let ph = t % 2
    compose(ph * 8, ph * 8 + 8)
    if ph == 0 {
    st0 = rows[0] .. "\n" .. rows[1] .. "\n" .. rows[2] .. "\n" .. rows[3]
    st1 = rows[4] .. "\n" .. rows[5] .. "\n" .. rows[6] .. "\n" .. rows[7]
    st2 = rows[8] .. "\n" .. rows[9] .. "\n" .. rows[10] .. "\n" .. rows[11]
    st3 = rows[12] .. "\n" .. rows[13] .. "\n" .. rows[14] .. "\n" .. rows[15]
    } else {
    st4 = rows[16] .. "\n" .. rows[17] .. "\n" .. rows[18] .. "\n" .. rows[19]
    st5 = rows[20] .. "\n" .. rows[21] .. "\n" .. rows[22] .. "\n" .. rows[23]
    st6 = rows[24] .. "\n" .. rows[25] .. "\n" .. rows[26] .. "\n" .. rows[27]
    st7 = rows[28] .. "\n" .. rows[29] .. "\n" .. rows[30] .. "\n" .. rows[31]
    }
    pA = ia
    pB = ib
  }
}
