@right out V0: float = aV0

mod setStrip(k: int, v: string) {
  if k == 0 { pb0 = v }
  if k == 1 { pb1 = v }
  if k == 2 { pb2 = v }
  if k == 3 { pb3 = v }
  pubDirty = true
}
// FRAME SWAP (Rookstun: tearing): rows render into the pb* back buffers; all shown strips are swapped in together at
// most every 1/60 s (Rookstun: 60 fps), so the client gets whole frames instead of strips landing on different server frames
mod publish() {
  st0 = pb0
  st1 = pb1
  st2 = pb2
  st3 = pb3
  pubDirty = false
}
mod mark(r: int) {
  if r >= 0 && r < 160 {
    if dfl.get(r) == 0 {
      dfl[r] = 1
      dl.push(r)
    }
  }
}
mod markBall(i: int) {
  let y0 = floor(by.get(i))
  for k in 0..4 { mark(y0 + k) }
}
mod newBall() {
  let a = Random(-0.6, 0.6)
  bx.push(118.0)
  by.push(30.0)
  vx.push(5.0 * sin(a))
  vy.push(5.0 * cos(a))
}
mod reset() {
  for i in 0..bx.length() { markBall(i) }
  if won {
    won = false
    for r in 38..102 { mark(r) }
  }
  bx.resize(0, 0.0)
  by.resize(0, 0.0)
  vx.resize(0, 0.0)
  vy.resize(0, 0.0)
  newBall()
  score = 0
  over = 0
  for r in 38..102 { mark(r) }
}
// rebuild one row from the objects on it
mod renderRow(r: int) {
  is.resize(0, 0.0)
  ie.resize(0, 0.0)
  for i in 0..bx.length() {
    let y0 = floor(by.get(i))
    if r >= y0 && r < y0 + 4 {
      let x0 = floor(bx.get(i))
      is.push(x0)
      ie.push(x0 + 4.0)
    }
  }
  if r >= 148 && r < 152 {
    is.push(floor(px))
    ie.push(floor(px) + 28.0)
  }
  if r < 2 {
    is.push(0.0)
    ie.push(240.0)
  }
  // round bumper (Rookstun: 64x64 circle on the left): its precomputed spans on this row, with the win text once won
  if over > 0 {
    for j in CI2[r]..CI2[r + 1] {
      is.push(CS2[j])
      ie.push(CE2[j])
    }
  } else { if won {
    for j in CI1[r]..CI1[r + 1] {
      is.push(CS1[j])
      ie.push(CE1[j])
    }
  } else {
    for j in CI0[r]..CI0[r + 1] {
      is.push(CS0[j])
      ie.push(CE0[j])
    }
  } }
  is.sortMultiple(ie)
  s = ""
  cur = 0.0
  for j in 0..is.length() {
    let a = max(max(is.get(j), cur), 0.0)
    let b = min(ie.get(j), 240.0)
    if b > a {
      s = s .. SP.Substring(0, a - cur) .. BL.Substring(0, b - a)
      cur = b
    }
  }
  rows[r] = s .. SP.Substring(0, 240.0 - cur) // full width: the TextDisplay centres each line, short rows drifted right
  sdf[r / 40] = 1
}
mod note(p: float, n: int) {
  for k in 0..n { mel.push(p) }
}
mod sadTune() {
  mel.resize(0, 0.0)
  melPos = 0
  note(1.0, 5)
  note(0.94, 5)
  note(0.89, 5)
  note(0.0, 1)
  note(0.75, 12)
}
mod happyTune() {
  mel.resize(0, 0.0)
  melPos = 0
  note(1.0, 2)
  note(1.26, 2)
  note(1.5, 3)
}
mod winTune() {
  mel.resize(0, 0.0)
  melPos = 0
  note(1.5, 3)
  note(0.0, 1)
  note(1.5, 2)
  note(1.68, 3)
  note(2.0, 3)
  note(0.0, 1)
  note(1.68, 2)
  note(2.0, 10)
}
// DELTA TIME (Rookstun): every tick moves things by the real time since the last one (k = dt / 0.1 s; velocities are
// pixels per 0.1 s), so speed no longer depends on the tick rate; game over lasts 3 s of real time
mod step() {
  let now = ServerUptime()
  kt = min(max((now - lastT) * 10.0, 0.0), 2.5)
  lastT = now
  // bouncy blip (Rookstun): 3 ticks, pitch sweeping up from the surface's base note
  if melPos < mel.length() {
    // tune playing (Rookstun: sad game over, happy new ball, a different happy one at 10 balls): one pitch a tick, 0 = rest
    aP0 = max(mel.get(melPos), 0.1)
    aV0 = if mel.get(melPos) > 0.0 then 0.5 else 0.0
    melPos += 1
    beep = 0
  } else { if beep > 0 {
    aP0 = sb * (1.0 + (3 - beep) * 0.35)
    aV0 = 0.5
    beep -= 1
  } else { aV0 = 0.0 } }
  // a round starts only on the player's confirm (Rookstun): Space / right mouse, after sitting down or a game over
  if waiting {
    if ba && lastBa == false {
      waiting = false
      titlev = "" // Rookstun: the title screen goes once the player confirms
      if over > 0 {
        over = 0
        reset()
      }
    }
  } else {
    if left { px -= 6.0 * kt }
    if right { px += 6.0 * kt }
    px = min(max(px, 0.0), 212.0)
    if px != opx {
      for k in 0..4 { mark(148 + k) }
      opx = px
    }
    alive = 0
    for i in 0..bx.length() {
      if by.get(i) < 160.0 {
        markBall(i)
        var x: float = 0.0
        var y: float = 0.0
        var dx: float = 0.0
        var dy: float = 0.0
        x = bx.get(i) + vx.get(i) * kt
        y = by.get(i) + vy.get(i) * kt
        dx = vx.get(i)
        dy = vy.get(i)
        if x < 0.0 {
          x = 0.0 - x
          dx = 0.0 - dx
        }
        if x > 236.0 {
          x = 472.0 - x
          dx = 0.0 - dx
        }
        if y < 3.0 {
          y = 6.0 - y
          dy = abs(dy)
          sb = 1.6
          beep = 3
        }
        // bumper: ball centre inside radius + half ball and moving inward -> reflect the velocity off the normal, push out
        let nx = x + 2.0 - 60.0
        let ny = y + 2.0 - 70.0
        let d = max(sqrt(nx * nx + ny * ny), 0.01)
        if d < 34.0 {
          let ux = nx / d
          let uy = ny / d
          let vn = dx * ux + dy * uy
          if vn < 0.0 {
            dx = dx - 2.0 * vn * ux
            dy = dy - 2.0 * vn * uy
            sb = 0.7
            beep = 3
          }
          x = 60.0 + ux * 34.5 - 2.0
          y = 70.0 + uy * 34.5 - 2.0
        }
        // swept paddle test (Rookstun: balls went through): where was the ball when its bottom crossed the paddle top?
        let oy = by.get(i)
        let xc = bx.get(i) + vx.get(i) * kt * min(max((148.0 - oy - 4.0) / max(dy * kt, 0.01), 0.0), 1.0)
        if dy > 0.0 && oy + 4.0 <= 150.0 && y + 4.0 >= 148.0 && xc + 4.0 > px - 1.0 && xc < px + 29.0 {
          let off = min(max((xc + 2.0 - (px + 14.0)) / 14.0, -1.0), 1.0)
          x = min(max(xc, 0.0), 236.0)
          let sp = min(9.0, sqrt(dx * dx + dy * dy) + 0.15)
          dx = sp * off * 0.8
          dy = 0.0 - sqrt(sp * sp - dx * dx)
          y = 144.0
          score += 1
          sb = 1.2
          beep = 3
          if score % 2 == 0 && alive < 10 {
            newBall() // at most 10 balls (Rookstun)
            happyTune()
          }
        }
        bx[i] = x
        by[i] = y
        vx[i] = dx
        vy[i] = dy
        markBall(i)
        if y < 160.0 { alive += 1 }
      }
    }
    if alive > most { most = alive }
    if alive >= 10 && won == false {
      won = true
      winTune()
      for r in 38..102 { mark(r) }
    }
    if alive == 0 {
      if score > best { best = score }
      over = 1
      waiting = true
      sadTune()
      for r in 38..102 { mark(r) }
    }
  }
  lastBa = ba
  // scoreboard (Rookstun 2026-11-06): score, balls, highest score and highest balls, always all four
  let board = "SCORE ${score}  BALLS ${alive}  HIGH SCORE ${best}  HIGH BALLS ${most}"
  if waiting {
    if over > 0 { hudv = "GAME OVER  " .. board .. "  -  SPACE" } else { hudv = board .. "  -  SPACE TO START" }
  } else { hudv = board }
}
// the player left: back to idle as if untouched (Rookstun): game stopped, screen blank, score cleared
mod idle() {
  if was {
    was = false
    bx.resize(0, 0.0)
    by.resize(0, 0.0)
    vx.resize(0, 0.0)
    vy.resize(0, 0.0)
    dl.resize(0, 0)
    dfl.fill(0)
    won = false
    over = 0
    score = 0
    aV0 = 0.0
    titlev = "NIGHT PONG"
    mel.resize(0, 0.0)
    melPos = 0
    hudv = ""
    st0 = ""
    pb0 = ""
    st1 = ""
    pb1 = ""
    st2 = ""
    pb2 = ""
    st3 = ""
    pb3 = ""
  }
}
mod flush() {
  for j in 0..dl.length() {
    let r = dl.get(j)
    dfl[r] = 0
    renderRow(r)
  }
  dl.resize(0, 0)
  for k in 0..4 {
    if sdf.get(k) == 1 {
      sdf[k] = 0
      var acc: string = ""
      acc = ""
      for j in 0..40 {
        if j < 39 { acc = acc .. rows.get(k * 40 + j) .. "\n" } else { acc = acc .. rows.get(k * 40 + j) }
      }
      setStrip(k, acc)
    }
  }
}

// 20 Hz tick, game at 10 fps; only while somebody sits (a new sitter = new game, full redraw)
// live text calibration (Rookstun: the font will not draw the 0.125 grid at the computed size): /pgcal h+ h- w+ w-
// = line height / width scale +-5%; tells the caller and logs pgcal|lh|ws so the values can be baked into LH0/WS0
on ChatCommand("pgcal", "Night Pong screen fit: h+ h- (row height) w+ w- (width)") -> (ctrl, args) {
  if args == "h+" { lhv = lhv * 1.05 }
  if args == "h-" { lhv = lhv / 1.05 }
  if args == "w+" { wsv = wsv * 1.05 }
  if args == "w-" { wsv = wsv / 1.05 }
  ctrl.DisplayText("row height ${lhv}  width ${wsv}", positionY = -300.0, fontSize = 30, lifetime = 3.0, textId = 9703)
  PrintToConsole("pgcal|${lhv}|${wsv}")
}
// FRAME TICK (Rookstun: bypass the clock, no input/screen delay): ServerUptime changes every server frame, so this
// fires once a frame with no clock gate in between; movement already uses delta time, so speed is unchanged
on ServerUptime() {
  if seated || forced {
    if was == false {
      was = true
      rows.resize(160, "")
      dfl.resize(160, 0)
      sdf.resize(4, 0)
      reset()
      waiting = true
      lastT = ServerUptime()
      for r in 0..160 { mark(r) }
    }
    step()
    flush()
    if pubDirty && ServerUptime() - pubT >= 1.0 / FPS - 0.001 {
      pubT = ServerUptime()
      publish()
    }
  } else {
    idle()
  }
}
// the seat emptying resets at once: the release clock stops with the seat (clockWhenSeated), so no tick would come
on Change(seated) {
  if seated == false && forced == false { idle() }
}
