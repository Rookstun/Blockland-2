const CE1 = [66, 70, 72, 75, 76, 78, 79, 81, 82, 83, 84, 85, 85, 86, 87, 87, 88, 89, 89, 89, 90, 90, 91, 91, 91, 39, 41, 47, 55, 59, 63, 71, 75, 91, 39, 41, 47, 49, 55, 57, 60, 63, 65, 72, 76, 92, 39, 41, 47, 55, 57, 60, 63, 65, 72, 76, 92, 39, 41, 47, 49, 55, 57, 60, 63, 65, 72, 76, 92, 39, 47, 49, 55, 59, 63, 71, 76, 80, 92, 92, 92, 92, 92, 47, 49, 51, 55, 59, 64, 67, 72, 92, 47, 49, 52, 55, 57, 59, 61, 63, 65, 67, 69, 72, 92, 47, 49, 52, 55, 57, 59, 63, 67, 72, 92, 47, 52, 55, 57, 59, 61, 63, 65, 67, 69, 92, 47, 49, 51, 55, 57, 59, 61, 63, 65, 67, 69, 72, 91, 91, 91, 91, 90, 90, 89, 89, 89, 88, 87, 87, 86, 85, 85, 84, 83, 82, 81, 79, 78, 76, 75, 72, 70, 66]
