const CS2 = [54, 50, 48, 45, 44, 42, 41, 39, 38, 37, 36, 35, 35, 34, 33, 33, 32, 31, 31, 31, 30, 30, 29, 29, 29, 29, 56, 59, 62, 64, 68, 28, 54, 58, 60, 64, 66, 28, 54, 56, 60, 64, 67, 28, 54, 56, 58, 60, 62, 64, 66, 28, 56, 58, 60, 62, 64, 68, 28, 28, 28, 28, 28, 55, 58, 60, 64, 67, 28, 54, 56, 58, 60, 62, 66, 68, 28, 54, 56, 58, 60, 63, 67, 28, 54, 56, 58, 60, 62, 66, 68, 29, 55, 59, 64, 66, 68, 29, 29, 29, 30, 30, 31, 31, 31, 32, 33, 33, 34, 35, 35, 36, 37, 38, 39, 41, 42, 44, 45, 48, 50, 54]
const CE2 = [66, 70, 72, 75, 76, 78, 79, 81, 82, 83, 84, 85, 85, 86, 87, 87, 88, 89, 89, 89, 90, 90, 91, 91, 91, 54, 58, 61, 63, 65, 91, 53, 57, 59, 61, 65, 92, 53, 55, 57, 61, 65, 92, 53, 55, 57, 59, 61, 63, 65, 92, 54, 57, 59, 61, 63, 65, 92, 92, 92, 92, 92, 54, 57, 59, 61, 65, 92, 53, 55, 57, 59, 61, 65, 67, 92, 53, 55, 57, 59, 61, 65, 92, 53, 55, 57, 59, 61, 65, 67, 92, 54, 58, 61, 65, 67, 91, 91, 91, 91, 90, 90, 89, 89, 89, 88, 87, 87, 86, 85, 85, 84, 83, 82, 81, 79, 78, 76, 75, 72, 70, 66]
var half: bool = false
var s: string = ""
var cur: float = 0.0

@right out strip0: string = st0
@right out strip1: string = st1
@right out strip2: string = st2
@right out strip3: string = st3
@right out msg_: string = "A/D move  -  new ball every 2 returns"
@right out hud_: string = hudv
