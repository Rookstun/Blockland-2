// GENERATED by rotorraid/gen.mjs from channel.ws.tpl: DMA channel {{K}} (screen rows {{R0}}..{{R1}} of {{W}} x {{H}})
// On a new frame: scrolled island map (pre-shaded spans) into a pixel row, sprites stamped over it in bus order
// (back to front), the row run-length encoded as coloured blocks into a back buffer; shown when go names that frame.
@left in frame: int
@left in camx: int
@left in camy: int
@left in go: int
{{OINS}}

const BL = "{{BL}}"
const COLS = [{{COLS}}]
const MI = [{{MI}}]
const MP = [{{MP}}]
const SRI = [{{SRI}}]
const SRS = [{{SRS}}]
const SP = [{{SP}}]
const SH = [{{SH}}]
const SAX = [{{SAX}}]
const SAY = [{{SAY}}]

var px: int[]
var ox: int[]
var oy: int[]
var os: int[]
var s: string = ""
var cur: int = 0
var st: int = 0
var acc: string = ""
var pbA: string = ""
var fA: int = -1
var pbO: string = ""
var fO: int = -1
var stA: string = ""
var readyO: int = 0

@right out stripA_: string = stA
@right out ready_: int = readyO

mod paint(a: int, b: int, c: int) {
  for x in max(a, 0)..min(b, {{W}}) { px[x] = c }
}
mod row(sr: int) -> string {
  let iy = camy + sr
  if iy >= 0 && iy < {{IH}} {
    for j in MI[iy]..MI[iy + 1] {
      let p = MP[j]
      paint(p % 1024 - camx, (p / 1024) % 1024 - camx, p / 1048576)
    }
  } else { px.fill(0) }
  for k in 0..ox.length() {
    let r = sr - oy.get(k)
    let spr = os.get(k)
    if r >= 0 && r < SH[spr] {
      let rr = SRI[spr] + r
      for j in SRS[rr]..SRS[rr + 1] {
        let p = SP[j]
        paint(ox.get(k) + p % 64, ox.get(k) + (p / 64) % 64, p / 4096)
      }
    }
  }
  s = ""
  cur = px.get(0)
  st = 0
  for x in 1..{{W}} {
    if px.get(x) != cur {
      s = s .. COLS[cur] .. BL.Substring(0, x - st) .. "</>"
      cur = px.get(x)
      st = x
    }
  }
  return s .. COLS[cur] .. BL.Substring(0, {{W}} - st) .. "</>"
}
on Change(frame) {
  pbO = pbA
  fO = fA
  fA = frame
  if px.length() != {{W}} { px.resize({{W}}, 0) }
  ox.resize(0, 0)
  oy.resize(0, 0)
  os.resize(0, 0)
{{OUNPACK}}
  acc = ""
  for j in 0..{{ROWS}} {
    if j < {{ROWS1}} { acc = acc .. row({{R0}} + j) .. "\n" } else { acc = acc .. row({{R0}} + j) }
  }
  pbA = acc
  readyO = frame
}
on Change(go) {
  if go == fA { stA = pbA } else { if go == fO { stA = pbO } }
}
