// GENERATED by rotorraid/gen.mjs from channel.ws.tpl: DMA channel {{K}} (screen rows {{R0}}..{{R1}} of {{W}} x {{H}})
// On a new frame: scrolled island map (pre-shaded spans) into a pixel row, sprites stamped over it in bus order
// (back to front), the row run-length encoded as coloured blocks into a back buffer; shown when go names that frame.
@left in frame: int
@left in camx: int
@left in camy: int
@left in go: int
@left in phase: int
{{OINS}}

const BL = "{{BL}}"
const COLS = [{{COLS}}]
{{CHUNKCONSTS}}
const SRI = [{{SRI}}]
const SRS = [{{SRS}}]
const SH = [{{SH}}]
const SAX = [{{SAX}}]
const SAY = [{{SAY}}]
const SW = [{{SW}}]

var px: int[]
var ox: int[]
var oy: int[]
var os: int[]
var s: string = ""
var cur: int = 0
var st: int = 0
var lo: int = 0
var pc: int = -1
var ps: int = 0
var pe: int = 0
var hi: int = 0
var acc: string = ""
var rs: string[]
var tcache: string[]
var tcx: int[]
var rk1: int[]
var rk2: int[]
var hs: int = 0
var pbA: string = ""
var fA: int = -1
var pbO: string = ""
var fO: int = -1
var stA: string = ""
var readyO: int = 0

@right out stripA_: string = stA
@right out ready_: int = readyO

mod paint(a: int, b: int, c: int) {
  for x in max(a, lo)..min(b, hi) { px[x] = c }
}
// runs are merged with the previous one when the colour carries on (fewer tags = shorter text)
// constant arrays stop working somewhere past ~1-4 k entries (rows read nothing: the bottom half vanished near the tanks),
// so every big table is split into chunks of {{CHUNK}} with a getter
{{CHUNKMODS}}
mod flush() {
  if pe > ps { s = s .. COLS[pc] .. BL.Substring(0, pe - ps) .. "</>" }
  ps = 0
  pe = 0
}
mod put(a: int, b: int, c: int) {
  if b > a {
    if c == pc && a == pe { pe = b } else {
      flush()
      pc = c
      ps = a
      pe = b
    }
  }
}
// terrain runs of image row iy straight to text, screen x0..x1 (no pixel work)
mod terrain(iy: int, x0: int, x1: int) {
  if iy >= 0 && iy < {{IH}} {
    for j in mb(iy * {{NBK1}} + max(x0 + camx, 0) / 64)..me(iy * {{NBK1}} + min((x1 + camx + 63) / 64, {{NBK}})) {
      let p = mp(j)
      put(max(p % 1024 - camx, x0), min((p / 1024) % 1024 - camx, x1), p / 1048576)
    }
  } else { put(x0, x1, 0) }
}
// a row: plain terrain runs, except the x range sprites cover on this row, which is painted per pixel (cheap: small)
mod row(sr: int) -> string {
  let iy = camy + sr
  s = ""
  pc = -1
  ps = 0
  pe = 0
  lo = {{W}}
  hi = 0
  for k in 0..ox.length() {
    let r = sr - oy.get(k)
    if r >= 0 && r < SH[os.get(k)] {
      lo = max(min(lo, ox.get(k)), 0)
      hi = min(max(hi, ox.get(k) + SW[os.get(k)]), {{W}})
    }
  }
  if hi <= lo {
    // scroll reuse (Rookstun, optimisation 2): a plain map row is the same text whenever the camera x is the same,
    // so up/down scrolling just picks rows already built for other screen lines
    if iy >= 0 && iy < {{IH}} {
      if tcx.length() != {{IH}} {
        tcache.resize({{IH}}, "")
        tcx.resize({{IH}}, -1)
      }
      if tcx.get(iy) == camx { return tcache.get(iy) }
    }
    terrain(iy, 0, {{W}})
    flush()
    if iy >= 0 && iy < {{IH}} {
      tcache[iy] = s
      tcx[iy] = camx
    }
    return s
  }
  terrain(iy, 0, lo)
  if iy >= 0 && iy < {{IH}} {
    for j in mb(iy * {{NBK1}} + max(lo + camx, 0) / 64)..me(iy * {{NBK1}} + min((hi + camx + 63) / 64, {{NBK}})) {
      let p = mp(j)
      paint(p % 1024 - camx, (p / 1024) % 1024 - camx, p / 1048576)
    }
  } else { paint(lo, hi, 0) }
  for k in 0..ox.length() {
    let r = sr - oy.get(k)
    let spr = os.get(k)
    if r >= 0 && r < SH[spr] {
      let rr = SRI[spr] + r
      for j in SRS[rr]..SRS[rr + 1] {
        let p = sp(j)
        paint(ox.get(k) + p % 64, ox.get(k) + (p / 64) % 64, p / 4096)
      }
    }
  }
  cur = px.get(lo)
  st = lo
  for x in lo + 1..hi {
    if px.get(x) != cur {
      put(st, x, cur)
      cur = px.get(x)
      st = x
    }
  }
  put(st, hi, cur)
  terrain(iy, hi, {{W}})
  flush()
  return s
}
mod draw() {
  pbO = pbA
  fO = fA
  fA = frame
  if px.length() != {{W}} { px.resize({{W}}, 0) }
  ox.resize(0, 0)
  oy.resize(0, 0)
  os.resize(0, 0)
{{OUNPACK}}
  // row cache (Rookstun, optimisation 1): a row is rebuilt only when the camera or the sprites crossing it changed
  if rs.length() != {{ROWS}} {
    rs.resize({{ROWS}}, "")
    rk1.resize({{ROWS}}, -1)
    rk2.resize({{ROWS}}, -1)
  }
  acc = ""
  for j in 0..{{ROWS}} {
    let sr = {{R0}} + j
    hs = 7
    for k in 0..ox.length() {
      let r = sr - oy.get(k)
      if r >= 0 && r < SH[os.get(k)] { hs = (hs * 31 + (ox.get(k) + 512) * 1009 + r * 37 + os.get(k) * 7919) % 1000000007 }
    }
    if rk1.get(j) != camx * 4096 + camy || rk2.get(j) != hs {
      rs[j] = row(sr)
      rk1[j] = camx * 4096 + camy
      rk2[j] = hs
    }
    if j < {{ROWS1}} { acc = acc .. rs.get(j) .. "\n" } else { acc = acc .. rs.get(j) }
  }
  pbA = acc
  readyO = frame
}
// the server's wire budget is shared by every chip in a tick (ch5-9 got nothing once 0-4 had drawn), so each
// channel draws on its own phase tick of the 3-tick frame: a third of the channels per tick
on Change(phase) {
  if phase == {{PH}} && frame != fA { draw() }
}
on Change(go) {
  if go == fA { stA = pbA } else { if go == fO { stA = pbO } }
}
