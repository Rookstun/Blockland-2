// on the screen the player sees (camera from the last frame, a few px margin): only these can be aimed at or act
mod onScreen(x: float, y: float, m: float) -> bool {
  let sx = (x - y) * {{MSC}}.0 + {{MOX}}.0 - camxO
  let sy = (x + y) * {{HSC}}.0 + {{MOY}}.0 - camyO
  return sx > 0.0 - m && sx < {{W}}.0 + m && sy > 0.0 - m && sy < {{H}}.0 + m
}
// a ground target worth locking: alive, within 7 tiles and in front (within ~60 deg of the nose)
mod inFront(j: int) -> bool {
  if j < 0 || j >= ek.length() { return false }
  if ehp.get(j) <= 0 { return false }
  if onScreen(ex.get(j), ey.get(j), 0.0) == false { return false } // off screen = can't be aimed at (Rookstun)
  let tx = ex.get(j) - hx
  let ty = ey.get(j) - hy
  let td = sqrt(tx * tx + ty * ty)
  if td < 0.05 { return false } // no range limit: a locked target is hit wherever it is (Rookstun)
  return (tx * DX[hd] + ty * DY[hd]) / td > 0.17 // the guns swing through 160 deg (Rookstun): +-80 from the nose
}
mod shoot(kind: int) {
  // reuse a dead slot, else push
  var slot: int = -1
  slot = -1
  for i in 0..slife.length() {
    if slot < 0 && slife.get(i) <= 0 { slot = i }
  }
  if slot < 0 {
    sbx.push(0.0)
    sby.push(0.0)
    sdx.push(0.0)
    sdy.push(0.0)
    slife.push(0)
    skind.push(0)
    sdir.push(0)
    sz.push(0.0)
    szd.push(0.0)
    stg.push(-1)
    slot = slife.length() - 1
  }
  let sp = if kind == 0 then 0.42 else 0.3
  sbx[slot] = hx + DX[hd] * 0.6
  sby[slot] = hy + DY[hd] * 0.6
  sdx[slot] = DX[hd] * sp
  sdy[slot] = DY[hd] * sp
  // aim by turning (Rookstun): a live ground target within 7 tiles and ~30 deg of the nose gets the shot steered at it,
  // so the gun's downward angle never has to be managed by hand
  var bestc: float = 0.0
  var bj: int = -1
  bestc = if kind == 0 then 0.17 else 0.87 // guns 160 deg arc, missiles ~60 deg
  bj = -1
  for j in 0..ek.length() {
    if ehp.get(j) > 0 {
      let tx = ex.get(j) - hx
      let ty = ey.get(j) - hy
      let td = sqrt(tx * tx + ty * ty)
      if td > 0.05 && td < 7.0 && onScreen(ex.get(j), ey.get(j), 0.0) {
        let c = (tx * DX[hd] + ty * DY[hd]) / td
        if c > bestc {
          bestc = c
          bj = j
        }
      }
    }
  }
  if inFront(tgt) { bj = tgt }
  sz[slot] = hz * 0.85
  szd[slot] = 0.0
  stg[slot] = -1
  if bj >= 0 {
    stg[slot] = bj
    let tx = ex.get(bj) - hx
    let ty = ey.get(bj) - hy
    let td = sqrt(tx * tx + ty * ty)
    sdx[slot] = tx / td * sp
    sdy[slot] = ty / td * sp
    szd[slot] = 0.0 - (hz * 0.85 - 0.05) / max(td / sp, 1.0)
  }
  // tracer drawn along the way the round really flies (nearest of 8 headings), not the nose
  var bd: int = 0
  bd = 0
  for k in 1..{{NTR}} {
    if TX[k] * sdx.get(slot) + TY[k] * sdy.get(slot) > TX[bd] * sdx.get(slot) + TY[bd] * sdy.get(slot) { bd = k }
  }
  sdir[slot] = bd
  slife[slot] = if kind == 0 then 16 else 26
  if stg.get(slot) >= 0 { slife[slot] = floor(sqrt((ex.get(stg.get(slot)) - hx) * (ex.get(stg.get(slot)) - hx) + (ey.get(stg.get(slot)) - hy) * (ey.get(stg.get(slot)) - hy)) / sp) + 4 }
  skind[slot] = kind
}
mod eshoot(i: int) {
  let dx = hx - ex.get(i)
  let dy = hy - ey.get(i)
  let d = max(sqrt(dx * dx + dy * dy), 0.01)
  var slot: int = -1
  slot = -1
  for j in 0..qlife.length() {
    if slot < 0 && qlife.get(j) <= 0 { slot = j }
  }
  if slot < 0 {
    qx.push(0.0)
    qy.push(0.0)
    qdx.push(0.0)
    qdy.push(0.0)
    qlife.push(0)
    qd.push(0)
    qz.push(0.0)
    qdz.push(0.0)
    slot = qlife.length() - 1
  }
  qx[slot] = ex.get(i)
  qy[slot] = ey.get(i)
  qdx[slot] = dx / d * 0.15
  qdy[slot] = dy / d * 0.15
  qlife[slot] = 70
  // the soldier fires from chest height (Rookstun: they fired too high) and the round climbs to the helicopter's height
  // by the time it covers the distance; tracer points along the nearest of the 8 headings
  qz[slot] = 0.15
  qdz[slot] = (hz - 0.15) / max(d / 0.15, 1.0)
  var best: int = 0
  best = 0
  for k in 1..{{NTR}} {
    if TX[k] * dx + TY[k] * dy > TX[best] * dx + TY[best] * dy { best = k }
  }
  qd[slot] = best
}
mod crash(why: string) {
  mode = 3
  timer = 40
  boom(hx, hy)
  sadTune()
  titlev = ""
  msgv = why .. "   SPACE: try again"
}
mod step() {
  tk += 1
  // sound: tune queue, else blips
  if melPos < mel.length() {
    aP0 = max(mel.get(melPos), 0.1)
    aV0 = if mel.get(melPos) > 0.0 then 0.5 else 0.0
    melPos += 1
  } else { if beep > 0 {
    aP0 = sb
    aV0 = 0.35
    beep -= 1
  } else { aV0 = 0.0 } }
  let pa = ba && lastBa == false
  let pb = bb && lastBb == false
  let pq = bq && lastBq == false
  lastBa = ba
  lastBb = bb
  lastBq = bq
  let pr = rmb && lastRmb == false
  lastRmb = rmb
  if mode == 0 {
    if pa {
      mode = 1
      page = 0
      titlev = ""
      msgv = BRIEF[0]
    }
    return
  }
  if mode == 1 {
    if pa {
      page += 1
      if page < {{NBRIEF}} { msgv = BRIEF[page] } else {
        mode = 2
        msgv = "WASD fly   LMB/E guns   SPACE missile   RMB lock   Q land / lift off"
        landing = 1
      }
    }
    return
  }
  if mode >= 3 {
    if timer > 0 { timer -= 1 }
    if timer == 0 && pa {
      reset()
      mode = 1
      page = 0
      msgv = BRIEF[0]
    }
  }
  hvx = 0.0
  hvy = 0.0
  hvz = 0.0
  lastLT = ServerUptime()
  if mode == 2 {
    // ---- helicopter
    if landing == 1 {
      hz = min(hz + 0.04, 1.0)
      hvz = if hz < 1.0 then 0.04 else 0.0
      if hz >= 1.0 { landing = 0 }
    }
    if landing == -1 {
      hz = max(hz - 0.04, 0.0)
      hvz = if hz > 0.0 then -0.04 else 0.0
      if hz <= 0.0 {
        landing = 0
        mvx = 0.0
        mvy = 0.0
      }
    }
    if pq {
      if hz <= 0.0 { landing = 1 } else { if hz >= 1.0 {
        let t = tileAt(hx, hy)
        if t == 0 || t == 1 || t == 4 || t == 9 || t == 10 { msgv = "{{NOLAND}}" } else { landing = -1 }
      } }
    }
    if hz >= 1.0 {
      let sx = (if right then 1 else 0) - (if left then 1 else 0)
      let sy = (if down then 1 else 0) - (if up then 1 else 0)
      let d = DIRT[(sx + 1) * 3 + sy + 1]
      // inertia (Rookstun): the nose turns at once, but speed eases toward the stick (or to a hover) about 8% a tick
      var tvx: float = 0.0
      var tvy: float = 0.0
      tvx = 0.0
      tvy = 0.0
      if d >= 0 {
        hd = d
        tvx = DX[d] * 0.085
        tvy = DY[d] * 0.085
      }
      mvx = mvx + (tvx - mvx) * 0.08
      mvy = mvy + (tvy - mvy) * 0.08
      hvx = mvx
      hvy = mvy
      hx = min(max(hx + mvx, 0.5), {{MW}}.0 - 0.5)
      hy = min(max(hy + mvy, 0.5), {{MH}}.0 - 0.5)
      // right mouse: lock the next target in front (cycles), none left = unlock
      // right mouse: any live target within 10 tiles, in any direction (Rookstun), ordered by how close it is to
      // where the nose points (then distance); each click steps to the next in that order, wrapping round
      if pr {
        ck.resize(0, 0.0)
        cj.resize(0, 0.0)
        for j in 0..ek.length() {
          if ehp.get(j) > 0 {
            let tx = ex.get(j) - hx
            let ty = ey.get(j) - hy
            let td = sqrt(tx * tx + ty * ty)
            if td > 0.05 && td < 10.0 && onScreen(ex.get(j), ey.get(j), 0.0) {
              ck.push(floor((1.0 - (tx * DX[hd] + ty * DY[hd]) / td) * 8.0) * 100.0 + td)
              cj.push(j)
            }
          }
        }
        ck.sortMultiple(cj)
        var pos: int = -1
        pos = -1
        for k in 0..cj.length() {
          if floor(cj.get(k)) == tgt { pos = k }
        }
        tgt = if cj.length() == 0 then -1 else floor(cj.get((pos + 1) % cj.length()))
        sb = 1.8
        beep = 1
      }
      if tgt >= 0 && (ehp.get(tgt) <= 0 || onScreen(ex.get(tgt), ey.get(tgt), 0.0) == false) { tgt = -1 } // lock lost when it leaves the screen
      if gcd > 0 { gcd -= 1 }
      // LMB/E = guns (held), SPACE = missiles (Rookstun)
      if bb && gcd == 0 && gunA > 0 {
        shoot(0)
        gunA -= 1
        gcd = 3
        sb = 2.2
        beep = 1
      }
      if pa && msl > 0 {
        shoot(1)
        msl -= 1
        sb = 0.9
        beep = 3
      }
    }
    if hz > 0.0 {
      fc += 1
      if fc >= 30 {
        fc = 0
        fuel -= 1
        if fuel <= 0 { crash("{{NOFUEL}}") }
      }
    }
    let here = tileAt(hx, hy)
    if hz <= 0.0 && (here == 7 || here == 8) {
      if tk % 2 == 0 && fuel < 100 { fuel += 1 }
      if tk % 10 == 0 && armor < 10 { armor += 1 }
      gunA = 200
      msl = 8
      if onboard > 0 {
        rescued += onboard
        onboard = 0
        msgv = "{{DELIVER}}"
        happyTune()
      }
    }
    // ---- people walk to a landed helicopter and climb in
    for i in 0..pst.length() {
      if pst.get(i) < 2 && hz <= 0.0 {
        let dx = hx - ppx.get(i)
        let dy = hy - ppy.get(i)
        let d = sqrt(dx * dx + dy * dy)
        if d < 3.0 {
          pst[i] = 1
          if d < 0.35 {
            pst[i] = 2
            onboard += 1
            msgv = "{{BOARD}}"
            sb = 1.5
            beep = 2
          } else {
            ppx[i] = ppx.get(i) + dx / d * 0.035
            ppy[i] = ppy.get(i) + dy / d * 0.035
          }
        }
      }
      if pst.get(i) == 1 && hz > 0.0 { pst[i] = 0 }
    }
    // ---- player shots
    for i in 0..slife.length() {
      if slife.get(i) > 0 {
        slife[i] = slife.get(i) - 1
        // a round fired at a target homes on it every tick, so it lands whatever the distance or the target's motion
        let g = stg.get(i)
        if g >= 0 && ehp.get(g) > 0 {
          let gx = ex.get(g) - sbx.get(i)
          let gy = ey.get(g) - sby.get(i)
          let gd = max(sqrt(gx * gx + gy * gy), 0.001)
          let sp2 = sqrt(sdx.get(i) * sdx.get(i) + sdy.get(i) * sdy.get(i))
          sdx[i] = gx / gd * sp2
          sdy[i] = gy / gd * sp2
        }
        sbx[i] = sbx.get(i) + sdx.get(i)
        sby[i] = sby.get(i) + sdy.get(i)
        // shots dive from the helicopter to the ground: hits are tested at ground level, so the tracer has to be drawn
        // there too (Rookstun: had to aim way above their heads when it flew at a fixed height)
        sz[i] = max(sz.get(i) + szd.get(i), 0.05) // locked shots dive to their ground target, free shots fly level
        for j in 0..ek.length() {
          if slife.get(i) > 0 && ehp.get(j) > 0 {
            // hitboxes match the sprites (Rookstun): sandbag post ~5 px, tank ~8 px, factory ~2 tiles; the test is swept
            // along this tick's flight so a fast shot can't skip over a small target
            let ax = sbx.get(i) - sdx.get(i)
            let ay = sby.get(i) - sdy.get(i)
            let t = min(max(((ex.get(j) - ax) * sdx.get(i) + (ey.get(j) - ay) * sdy.get(i)) / max(sdx.get(i) * sdx.get(i) + sdy.get(i) * sdy.get(i), 0.0001), 0.0), 1.0)
            let dx = ax + sdx.get(i) * t - ex.get(j)
            let dy = ay + sdy.get(i) * t - ey.get(j)
            let r = if ek.get(j) == 2 then 0.95 else (if ek.get(j) == 1 then 0.32 else 0.22)
            if dx * dx + dy * dy < r * r {
              ehp[j] = ehp.get(j) - (if skind.get(i) == 1 then 4 else 1)
              slife[i] = 0
              if skind.get(i) == 1 { boom(sbx.get(i), sby.get(i)) }
              if ehp.get(j) <= 0 {
                boom(ex.get(j), ey.get(j))
                boomTune()
                if ek.get(j) == 2 {
                  fleft -= 1
                  msgv = "{{FACTORY}}"
                }
              }
            }
          }
        }
      }
    }
    // ---- enemies: tanks patrol, guns and tanks shoot at a flying helicopter in range
    for i in 0..ek.length() {
      // off-screen enemies sleep (no patrol, no shooting): less work per tick, nothing fires at you from off screen
      if ehp.get(i) > 0 && onScreen(ex.get(i), ey.get(i), 24.0) {
        if ek.get(i) == 1 {
          var p: float = 0.0
          p = ep.get(i) + edr.get(i) * 0.01
          if p > 1.0 {
            p = 1.0
            edr[i] = -1.0
          }
          if p < 0.0 {
            p = 0.0
            edr[i] = 1.0
          }
          ep[i] = p
          ex[i] = eax.get(i) + (ebx.get(i) - eax.get(i)) * p
          ey[i] = eay.get(i) + (eby.get(i) - eay.get(i)) * p
        }
        if ek.get(i) != 2 {
          ecd[i] = ecd.get(i) - 1
          let dx = hx - ex.get(i)
          let dy = hy - ey.get(i)
          if ecd.get(i) <= 0 && hz > 0.3 && dx * dx + dy * dy < 36.0 {
            eshoot(i)
            ecd[i] = 34 + floor(Random(0.0, 24.0))
          }
        }
      }
    }
    // ---- enemy shots
    for i in 0..qlife.length() {
      if qlife.get(i) > 0 {
        qlife[i] = qlife.get(i) - 1
        qx[i] = qx.get(i) + qdx.get(i)
        qy[i] = qy.get(i) + qdy.get(i)
        qz[i] = min(max(qz.get(i) + qdz.get(i), 0.0), 1.0)
        let dx = qx.get(i) - hx
        let dy = qy.get(i) - hy
        if mode == 2 && hz > 0.3 && dx * dx + dy * dy < 0.2 { // helicopter hitbox ~0.45 tile (its ~15 px body)
          qlife[i] = 0
          armor -= 1
          sb = 0.5
          beep = 3
          if armor <= 0 { crash("{{SHOTDOWN}}") }
        }
      }
    }
    if mode == 2 && fleft == 0 && rescued >= {{NPEOPLE}} {
      mode = 4
      timer = 40
      happyTune()
      msgv = {{WIN}}
    }
  }
  for i in 0..xt.length() {
    if xt.get(i) > 0 { xt[i] = xt.get(i) - 1 }
  }
  var extra: string = ""
  extra = ""
  if onboard > 0 { extra = "  (+${onboard} aboard)" }
  if tgt >= 0 { extra = extra .. (if ek.get(tgt) == 2 then "  LOCK: FACTORY" else (if ek.get(tgt) == 1 then "  LOCK: TANK" else "  LOCK: GUN POST")) }
  hudv = "ARMOR ${armor}  FUEL ${fuel}  GUN ${gunA}  MSL ${msl}     FACTORIES ${3 - fleft}/3  RESCUED ${rescued}/{{NPEOPLE}}${extra}"
}
// screen position of a world point (image pixels), packed with a sprite id for the bus
mod put(x: float, y: float, z: float, spr: int, key: float) {
  let sx = floor((x - y) * {{MSC}}.0 + {{MOX}}.0 + 0.5) - camxO
  let sy = floor((x + y) * {{HSC}}.0 - z * {{MSC}}.0 + {{MOY}}.0 + 0.5) - camyO
  if sx > -60 && sx < {{W}} + 60 && sy > -60 && sy < {{H}} + 80 {
    keys.push(key)
    vals.push((sx + 128) + (sy + 128) * 512 + spr * 262144)
  }
}
mod bus() {
  // draw between game ticks: the helicopter and shots move on by their speed x the time since the last tick
  fr = min(max((ServerUptime() - lastLT) * 20.0, 0.0), 1.0)
  let rx = hx + hvx * fr
  let ry = hy + hvy * fr
  let rz = hz + hvz * fr
  let ix = (rx - ry) * {{MSC}}.0 + {{MOX}}.0
  let iy = (rx + ry) * {{HSC}}.0 - rz * {{MSC}}.0 + {{MOY}}.0
  // same rounding as put(): the helicopter stays on one screen pixel instead of twitching (up/down moves half a px a tick)
  camxO = min(max(floor(ix + 0.5) - {{HALFW}}, 0), {{IW}} - {{W}})
  camyO = min(max(floor(iy + 0.5) - {{HALFH}}, 0), {{IH}} - {{H}})
  keys.resize(0, 0.0)
  vals.resize(0, 0.0)
  for i in 0..ek.length() {
    let k = ek.get(i)
    let dead = ehp.get(i) <= 0
    var spr: int = 0
    spr = 0
    if k == 0 { spr = if dead then {{S_GUNDEAD}} else {{S_GUN}} }
    if k == 2 { spr = if dead then {{S_FACTDEAD}} else {{S_FACT}} }
    if k == 1 {
      spr = {{S_TANK}} + (if eax.get(i) == ebx.get(i) then (if edr.get(i) > 0.0 then 1 else 3) else (if edr.get(i) > 0.0 then 0 else 2))
    }
    if k != 1 || dead == false { put(ex.get(i), ey.get(i), 0.0, spr, ex.get(i) + ey.get(i)) }
  }
  for i in 0..pst.length() {
    if pst.get(i) < 2 { put(ppx.get(i), ppy.get(i), 0.0, {{S_PERSON}} + (if pst.get(i) == 0 && (tk / 8 + i) % 2 == 0 then 1 else 0), ppx.get(i) + ppy.get(i)) }
  }
  for i in 0..xt.length() {
    if xt.get(i) > 0 { put(xx.get(i), xy.get(i), 0.4, if xt.get(i) > 6 then {{S_BOOM0}} else {{S_BOOM1}}, xx.get(i) + xy.get(i) + 0.3) }
  }
  for i in 0..qlife.length() {
    if qlife.get(i) > 0 { put(qx.get(i) + qdx.get(i) * fr, qy.get(i) + qdy.get(i) * fr, qz.get(i), {{S_EBULLET}} + qd.get(i), 900.0) }
  }
  for i in 0..slife.length() {
    if slife.get(i) > 0 { put(sbx.get(i) + sdx.get(i) * fr, sby.get(i) + sdy.get(i) * fr, sz.get(i), if skind.get(i) == 1 then {{S_MISSILE}} else {{S_BULLET}} + sdir.get(i), 901.0) }
  }
  if tgt >= 0 && mode == 2 { put(ex.get(tgt), ey.get(tgt), 0.0, {{S_LOCK}}, 899.0) }
  if mode != 3 {
    put(rx, ry, 0.0, {{S_SHADOW}}, rx + ry - 0.05)
    put(rx, ry, rz, hd * 2 + (if hz > 0.0 then tk % 2 else 0), 1000.0)
  }
  keys.sortMultiple(vals)
  let n = vals.length()
  let base = max(n - {{NOB}}, 0)
{{OASSIGN}}
  frameO += 1
}

on tick {
  if seated {
    if was == false {
      was = true
      reset()
      mode = 0
      titlev = "ROTOR RAID"
      hudv = ""
      msgv = "SPACE: start"
    }
    step()
  } else {
    if was {
      was = false
      aV0 = 0.0
      titlev = "ROTOR RAID"
      hudv = ""
      msgv = ""
      mode = 0
      reset()
      bus()
    }
  }
}
on Change(seated) {
  if seated == false && was {
    was = false
    aV0 = 0.0
    titlev = "ROTOR RAID"
    hudv = ""
    msgv = ""
    mode = 0
    reset()
    bus()
  }
}
// drawing runs on its own free clock (Rookstun: 10 ms render clock, game clock 50 ms): bus on phase 0, the channels
// draw in thirds on phases 0, 1, 2 (the per-tick wire budget is shared), positions extrapolated from the last game tick
on rtick {
  if was {
    rph = (rph + 1) % 3
    if rph == 0 { bus() }
    phaseO = rph
  }
}
