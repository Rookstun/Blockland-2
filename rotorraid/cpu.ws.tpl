mod tileAt(x: float, y: float) -> int {
  let tx = floor(x)
  let ty = floor(y)
  if tx < 0 || ty < 0 || tx >= {{MW}} || ty >= {{MH}} { return 0 }
  return TILE[ty * {{MW}} + tx]
}
