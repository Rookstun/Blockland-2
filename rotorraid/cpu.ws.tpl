mod tileAt(x: float, y: float) -> int {
  let tx = floor(x)
  let ty = floor(y)
  if tx < 0 || ty < 0 || tx >= {{MW}} || ty >= {{MH}} { return 0 }
  return TILE[ty * {{MW}} + tx]
}
mod note(p: float, n: int) {
  for k in 0..n { mel.push(p) }
}
mod boomTune() {
  mel.resize(0, 0.0)
  melPos = 0
  note(0.35, 2)
  note(0.3, 2)
  note(0.25, 3)
}
mod happyTune() {
  mel.resize(0, 0.0)
  melPos = 0
  note(1.0, 2)
  note(1.26, 2)
  note(1.5, 3)
}
mod sadTune() {
  mel.resize(0, 0.0)
  melPos = 0
  note(0.6, 4)
  note(0.5, 4)
  note(0.4, 8)
}
mod boom(x: float, y: float) {
  xx.push(x)
  xy.push(y)
  xt.push(12)
}
mod enemy(k: int, x: float, y: float, hp: int, ax: float, ay: float, bx: float, by: float) {
  ek.push(k)
