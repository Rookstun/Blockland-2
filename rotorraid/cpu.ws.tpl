mod shoot(kind: int) {
  // reuse a dead slot, else push
  var slot: int = -1
  slot = -1
  for i in 0..slife.length() {
    if slot < 0 && slife.get(i) <= 0 { slot = i }
  }
  if slot < 0 {
    sbx.push(0.0)
    sby.push(0.0)
    sdx.push(0.0)
    sdy.push(0.0)
    slife.push(0)
    skind.push(0)
    slot = slife.length() - 1
  }
  let sp = if kind == 0 then 0.42 else 0.3
  sbx[slot] = hx + DX[hd] * 0.6
  sby[slot] = hy + DY[hd] * 0.6
  sdx[slot] = DX[hd] * sp
  sdy[slot] = DY[hd] * sp
  slife[slot] = if kind == 0 then 16 else 26
  skind[slot] = kind
}
mod eshoot(i: int) {
  let dx = hx - ex.get(i)
  let dy = hy - ey.get(i)
  let d = max(sqrt(dx * dx + dy * dy), 0.01)
  var slot: int = -1
  slot = -1
  for j in 0..qlife.length() {
    if slot < 0 && qlife.get(j) <= 0 { slot = j }
  }
  if slot < 0 {
    qx.push(0.0)
    qy.push(0.0)
    qdx.push(0.0)
    qdy.push(0.0)
    qlife.push(0)
    slot = qlife.length() - 1
  }
  qx[slot] = ex.get(i)
  qy[slot] = ey.get(i)
  qdx[slot] = dx / d * 0.15
  qdy[slot] = dy / d * 0.15
  qlife[slot] = 70
}
mod crash(why: string) {
  mode = 3
  timer = 40
  boom(hx, hy)
  sadTune()
  titlev = ""
  msgv = why .. "   SPACE: try again"
}
mod step() {
  tk += 1
  // sound: tune queue, else blips
  if melPos < mel.length() {
    aP0 = max(mel.get(melPos), 0.1)
    aV0 = if mel.get(melPos) > 0.0 then 0.5 else 0.0
    melPos += 1
  } else { if beep > 0 {
    aP0 = sb
    aV0 = 0.35
    beep -= 1
  } else { aV0 = 0.0 } }
  let pa = ba && lastBa == false
  let pb = bb && lastBb == false
  let pq = bq && lastBq == false
  lastBa = ba
  lastBb = bb
  lastBq = bq
  if mode == 0 {
    if pa {
      mode = 1
      page = 0
      titlev = ""
      msgv = BRIEF[0]
    }
    return
  }
  if mode == 1 {
    if pa {
      page += 1
      if page < {{NBRIEF}} { msgv = BRIEF[page] } else {
        mode = 2
        msgv = "WASD fly   SPACE gun   E missile   Q land / lift off"
        landing = 1
      }
    }
    return
  }
  if mode >= 3 {
    if timer > 0 { timer -= 1 }
    if timer == 0 && pa {
      reset()
      mode = 1
      page = 0
      msgv = BRIEF[0]
    }
  }
  hvx = 0.0
  hvy = 0.0
  hvz = 0.0
  lastLT = ServerUptime()
  if mode == 2 {
    // ---- helicopter
    if landing == 1 {
      hz = min(hz + 0.04, 1.0)
      hvz = if hz < 1.0 then 0.04 else 0.0
      if hz >= 1.0 { landing = 0 }
    }
    if landing == -1 {
      hz = max(hz - 0.04, 0.0)
      hvz = if hz > 0.0 then -0.04 else 0.0
      if hz <= 0.0 { landing = 0 }
    }
    if pq {
      if hz <= 0.0 { landing = 1 } else { if hz >= 1.0 {
        let t = tileAt(hx, hy)
        if t == 0 || t == 1 || t == 4 || t == 9 || t == 10 { msgv = "{{NOLAND}}" } else { landing = -1 }
      } }
    }
    if hz >= 1.0 {
      let sx = (if right then 1 else 0) - (if left then 1 else 0)
      let sy = (if down then 1 else 0) - (if up then 1 else 0)
      let d = DIRT[(sx + 1) * 3 + sy + 1]
      if d >= 0 {
        hd = d
        hvx = DX[d] * 0.085
        hvy = DY[d] * 0.085
        hx = min(max(hx + DX[d] * 0.085, 0.5), {{MW}}.0 - 0.5)
        hy = min(max(hy + DY[d] * 0.085, 0.5), {{MH}}.0 - 0.5)
      }
      if gcd > 0 { gcd -= 1 }
      if ba && gcd == 0 && gunA > 0 {
        shoot(0)
        gunA -= 1
        gcd = 3
        sb = 2.2
        beep = 1
      }
      if pb && msl > 0 {
        shoot(1)
        msl -= 1
        sb = 0.9
        beep = 3
      }
    }
    if hz > 0.0 {
      fc += 1
      if fc >= 30 {
        fc = 0
        fuel -= 1
        if fuel <= 0 { crash("{{NOFUEL}}") }
      }
    }
    let here = tileAt(hx, hy)
    if hz <= 0.0 && (here == 7 || here == 8) {
      if tk % 2 == 0 && fuel < 100 { fuel += 1 }
      if tk % 10 == 0 && armor < 10 { armor += 1 }
      gunA = 200
      msl = 8
      if onboard > 0 {
        rescued += onboard
        onboard = 0
        msgv = "{{DELIVER}}"
        happyTune()
      }
    }
    // ---- people walk to a landed helicopter and climb in
    for i in 0..pst.length() {
      if pst.get(i) < 2 && hz <= 0.0 {
        let dx = hx - ppx.get(i)
        let dy = hy - ppy.get(i)
        let d = sqrt(dx * dx + dy * dy)
        if d < 3.0 {
          pst[i] = 1
          if d < 0.35 {
            pst[i] = 2
            onboard += 1
            msgv = "{{BOARD}}"
            sb = 1.5
            beep = 2
          } else {
            ppx[i] = ppx.get(i) + dx / d * 0.035
            ppy[i] = ppy.get(i) + dy / d * 0.035
          }
        }
      }
      if pst.get(i) == 1 && hz > 0.0 { pst[i] = 0 }
    }
    // ---- player shots
    for i in 0..slife.length() {
      if slife.get(i) > 0 {
        slife[i] = slife.get(i) - 1
        sbx[i] = sbx.get(i) + sdx.get(i)
        sby[i] = sby.get(i) + sdy.get(i)
        for j in 0..ek.length() {
          if slife.get(i) > 0 && ehp.get(j) > 0 {
            let dx = sbx.get(i) - ex.get(j)
            let dy = sby.get(i) - ey.get(j)
            let r = if ek.get(j) == 2 then 1.0 else 0.55
            if dx * dx + dy * dy < r * r {
              ehp[j] = ehp.get(j) - (if skind.get(i) == 1 then 4 else 1)
              slife[i] = 0
              if skind.get(i) == 1 { boom(sbx.get(i), sby.get(i)) }
              if ehp.get(j) <= 0 {
                boom(ex.get(j), ey.get(j))
                boomTune()
                if ek.get(j) == 2 {
                  fleft -= 1
                  msgv = "{{FACTORY}}"
                }
              }
            }
          }
        }
      }
    }
    // ---- enemies: tanks patrol, guns and tanks shoot at a flying helicopter in range
    for i in 0..ek.length() {
      if ehp.get(i) > 0 {
        if ek.get(i) == 1 {
          var p: float = 0.0
          p = ep.get(i) + edr.get(i) * 0.01
          if p > 1.0 {
            p = 1.0
            edr[i] = -1.0
          }
          if p < 0.0 {
            p = 0.0
            edr[i] = 1.0
          }
          ep[i] = p
          ex[i] = eax.get(i) + (ebx.get(i) - eax.get(i)) * p
          ey[i] = eay.get(i) + (eby.get(i) - eay.get(i)) * p
        }
        if ek.get(i) != 2 {
          ecd[i] = ecd.get(i) - 1
          let dx = hx - ex.get(i)
          let dy = hy - ey.get(i)
          if ecd.get(i) <= 0 && hz > 0.3 && dx * dx + dy * dy < 36.0 {
            eshoot(i)
            ecd[i] = 34 + floor(Random(0.0, 24.0))
          }
        }
      }
    }
    // ---- enemy shots
    for i in 0..qlife.length() {
      if qlife.get(i) > 0 {
        qlife[i] = qlife.get(i) - 1
        qx[i] = qx.get(i) + qdx.get(i)
        qy[i] = qy.get(i) + qdy.get(i)
        let dx = qx.get(i) - hx
        let dy = qy.get(i) - hy
        if mode == 2 && hz > 0.3 && dx * dx + dy * dy < 0.36 {
          qlife[i] = 0
          armor -= 1
          sb = 0.5
          beep = 3
          if armor <= 0 { crash("{{SHOTDOWN}}") }
        }
      }
    }
    if mode == 2 && fleft == 0 && rescued >= {{NPEOPLE}} {
      mode = 4
      timer = 40
      happyTune()
      msgv = {{WIN}}
    }
  }
  for i in 0..xt.length() {
    if xt.get(i) > 0 { xt[i] = xt.get(i) - 1 }
  }
  var extra: string = ""
  extra = ""
  if onboard > 0 { extra = "  (+${onboard} aboard)" }
  hudv = "ARMOR ${armor}  FUEL ${fuel}  GUN ${gunA}  MSL ${msl}     FACTORIES ${3 - fleft}/3  RESCUED ${rescued}/{{NPEOPLE}}${extra}"
}
// screen position of a world point (image pixels), packed with a sprite id for the bus
mod put(x: float, y: float, z: float, spr: int, key: float) {
  let sx = floor((x - y) * {{MSC}}.0 + {{MOX}}.0 + 0.5) - camxO
  let sy = floor((x + y) * {{HSC}}.0 - z * {{MSC}}.0 + {{MOY}}.0 + 0.5) - camyO
  if sx > -60 && sx < {{W}} + 60 && sy > -60 && sy < {{H}} + 80 {
    keys.push(key)
    vals.push((sx + 128) + (sy + 128) * 512 + spr * 262144)
  }
}
mod bus() {
  // draw between game ticks: the helicopter and shots move on by their speed x the time since the last tick
  fr = min(max((ServerUptime() - lastLT) * 20.0, 0.0), 1.0)
  let rx = hx + hvx * fr
  let ry = hy + hvy * fr
  let rz = hz + hvz * fr
  let ix = (rx - ry) * {{MSC}}.0 + {{MOX}}.0
  let iy = (rx + ry) * {{HSC}}.0 - rz * {{MSC}}.0 + {{MOY}}.0
  camxO = min(max(floor(ix) - {{HALFW}}, 0), {{IW}} - {{W}})
  camyO = min(max(floor(iy) - {{HALFH}}, 0), {{IH}} - {{H}})
  keys.resize(0, 0.0)
  vals.resize(0, 0.0)
  for i in 0..ek.length() {
    let k = ek.get(i)
    let dead = ehp.get(i) <= 0
    var spr: int = 0
    spr = 0
    if k == 0 { spr = if dead then {{S_GUNDEAD}} else {{S_GUN}} }
    if k == 2 { spr = if dead then {{S_FACTDEAD}} else {{S_FACT}} }
    if k == 1 {
      spr = {{S_TANK}} + (if eax.get(i) == ebx.get(i) then (if edr.get(i) > 0.0 then 1 else 3) else (if edr.get(i) > 0.0 then 0 else 2))
    }
    if k != 1 || dead == false { put(ex.get(i), ey.get(i), 0.0, spr, ex.get(i) + ey.get(i)) }
  }
  for i in 0..pst.length() {
    if pst.get(i) < 2 { put(ppx.get(i), ppy.get(i), 0.0, {{S_PERSON}} + (if pst.get(i) == 0 && (tk / 8 + i) % 2 == 0 then 1 else 0), ppx.get(i) + ppy.get(i)) }
  }
  for i in 0..xt.length() {
    if xt.get(i) > 0 { put(xx.get(i), xy.get(i), 0.4, if xt.get(i) > 6 then {{S_BOOM0}} else {{S_BOOM1}}, xx.get(i) + xy.get(i) + 0.3) }
  }
  for i in 0..qlife.length() {
    if qlife.get(i) > 0 { put(qx.get(i) + qdx.get(i) * fr, qy.get(i) + qdy.get(i) * fr, 0.8, {{S_EBULLET}}, 900.0) }
  }
  for i in 0..slife.length() {
    if slife.get(i) > 0 { put(sbx.get(i) + sdx.get(i) * fr, sby.get(i) + sdy.get(i) * fr, 0.9, if skind.get(i) == 1 then {{S_MISSILE}} else {{S_BULLET}}, 901.0) }
  }
  if mode != 3 {
    put(rx, ry, 0.0, {{S_SHADOW}}, rx + ry - 0.05)
    put(rx, ry, rz, hd * 2 + (if hz > 0.0 then tk % 2 else 0), 1000.0)
  }
  keys.sortMultiple(vals)
  let n = vals.length()
  let base = max(n - {{NOB}}, 0)
{{OASSIGN}}
  frameO += 1
}

on tick {
  if seated {
    if was == false {
      was = true
      reset()
      mode = 0
      titlev = "ROTOR RAID"
      hudv = ""
      msgv = "SPACE: start"
    }
    step()
    bus()
  } else {
    if was {
      was = false
      aV0 = 0.0
      titlev = "ROTOR RAID"
      hudv = ""
      msgv = ""
      mode = 0
      reset()
      bus()
    }
  }
}
on Change(seated) {
  if seated == false && was {
    was = false
    aV0 = 0.0
    titlev = "ROTOR RAID"
    hudv = ""
    msgv = ""
    mode = 0
    reset()
    bus()
  }
}
