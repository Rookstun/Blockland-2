  ey.push(y)
  ehp.push(hp)
  ecd.push(20 + ek.length() * 7)
  eax.push(ax)
  eay.push(ay)
  ebx.push(bx)
  eby.push(by)
  ep.push(0.0)
  edr.push(1.0)
}
