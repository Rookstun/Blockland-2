    if top <= 71 && top + SH[spr] > 64 {
      ox.push(o19 % 512 - 128 - SAX[spr])
      oy.push(top)
      os.push(spr)
    }
  }
  if o20 >= 0 {
    let spr = o20 / 262144
    let top = (o20 / 512) % 512 - 128 - SAY[spr]
    if top <= 71 && top + SH[spr] > 64 {
      ox.push(o20 % 512 - 128 - SAX[spr])
      oy.push(top)
      os.push(spr)
    }
  }
  if o21 >= 0 {
    let spr = o21 / 262144
    let top = (o21 / 512) % 512 - 128 - SAY[spr]
    if top <= 71 && top + SH[spr] > 64 {
      ox.push(o21 % 512 - 128 - SAX[spr])
      oy.push(top)
      os.push(spr)
    }
  }
  if o22 >= 0 {
    let spr = o22 / 262144
    let top = (o22 / 512) % 512 - 128 - SAY[spr]
    if top <= 71 && top + SH[spr] > 64 {
      ox.push(o22 % 512 - 128 - SAX[spr])
      oy.push(top)
      os.push(spr)
    }
  }
  if o23 >= 0 {
    let spr = o23 / 262144
    let top = (o23 / 512) % 512 - 128 - SAY[spr]
    if top <= 71 && top + SH[spr] > 64 {
      ox.push(o23 % 512 - 128 - SAX[spr])
      oy.push(top)
      os.push(spr)
    }
  }
  // row cache (Rookstun, optimisation 1): a row is rebuilt only when the camera or the sprites crossing it changed
  if rs.length() != 8 {
    rs.resize(8, "")
    rk1.resize(8, -1)
    rk2.resize(8, -1)
  }
  acc = ""
  for j in 0..8 {
    let sr = 64 + j
    hs = 7
    for k in 0..ox.length() {
      let r = sr - oy.get(k)
      if r >= 0 && r < SH[os.get(k)] { hs = (hs * 31 + (ox.get(k) + 512) * 1009 + r * 37 + os.get(k) * 7919) % 1000000007 }
    }
    if rk1.get(j) != camx * 4096 + camy || rk2.get(j) != hs {
      rs[j] = row(sr)
      rk1[j] = camx * 4096 + camy
      rk2[j] = hs
    }
    if j < 7 { acc = acc .. rs.get(j) .. "\n" } else { acc = acc .. rs.get(j) }
  }
  pbA = acc
  readyO = frame
}
// the server's wire budget is shared by every chip in a tick (ch5-9 got nothing once 0-4 had drawn), so each
// channel draws on its own phase tick of the 3-tick frame: a third of the channels per tick
on Change(phase) {
  if phase == 2 && frame != fA { draw() }
}
on Change(go) {
  if go == fA { stA = pbA } else { if go == fO { stA = pbO } }
}
