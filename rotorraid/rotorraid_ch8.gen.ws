// runs are merged with the previous one when the colour carries on (fewer tags = shorter text)
// constant arrays stop working somewhere past ~1-4 k entries (rows read nothing: the bottom half vanished near the tanks),
// so every big table is split into chunks of 1000 with a getter
mod mp(j: int) -> int {
  if j < 1000 { return MP0[j - 0] }
  if j < 2000 { return MP1[j - 1000] }
  if j < 3000 { return MP2[j - 2000] }
  if j < 4000 { return MP3[j - 3000] }
  return MP4[j - 4000]
}
mod mb(j: int) -> int {
  if j < 1000 { return MB0[j - 0] }
  if j < 2000 { return MB1[j - 1000] }
  return MB2[j - 2000]
}
mod me(j: int) -> int {
  if j < 1000 { return ME0[j - 0] }
  if j < 2000 { return ME1[j - 1000] }
  return ME2[j - 2000]
}
mod sp(j: int) -> int {
  if j < 1000 { return SP0[j - 0] }
  if j < 2000 { return SP1[j - 1000] }
  return SP2[j - 2000]
}
mod flush() {
  if pe > ps { s = s .. COLS[pc] .. BL.Substring(0, pe - ps) .. "</>" }
  ps = 0
  pe = 0
}
mod put(a: int, b: int, c: int) {
  if b > a {
    if c == pc && a == pe { pe = b } else {
      flush()
      pc = c
      ps = a
      pe = b
    }
  }
}
// terrain runs of image row iy straight to text, screen x0..x1 (no pixel work)
mod terrain(iy: int, x0: int, x1: int) {
  if iy >= 0 && iy < 288 {
    for j in mb(iy * 9 + max(x0 + camx, 0) / 64)..me(iy * 9 + min((x1 + camx + 63) / 64, 8)) {
      let p = mp(j)
      put(max(p % 1024 - camx, x0), min((p / 1024) % 1024 - camx, x1), p / 1048576)
    }
  } else { put(x0, x1, 0) }
}
// a row: plain terrain runs, except the x range sprites cover on this row, which is painted per pixel (cheap: small)
mod row(sr: int) -> string {
  let iy = camy + sr
  s = ""
  pc = -1
  ps = 0
  pe = 0
  lo = 120
  hi = 0
  for k in 0..ox.length() {
    let r = sr - oy.get(k)
    if r >= 0 && r < SH[os.get(k)] {
      lo = max(min(lo, ox.get(k)), 0)
      hi = min(max(hi, ox.get(k) + SW[os.get(k)]), 120)
    }
  }
  if hi <= lo {
    // scroll reuse (Rookstun, optimisation 2): a plain map row is the same text whenever the camera x is the same,
    // so up/down scrolling just picks rows already built for other screen lines
    if iy >= 0 && iy < 288 {
      if tcx.length() != 288 {
        tcache.resize(288, "")
        tcx.resize(288, -1)
      }
      if tcx.get(iy) == camx { return tcache.get(iy) }
    }
    terrain(iy, 0, 120)
    flush()
    if iy >= 0 && iy < 288 {
      tcache[iy] = s
      tcx[iy] = camx
    }
    return s
  }
  terrain(iy, 0, lo)
  if iy >= 0 && iy < 288 {
    for j in mb(iy * 9 + max(lo + camx, 0) / 64)..me(iy * 9 + min((hi + camx + 63) / 64, 8)) {
      let p = mp(j)
      paint(p % 1024 - camx, (p / 1024) % 1024 - camx, p / 1048576)
    }
  } else { paint(lo, hi, 0) }
  for k in 0..ox.length() {
    let r = sr - oy.get(k)
    let spr = os.get(k)
    if r >= 0 && r < SH[spr] {
      let rr = SRI[spr] + r
      for j in SRS[rr]..SRS[rr + 1] {
        let p = sp(j)
        paint(ox.get(k) + p % 64, ox.get(k) + (p / 64) % 64, p / 4096)
      }
    }
  }
  cur = px.get(lo)
  st = lo
  for x in lo + 1..hi {
    if px.get(x) != cur {
      put(st, x, cur)
      cur = px.get(x)
      st = x
    }
  }
  put(st, hi, cur)
  terrain(iy, hi, 120)
  flush()
  return s
}
mod draw() {
  pbO = pbA
  fO = fA
  fA = frame
  if px.length() != 120 { px.resize(120, 0) }
  ox.resize(0, 0)
  oy.resize(0, 0)
  os.resize(0, 0)
  if o0 >= 0 {
    let spr = o0 / 262144
    let top = (o0 / 512) % 512 - 128 - SAY[spr]
    if top <= 71 && top + SH[spr] > 64 {
      ox.push(o0 % 512 - 128 - SAX[spr])
      oy.push(top)
      os.push(spr)
    }
  }
  if o1 >= 0 {
    let spr = o1 / 262144
    let top = (o1 / 512) % 512 - 128 - SAY[spr]
    if top <= 71 && top + SH[spr] > 64 {
      ox.push(o1 % 512 - 128 - SAX[spr])
      oy.push(top)
      os.push(spr)
    }
  }
  if o2 >= 0 {
    let spr = o2 / 262144
    let top = (o2 / 512) % 512 - 128 - SAY[spr]
    if top <= 71 && top + SH[spr] > 64 {
      ox.push(o2 % 512 - 128 - SAX[spr])
      oy.push(top)
      os.push(spr)
    }
  }
  if o3 >= 0 {
    let spr = o3 / 262144
    let top = (o3 / 512) % 512 - 128 - SAY[spr]
    if top <= 71 && top + SH[spr] > 64 {
      ox.push(o3 % 512 - 128 - SAX[spr])
      oy.push(top)
      os.push(spr)
    }
  }
  if o4 >= 0 {
    let spr = o4 / 262144
    let top = (o4 / 512) % 512 - 128 - SAY[spr]
    if top <= 71 && top + SH[spr] > 64 {
      ox.push(o4 % 512 - 128 - SAX[spr])
      oy.push(top)
      os.push(spr)
    }
  }
  if o5 >= 0 {
    let spr = o5 / 262144
    let top = (o5 / 512) % 512 - 128 - SAY[spr]
    if top <= 71 && top + SH[spr] > 64 {
      ox.push(o5 % 512 - 128 - SAX[spr])
      oy.push(top)
      os.push(spr)
    }
  }
  if o6 >= 0 {
    let spr = o6 / 262144
    let top = (o6 / 512) % 512 - 128 - SAY[spr]
    if top <= 71 && top + SH[spr] > 64 {
      ox.push(o6 % 512 - 128 - SAX[spr])
      oy.push(top)
      os.push(spr)
    }
  }
  if o7 >= 0 {
    let spr = o7 / 262144
    let top = (o7 / 512) % 512 - 128 - SAY[spr]
    if top <= 71 && top + SH[spr] > 64 {
      ox.push(o7 % 512 - 128 - SAX[spr])
      oy.push(top)
      os.push(spr)
    }
  }
  if o8 >= 0 {
    let spr = o8 / 262144
    let top = (o8 / 512) % 512 - 128 - SAY[spr]
    if top <= 71 && top + SH[spr] > 64 {
      ox.push(o8 % 512 - 128 - SAX[spr])
      oy.push(top)
      os.push(spr)
    }
  }
  if o9 >= 0 {
    let spr = o9 / 262144
    let top = (o9 / 512) % 512 - 128 - SAY[spr]
    if top <= 71 && top + SH[spr] > 64 {
      ox.push(o9 % 512 - 128 - SAX[spr])
      oy.push(top)
      os.push(spr)
    }
  }
  if o10 >= 0 {
    let spr = o10 / 262144
    let top = (o10 / 512) % 512 - 128 - SAY[spr]
    if top <= 71 && top + SH[spr] > 64 {
      ox.push(o10 % 512 - 128 - SAX[spr])
      oy.push(top)
      os.push(spr)
    }
  }
  if o11 >= 0 {
    let spr = o11 / 262144
    let top = (o11 / 512) % 512 - 128 - SAY[spr]
    if top <= 71 && top + SH[spr] > 64 {
      ox.push(o11 % 512 - 128 - SAX[spr])
      oy.push(top)
      os.push(spr)
    }
  }
  if o12 >= 0 {
    let spr = o12 / 262144
    let top = (o12 / 512) % 512 - 128 - SAY[spr]
    if top <= 71 && top + SH[spr] > 64 {
      ox.push(o12 % 512 - 128 - SAX[spr])
      oy.push(top)
      os.push(spr)
    }
  }
  if o13 >= 0 {
    let spr = o13 / 262144
    let top = (o13 / 512) % 512 - 128 - SAY[spr]
    if top <= 71 && top + SH[spr] > 64 {
      ox.push(o13 % 512 - 128 - SAX[spr])
      oy.push(top)
      os.push(spr)
    }
  }
  if o14 >= 0 {
    let spr = o14 / 262144
    let top = (o14 / 512) % 512 - 128 - SAY[spr]
    if top <= 71 && top + SH[spr] > 64 {
      ox.push(o14 % 512 - 128 - SAX[spr])
      oy.push(top)
      os.push(spr)
    }
  }
  if o15 >= 0 {
    let spr = o15 / 262144
    let top = (o15 / 512) % 512 - 128 - SAY[spr]
    if top <= 71 && top + SH[spr] > 64 {
      ox.push(o15 % 512 - 128 - SAX[spr])
      oy.push(top)
      os.push(spr)
    }
  }
  if o16 >= 0 {
    let spr = o16 / 262144
    let top = (o16 / 512) % 512 - 128 - SAY[spr]
    if top <= 71 && top + SH[spr] > 64 {
      ox.push(o16 % 512 - 128 - SAX[spr])
      oy.push(top)
      os.push(spr)
    }
  }
  if o17 >= 0 {
    let spr = o17 / 262144
    let top = (o17 / 512) % 512 - 128 - SAY[spr]
    if top <= 71 && top + SH[spr] > 64 {
      ox.push(o17 % 512 - 128 - SAX[spr])
      oy.push(top)
      os.push(spr)
    }
  }
  if o18 >= 0 {
    let spr = o18 / 262144
    let top = (o18 / 512) % 512 - 128 - SAY[spr]
    if top <= 71 && top + SH[spr] > 64 {
      ox.push(o18 % 512 - 128 - SAX[spr])
      oy.push(top)
      os.push(spr)
    }
