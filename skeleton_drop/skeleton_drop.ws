        var p9 = hp.GetLeaderboard("InvName9")
        let pc9 = catClass(p9)
        let pn9 = catName(p9)
        if n0 == "" {
          if p0 > 0 && pc0 == e0 {
            p0 = 0
            hp.SetLeaderboard("InvName0", 0)
            hp.SetLeaderboard("InvPend", hp.GetLeaderboard("InvPend") - 1)
            n0 = pn0
            invFix.set("${uid}:0", 1)
            invFixN.set(uid, 1)
          } else if p1 > 0 && pc1 == e0 {
            p1 = 0
            hp.SetLeaderboard("InvName1", 0)
            hp.SetLeaderboard("InvPend", hp.GetLeaderboard("InvPend") - 1)
            n0 = pn1
            invFix.set("${uid}:0", 1)
            invFixN.set(uid, 1)
          } else if p2 > 0 && pc2 == e0 {
