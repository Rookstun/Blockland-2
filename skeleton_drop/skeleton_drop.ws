          } else if p3 > 0 && pc3 == e9 {
            p3 = 0
            hp.SetLeaderboard("InvName3", 0)
            hp.SetLeaderboard("InvPend", hp.GetLeaderboard("InvPend") - 1)
            n9 = pn3
            invFix.set("${uid}:9", 1)
