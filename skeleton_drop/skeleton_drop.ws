        } else if tier == 2 {
          character.SetInventoryItemAdv($BRItemBase/Weapon_ArmingSword, slot = 7, damage = 0.65, itemName = "Iron Sword", overrideColors = true, meshColors = [ColorSRGB(88, 86, 84, 255)])
        } else if tier == 3 {
