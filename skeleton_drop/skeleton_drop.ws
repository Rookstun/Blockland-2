        }
      } else {
        giveNamed(character, 9, nm9, it9)
      }
    } else if !invSeen.has(suid) || GetUnixTime() - invSeen.get(suid) > 30 {
      // no snapshot here (a restart or a new chip): the progress plugin gives back the rest from disk
      let tier = character.ControllerOf().GetLeaderboard("SwordTier")
      if tier == 1 {
        character.AddInventoryItemAdv($BRItemBase/Weapon_ArmingSword, damage = 0.50, itemName = "Bronze Sword", overrideColors = true, meshColors = [ColorSRGB(123, 72, 0, 255)])
      } else if tier == 2 {
        character.AddInventoryItemAdv($BRItemBase/Weapon_ArmingSword, damage = 0.65, itemName = "Iron Sword", overrideColors = true, meshColors = [ColorSRGB(88, 86, 84, 255)])
      } else if tier == 3 {
        character.AddInventoryItemAdv($BRItemBase/Weapon_ArmingSword, damage = 0.80, itemName = "Steel Sword", overrideColors = true, meshColors = [ColorSRGB(160, 160, 166, 255)])
      } else if tier == 4 {
        character.AddInventoryItemAdv($BRItemBase/Weapon_ArmingSword, damage = 1.00, itemName = "Black Sword", overrideColors = true, meshColors = [ColorSRGB(26, 26, 28, 255)])
      } else if tier == 5 {
        character.AddInventoryItemAdv($BRItemBase/Weapon_ArmingSword, damage = 1.20, itemName = "Mithril Sword", overrideColors = true, meshColors = [ColorSRGB(58, 58, 128, 255)])
      } else if tier == 6 {
        character.AddInventoryItemAdv($BRItemBase/Weapon_ArmingSword, damage = 1.50, itemName = "Adamant Sword", overrideColors = true, meshColors = [ColorSRGB(42, 96, 56, 255)])
      } else if tier == 7 {
        character.AddInventoryItemAdv($BRItemBase/Weapon_ArmingSword, damage = 2.00, itemName = "Rune Sword", overrideColors = true, meshColors = [ColorSRGB(38, 150, 178, 255)])
      }
    }
    invLive.set(suid, 1)
  }
  invSeen.set(suid, GetUnixTime())
  let total = sc.GetLeaderboard("XP")
  let lvl = floor(sqrt(total / 25.0)) + 1
  // players only: bots spawn too, with their own health (2026-10-08: capping
  // them as level-1 players left every enemy nearly dead)
  if sc.GetUserName().Length() > 0 {
    let capMaxS = 100.0 * (1.0 + 0.05 * (lvl - 1))
    let capDmgS = character.GetDamage()
    let capHpS = capDmgS.DamageLimit - capDmgS.Damage
    if capHpS > capMaxS {
      character.SetDamage(capDmgS.DamageLimit - capMaxS)
    }
  }
  teamLvl = lvl
  let lteam = GetTeamByName("Chud")
  if lteam.GetTeamName().Length() > 0 && sc.GetUserName().Length() > 0 {
    sc.SetTeam(lteam)
  }
  sc.DisplayText("<b>Level ${lvl}</>", anchorX = 0.5, anchorY = 0.0, pivotX = 0.5, pivotY = 0.0, positionX = 0.0, positionY = 40.0,
    fontSize = 34, justify = Center, outlineSize = 2, lifetime = 86400.0, textId = 52001)
  sc.DisplayText("XP ${total} / ${25 * lvl * lvl}", anchorX = 0.5, anchorY = 0.0, pivotX = 0.5, pivotY = 0.0, positionX = 0.0, positionY = 82.0,
    fontSize = 22, justify = Center, outlineSize = 2, lifetime = 86400.0, textId = 52002)
  sc.DisplayText("<color=\"f6ce2a\">Coins ${sc.GetLeaderboard("coins")}</>", anchorX = 0.5, anchorY = 0.0, pivotX = 0.5, pivotY = 0.0, positionX = 0.0, positionY = 112.0,
    fontSize = 22, justify = Center, outlineSize = 2, lifetime = 86400.0, textId = 52003)
}
