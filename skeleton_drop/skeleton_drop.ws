// skeleton_drop.ws -- generated by gen.js (edit the table there, then
// node gen.js && node build.mjs). When a dungeon skeleton dies, it drops coins
// where it died and gives the killer XP: each skeleton gets some rolls; each
// roll drops a coin with its drop chance, brown (+1) / silver (+10) / gold
// (+25) "coins" by its odds; the killer gets the XP on the leaderboard:
//   handaxe                2 rolls,  60% drop, brown 85% silver 15% gold 0%, 5 XP
//   arming                 2 rolls,  70% drop, brown 75% silver 22% gold 3%, 8 XP
//   spear                  3 rolls,  70% drop, brown 65% silver 30% gold 5%, 12 XP
//   longsword              3 rolls,  80% drop, brown 55% silver 35% gold 10%, 18 XP
//   bow                    4 rolls,  80% drop, brown 45% silver 40% gold 15%, 25 XP
//   zweihander             4 rolls,  90% drop, brown 35% silver 45% gold 20%, 35 XP
//   battleaxe              5 rolls, 100% drop, brown 25% silver 45% gold 30%, 50 XP
//   wood goblin            3 rolls,  75% drop, brown 70% silver 25% gold 5%, 10 XP
//   goblin                 2 rolls,  70% drop, brown 80% silver 18% gold 2%, 6 XP
//   wizard                 5 rolls, 100% drop, brown 20% silver 45% gold 35%, 60 XP
//   bloated                4 rolls,  90% drop, brown 40% silver 45% gold 15%, 30 XP
//   zombie                 3 rolls,  75% drop, brown 60% silver 33% gold 7%, 15 XP
//   (any other skeleton)   3 rolls,  70% drop, brown 65% silver 30% gold 5%, 12 XP
// Coins are flung out a little so they scatter. The chip also pulses Died
// and puts the spot on Location (world) / Offset (relative to this chip).

const FLING = 120.0   // sideways speed of a dropped coin
const POP = 250.0     // upward speed

var location: vector = Vec(0.0, 0.0, 0.0)
var offset: vector = Vec(0.0, 0.0, 0.0)
var rolls: int = 0
var xp: int = 0
var dropPct: int = 0
var brownPct: int = 0
var silverPct: int = 0
out Location: vector = location
out Offset: vector = offset
out Died: exec
var kc: controller
var teamLvl: int = 1
// who last hurt each character, for kill credit when CharacterDied gives no killer
var hitBy: Map<character, controller>
// enemy name by max health (see ENEMY in gen.js)
mod enemyName(lim: int) -> string {
  if lim == 50 {
    return "Handaxe Skeleton"
  } else if lim == 75 {
    return "Arming Sword Skeleton"
  } else if lim == 125 {
    return "Spear Skeleton"
  } else if lim == 200 {
    return "Longsword Skeleton"
  } else if lim == 250 {
    return "Bow Skeleton"
  } else if lim == 350 {
    return "Zweihander Skeleton"
  } else if lim == 500 {
    return "Battleaxe Skeleton"
  } else if lim == 55 {
    return "Wood Goblin"
  } else if lim == 35 {
    return "Goblin"
  } else if lim == 65 {
    return "Evil Wizard"
  } else if lim == 10000 {
    return "Casino Staff"
  } else if lim == 130 {
    return "Bloated Zombie"
  } else if lim == 60 {
    return "Swamp Zombie"
  }
  return "Enemy"
}
const BARS = ["<color=\"e03030\"></><color=\"555555\">||||||||||||||||||||</>", "<color=\"e03030\">|</><color=\"555555\">|||||||||||||||||||</>", "<color=\"e03030\">||</><color=\"555555\">||||||||||||||||||</>", "<color=\"e03030\">|||</><color=\"555555\">|||||||||||||||||</>", "<color=\"e03030\">||||</><color=\"555555\">||||||||||||||||</>", "<color=\"e03030\">|||||</><color=\"555555\">|||||||||||||||</>", "<color=\"e03030\">||||||</><color=\"555555\">||||||||||||||</>", "<color=\"e03030\">|||||||</><color=\"555555\">|||||||||||||</>", "<color=\"e03030\">||||||||</><color=\"555555\">||||||||||||</>", "<color=\"e03030\">|||||||||</><color=\"555555\">|||||||||||</>", "<color=\"e03030\">||||||||||</><color=\"555555\">||||||||||</>", "<color=\"e03030\">|||||||||||</><color=\"555555\">|||||||||</>", "<color=\"e03030\">||||||||||||</><color=\"555555\">||||||||</>", "<color=\"e03030\">|||||||||||||</><color=\"555555\">|||||||</>", "<color=\"e03030\">||||||||||||||</><color=\"555555\">||||||</>", "<color=\"e03030\">|||||||||||||||</><color=\"555555\">|||||</>", "<color=\"e03030\">||||||||||||||||</><color=\"555555\">||||</>", "<color=\"e03030\">|||||||||||||||||</><color=\"555555\">|||</>", "<color=\"e03030\">||||||||||||||||||</><color=\"555555\">||</>", "<color=\"e03030\">|||||||||||||||||||</><color=\"555555\">|</>", "<color=\"e03030\">||||||||||||||||||||</><color=\"555555\"></>"]
mod enemyHud(who: controller, bot: character) {
  let d = bot.GetDamage()
  let lim = floor(d.DamageLimit + 0.5)
  let left = max(d.DamageLimit - d.Damage, 0.0)
  let seg = floor(left / d.DamageLimit * 20.0 + 0.999)
  who.DisplayText("<b>${enemyName(lim)}</>", anchorX = 0.5, anchorY = 0.0, pivotX = 0.5, pivotY = 0.0, positionX = 0.0, positionY = 150.0,
    fontSize = 24, justify = Center, outlineSize = 2, lifetime = 5.0, textId = 52010)
  who.DisplayText("<b>${BARS[seg]}</>  ${floor(left + 0.5)} / ${lim}", anchorX = 0.5, anchorY = 0.0, pivotX = 0.5, pivotY = 0.0, positionX = 0.0, positionY = 182.0,
    fontSize = 22, justify = Center, outlineSize = 2, lifetime = 5.0, textId = 52011)
}
on CharacterDamaged() -> (victim, damage, attacker, attackerWeapon, attackerWeaponName) {
  let ac = attacker.ControllerOf()
  PrintToConsole("[hit debug] victim=${victim.ControllerOf().GetUserName()} attacker=${ac.GetUserName()} weapon=${attackerWeaponName} dmg=${damage} total=${victim.GetDamage()}")
  let vc = victim.ControllerOf()
  if ac.GetUserName().Length() > 0 {
    hitBy.set(victim, ac)
    if vc.GetUserName().Length() == 0 {
      enemyHud(ac, victim)
    }
  } else if vc.GetUserName().Length() > 0 && attacker.GetDamage().DamageLimit > 0.0 {
    enemyHud(vc, attacker)
  }
  // (2026-10-08) per-level health is now the real health, capped on spawn,
  // level-up and every HUD tick (capHp); the old rule here (shrink every hit by
  // the level bonus, then over 100 damage straight to 400) gave the same
  // toughness with a 400 health bar, and would kill a capped player outright
}

on CharacterDied() -> (who, killer, killerWeapon, killerWeaponName) {
  let name = who.ControllerOf().GetDisplayName().ToLower()
  let isBot = who.ControllerOf().GetUserName().Length() == 0
  let lim = floor(who.GetDamage().DamageLimit + 0.5)
  let dbgUser = who.ControllerOf().GetUserName()
  let dbgTag = who.GetTag()
  PrintToConsole("[xp debug] died: user=${dbgUser} tag=${dbgTag}")
  if isBot && lim >= 5000 {
    rolls = 0
  } else if name.Contains("handaxe") || (isBot && lim == 50) {
    xp = 5
    rolls = 2
    dropPct = 60
    brownPct = 85
    silverPct = 15
  } else if name.Contains("arming") || (isBot && lim == 75) {
    xp = 8
    rolls = 2
    dropPct = 70
    brownPct = 75
    silverPct = 22
  } else if name.Contains("spear") || (isBot && lim == 125) {
    xp = 12
    rolls = 3
    dropPct = 70
    brownPct = 65
    silverPct = 30
  } else if name.Contains("longsword") || (isBot && lim == 200) {
    xp = 18
    rolls = 3
    dropPct = 80
    brownPct = 55
    silverPct = 35
  } else if name.Contains("bow") || (isBot && lim == 250) {
    xp = 25
    rolls = 4
    dropPct = 80
    brownPct = 45
    silverPct = 40
  } else if name.Contains("zweihander") || (isBot && lim == 350) {
    xp = 35
    rolls = 4
    dropPct = 90
    brownPct = 35
    silverPct = 45
  } else if name.Contains("battleaxe") || (isBot && lim == 500) {
    xp = 50
    rolls = 5
    dropPct = 100
    brownPct = 25
    silverPct = 45
  } else if name.Contains("wood goblin") || (isBot && lim == 55) {
    xp = 10
    rolls = 3
    dropPct = 75
    brownPct = 70
    silverPct = 25
  } else if name.Contains("goblin") || (isBot && lim == 35) {
    xp = 6
    rolls = 2
    dropPct = 70
    brownPct = 80
    silverPct = 18
  } else if name.Contains("wizard") || (isBot && lim == 65) {
    xp = 60
    rolls = 5
    dropPct = 100
    brownPct = 20
    silverPct = 45
  } else if name.Contains("bloated") || (isBot && lim == 130) {
    xp = 30
    rolls = 4
    dropPct = 90
    brownPct = 40
    silverPct = 45
  } else if name.Contains("zombie") || (isBot && lim == 60) {
    xp = 15
    rolls = 3
    dropPct = 75
    brownPct = 60
    silverPct = 33
  } else if name.Contains("skeleton") || name.Length() == 0 {
    xp = 12
    rolls = 3
    dropPct = 70
    brownPct = 65
    silverPct = 30
  } else {
    rolls = 0
  }
  PrintToConsole("[xp debug] A rolls=${rolls} xp=${xp} len=${name.Length()}")
  if rolls > 0 {
    location = who.GetLocation()
    PrintToConsole("[xp debug] B at ${location}")
    offset = location - GetOwnTransform().Location
    let at = offset + Vec(0.0, 0.0, 20.0)
    if rolls >= 1 && Random(0, 99) < dropPct {
      let ang1 = Random(0, 359) * 0.0174533
      let vel1 = Vec(cos(ang1) * FLING, sin(ang1) * FLING, POP)
      let roll1 = Random(0, 99)
      if roll1 < brownPct {
        let n1 = Random(2, 4)
        SpawnPrefab(prefab = $./coin1.brz, offset = at, velocity = Vec(cos(ang1 + 0.0) * FLING, sin(ang1 + 0.0) * FLING, POP + 0.0), lifetime = 180.0, limit = 400)
        SpawnPrefab(prefab = $./coin1.brz, offset = at, velocity = Vec(cos(ang1 + 1.3) * FLING, sin(ang1 + 1.3) * FLING, POP + 30.0), lifetime = 180.0, limit = 400)
        if n1 >= 3 {
          SpawnPrefab(prefab = $./coin1.brz, offset = at, velocity = Vec(cos(ang1 + 2.6) * FLING, sin(ang1 + 2.6) * FLING, POP + 60.0), lifetime = 180.0, limit = 400)
        }
        if n1 >= 4 {
          SpawnPrefab(prefab = $./coin1.brz, offset = at, velocity = Vec(cos(ang1 + 3.9) * FLING, sin(ang1 + 3.9) * FLING, POP + 90.0), lifetime = 180.0, limit = 400)
        }
      } else if roll1 < brownPct + silverPct {
        SpawnPrefab(prefab = $./coin10.brz, offset = at, velocity = vel1, lifetime = 180.0, limit = 200)
      } else {
        SpawnPrefab(prefab = $./coin25.brz, offset = at, velocity = vel1, lifetime = 180.0, limit = 200)
      }
    }
    if rolls >= 2 && Random(0, 99) < dropPct {
      let ang2 = Random(0, 359) * 0.0174533
      let vel2 = Vec(cos(ang2) * FLING, sin(ang2) * FLING, POP)
      let roll2 = Random(0, 99)
      if roll2 < brownPct {
        let n2 = Random(2, 4)
        SpawnPrefab(prefab = $./coin1.brz, offset = at, velocity = Vec(cos(ang2 + 0.0) * FLING, sin(ang2 + 0.0) * FLING, POP + 0.0), lifetime = 180.0, limit = 400)
        SpawnPrefab(prefab = $./coin1.brz, offset = at, velocity = Vec(cos(ang2 + 1.3) * FLING, sin(ang2 + 1.3) * FLING, POP + 30.0), lifetime = 180.0, limit = 400)
        if n2 >= 3 {
          SpawnPrefab(prefab = $./coin1.brz, offset = at, velocity = Vec(cos(ang2 + 2.6) * FLING, sin(ang2 + 2.6) * FLING, POP + 60.0), lifetime = 180.0, limit = 400)
        }
        if n2 >= 4 {
          SpawnPrefab(prefab = $./coin1.brz, offset = at, velocity = Vec(cos(ang2 + 3.9) * FLING, sin(ang2 + 3.9) * FLING, POP + 90.0), lifetime = 180.0, limit = 400)
        }
      } else if roll2 < brownPct + silverPct {
        SpawnPrefab(prefab = $./coin10.brz, offset = at, velocity = vel2, lifetime = 180.0, limit = 200)
      } else {
        SpawnPrefab(prefab = $./coin25.brz, offset = at, velocity = vel2, lifetime = 180.0, limit = 200)
      }
    }
    if rolls >= 3 && Random(0, 99) < dropPct {
      let ang3 = Random(0, 359) * 0.0174533
      let vel3 = Vec(cos(ang3) * FLING, sin(ang3) * FLING, POP)
      let roll3 = Random(0, 99)
      if roll3 < brownPct {
        let n3 = Random(2, 4)
        SpawnPrefab(prefab = $./coin1.brz, offset = at, velocity = Vec(cos(ang3 + 0.0) * FLING, sin(ang3 + 0.0) * FLING, POP + 0.0), lifetime = 180.0, limit = 400)
        SpawnPrefab(prefab = $./coin1.brz, offset = at, velocity = Vec(cos(ang3 + 1.3) * FLING, sin(ang3 + 1.3) * FLING, POP + 30.0), lifetime = 180.0, limit = 400)
        if n3 >= 3 {
          SpawnPrefab(prefab = $./coin1.brz, offset = at, velocity = Vec(cos(ang3 + 2.6) * FLING, sin(ang3 + 2.6) * FLING, POP + 60.0), lifetime = 180.0, limit = 400)
        }
        if n3 >= 4 {
          SpawnPrefab(prefab = $./coin1.brz, offset = at, velocity = Vec(cos(ang3 + 3.9) * FLING, sin(ang3 + 3.9) * FLING, POP + 90.0), lifetime = 180.0, limit = 400)
        }
      } else if roll3 < brownPct + silverPct {
        SpawnPrefab(prefab = $./coin10.brz, offset = at, velocity = vel3, lifetime = 180.0, limit = 200)
      } else {
        SpawnPrefab(prefab = $./coin25.brz, offset = at, velocity = vel3, lifetime = 180.0, limit = 200)
      }
    }
    if rolls >= 4 && Random(0, 99) < dropPct {
      let ang4 = Random(0, 359) * 0.0174533
      let vel4 = Vec(cos(ang4) * FLING, sin(ang4) * FLING, POP)
      let roll4 = Random(0, 99)
      if roll4 < brownPct {
        let n4 = Random(2, 4)
        SpawnPrefab(prefab = $./coin1.brz, offset = at, velocity = Vec(cos(ang4 + 0.0) * FLING, sin(ang4 + 0.0) * FLING, POP + 0.0), lifetime = 180.0, limit = 400)
        SpawnPrefab(prefab = $./coin1.brz, offset = at, velocity = Vec(cos(ang4 + 1.3) * FLING, sin(ang4 + 1.3) * FLING, POP + 30.0), lifetime = 180.0, limit = 400)
        if n4 >= 3 {
          SpawnPrefab(prefab = $./coin1.brz, offset = at, velocity = Vec(cos(ang4 + 2.6) * FLING, sin(ang4 + 2.6) * FLING, POP + 60.0), lifetime = 180.0, limit = 400)
        }
        if n4 >= 4 {
          SpawnPrefab(prefab = $./coin1.brz, offset = at, velocity = Vec(cos(ang4 + 3.9) * FLING, sin(ang4 + 3.9) * FLING, POP + 90.0), lifetime = 180.0, limit = 400)
        }
      } else if roll4 < brownPct + silverPct {
        SpawnPrefab(prefab = $./coin10.brz, offset = at, velocity = vel4, lifetime = 180.0, limit = 200)
      } else {
        SpawnPrefab(prefab = $./coin25.brz, offset = at, velocity = vel4, lifetime = 180.0, limit = 200)
      }
    }
    if rolls >= 5 && Random(0, 99) < dropPct {
      let ang5 = Random(0, 359) * 0.0174533
      let vel5 = Vec(cos(ang5) * FLING, sin(ang5) * FLING, POP)
      let roll5 = Random(0, 99)
      if roll5 < brownPct {
        let n5 = Random(2, 4)
        SpawnPrefab(prefab = $./coin1.brz, offset = at, velocity = Vec(cos(ang5 + 0.0) * FLING, sin(ang5 + 0.0) * FLING, POP + 0.0), lifetime = 180.0, limit = 400)
        SpawnPrefab(prefab = $./coin1.brz, offset = at, velocity = Vec(cos(ang5 + 1.3) * FLING, sin(ang5 + 1.3) * FLING, POP + 30.0), lifetime = 180.0, limit = 400)
        if n5 >= 3 {
          SpawnPrefab(prefab = $./coin1.brz, offset = at, velocity = Vec(cos(ang5 + 2.6) * FLING, sin(ang5 + 2.6) * FLING, POP + 60.0), lifetime = 180.0, limit = 400)
        }
        if n5 >= 4 {
          SpawnPrefab(prefab = $./coin1.brz, offset = at, velocity = Vec(cos(ang5 + 3.9) * FLING, sin(ang5 + 3.9) * FLING, POP + 90.0), lifetime = 180.0, limit = 400)
        }
      } else if roll5 < brownPct + silverPct {
        SpawnPrefab(prefab = $./coin10.brz, offset = at, velocity = vel5, lifetime = 180.0, limit = 200)
      } else {
        SpawnPrefab(prefab = $./coin25.brz, offset = at, velocity = vel5, lifetime = 180.0, limit = 200)
      }
    }
    if Random(0, 99) < 25 {
      SpawnPrefab(prefab = $./heal.brz, offset = at, lifetime = 60.0, limit = 100)
    }
    if Random(0, 99) < 35 {
      SpawnPrefab(prefab = $./arrows.brz, offset = at + Vec(0.0, 0.0, 12.0), lifetime = 60.0, limit = 100)
    }
    if Random(0, 99) < 15 {
      SpawnPrefab(prefab = $./bullets.brz, offset = at + Vec(0.0, 0.0, 24.0), lifetime = 60.0, limit = 100)
    }
    // XP and level for the killer. CharacterDied leaves the killer empty when a
    // bot dies, so fall back to the last player who damaged it (hitBy)
    kc = killer.ControllerOf()
    if kc.GetUserName().Length() == 0 {
      kc = hitBy.get(who)
    }
    hitBy.remove(who)
    PrintToConsole("[xp debug] C killer=${kc.GetUserName()} lim=${lim}")
    if kc.GetUserName().Length() > 0 {
      kc.DisplayText("<b>${enemyName(lim)}</> defeated", anchorX = 0.5, anchorY = 0.0, pivotX = 0.5, pivotY = 0.0, positionX = 0.0, positionY = 150.0,
        fontSize = 24, justify = Center, outlineSize = 2, lifetime = 2.0, textId = 52010)
      kc.DisplayText("<b>${BARS[0]}</>", anchorX = 0.5, anchorY = 0.0, pivotX = 0.5, pivotY = 0.0, positionX = 0.0, positionY = 182.0,
        fontSize = 22, justify = Center, outlineSize = 2, lifetime = 2.0, textId = 52011)
      kc.IncLeaderboard("XP", xp)
      let total = kc.GetLeaderboard("XP")
      let lvl = floor(sqrt(total / 25.0)) + 1
      kc.ShowStatusMessage("+${xp} XP")
      if lvl > kc.GetLeaderboard("Level") {
        kc.SetLeaderboard("Level", lvl)
        kc.ShowStatusMessage("LEVEL UP! You are level ${lvl}")
        teamLvl = lvl
        let lteam = GetTeamByName("Chud")
        if lteam.GetTeamName().Length() > 0 && kc.GetUserName().Length() > 0 {
          kc.SetTeam(lteam)
        }
        kc.ShowChatMessage("<color=\"46aaff\"><b>Level up!</> You reached level ${lvl}. /level shows your progress.</>")
      }
      let capMaxK = 100.0 * (1.0 + 0.05 * (lvl - 1))
      let capDmgK = kc.CharacterOf().GetDamage()
      let capHpK = capDmgK.DamageLimit - capDmgK.Damage
      if capHpK > capMaxK {
        kc.CharacterOf().SetDamage(capDmgK.DamageLimit - capMaxK)
      }

        kc.DisplayText("<b>Level ${lvl}</>", anchorX = 0.5, anchorY = 0.0, pivotX = 0.5, pivotY = 0.0, positionX = 0.0, positionY = 40.0,
        fontSize = 34, justify = Center, outlineSize = 2, lifetime = 86400.0, textId = 52001)
      kc.DisplayText("XP ${total} / ${25 * lvl * lvl}", anchorX = 0.5, anchorY = 0.0, pivotX = 0.5, pivotY = 0.0, positionX = 0.0, positionY = 82.0,
        fontSize = 22, justify = Center, outlineSize = 2, lifetime = 86400.0, textId = 52002)
      kc.DisplayText("<color=\"f6ce2a\">Coins ${kc.GetLeaderboard("coins")}</>", anchorX = 0.5, anchorY = 0.0, pivotX = 0.5, pivotY = 0.0, positionX = 0.0, positionY = 112.0,
        fontSize = 22, justify = Center, outlineSize = 2, lifetime = 86400.0, textId = 52003)

    }
    emit Died
  }
}

// HUD refresh: coins change outside this chip (coin pickups, shops), so every
// 0.25 s redraw the next player's HUD in turn
var hudPlayers: controller[]
var hudIdx: int = 0
var invCoins: Map<string, int>
var invSeen: Map<string, int>
var invLive: Map<string, int>
var invHas: Map<string, int>
var invLast: Map<string, string>
var invJoin: Map<string, int>
var invItem: Map<string, entity>
on ControllerLeft() -> (controller, userId, userName) {
  invLive.set(userId, 0)
}
on ControllerJoined() -> (controller, userId, userName) {
  invJoin.set(userId, GetUnixTime())
}
on Clock(interval = 0.25) {
  hudPlayers.fillFromPlayers()
  let n = hudPlayers.length()
  if n > 0 {
    if hudIdx >= n {
      hudIdx = 0
    }
    let hp = hudPlayers[hudIdx]
    // a new chip adopts whoever was in game before it loaded (no join seen) or
    // joined 30 s ago and more (their first spawn has been and gone): else
    // they'd only be tracked from a later spawn, which would look like a join
    let auid = hp.GetUserId()
    if !invLive.has(auid) && (!invJoin.has(auid) || GetUnixTime() - invJoin.get(auid) > 30) {
      invLive.set(auid, 1)
    }
    let uid = hp.GetUserId()
    let coinsNow = hp.GetLeaderboard("coins")
    if invCoins.has(uid) {
      let spent = invCoins.get(uid) - coinsNow
      if spent == 150 {
        hp.SetLeaderboard("SwordTier", 1)
      } else if spent == 400 {
        hp.SetLeaderboard("SwordTier", 2)
      } else if spent == 1000 {
        hp.SetLeaderboard("SwordTier", 3)
      } else if spent == 2000 {
        hp.SetLeaderboard("SwordTier", 4)
      } else if spent == 4000 {
        hp.SetLeaderboard("SwordTier", 5)
      } else if spent == 8000 {
        hp.SetLeaderboard("SwordTier", 6)
      } else if spent == 20000 {
        hp.SetLeaderboard("SwordTier", 7)
      }
    }
    invCoins.set(uid, coinsNow)
    invSeen.set(uid, GetUnixTime())
    if invLive.has(uid) && invLive.get(uid) == 1 {
      let ich = hp.CharacterOf()
      invItem.set("${uid}:0", ich.GetInventoryEntry(0).Item)
      invItem.set("${uid}:1", ich.GetInventoryEntry(1).Item)
      invItem.set("${uid}:2", ich.GetInventoryEntry(2).Item)
      invItem.set("${uid}:3", ich.GetInventoryEntry(3).Item)
      invItem.set("${uid}:4", ich.GetInventoryEntry(4).Item)
      invItem.set("${uid}:5", ich.GetInventoryEntry(5).Item)
      invItem.set("${uid}:6", ich.GetInventoryEntry(6).Item)
      invItem.set("${uid}:7", ich.GetInventoryEntry(7).Item)
      invItem.set("${uid}:8", ich.GetInventoryEntry(8).Item)
      invItem.set("${uid}:9", ich.GetInventoryEntry(9).Item)
      invHas.set(uid, 1)
      // (owner 2026-10-11: "they NEED to keep the data") the slots go to the log
      // whenever they change; the progress plugin keeps them on disk
      let invLine = "${ich.GetInventoryEntry(0).Item}|${ich.GetInventoryEntry(1).Item}|${ich.GetInventoryEntry(2).Item}|${ich.GetInventoryEntry(3).Item}|${ich.GetInventoryEntry(4).Item}|${ich.GetInventoryEntry(5).Item}|${ich.GetInventoryEntry(6).Item}|${ich.GetInventoryEntry(7).Item}|${ich.GetInventoryEntry(8).Item}|${ich.GetInventoryEntry(9).Item}"
      if !invLast.has(uid) || invLast.get(uid).Value != invLine {
        invLast.set(uid, invLine)
        PrintToConsole("[inv] ${uid} ${invLine}")
      }
    }
    let total = hp.GetLeaderboard("XP")
    let lvl = floor(sqrt(total / 25.0)) + 1
    let capMaxC = 100.0 * (1.0 + 0.05 * (lvl - 1))
    let capDmgC = hp.CharacterOf().GetDamage()
    let capHpC = capDmgC.DamageLimit - capDmgC.Damage
    if capHpC > capMaxC {
      hp.CharacterOf().SetDamage(capDmgC.DamageLimit - capMaxC)
    }
    hp.DisplayText("<b>Level ${lvl}</>", anchorX = 0.5, anchorY = 0.0, pivotX = 0.5, pivotY = 0.0, positionX = 0.0, positionY = 40.0,
      fontSize = 34, justify = Center, outlineSize = 2, lifetime = 86400.0, textId = 52001)
    hp.DisplayText("XP ${total} / ${25 * lvl * lvl}", anchorX = 0.5, anchorY = 0.0, pivotX = 0.5, pivotY = 0.0, positionX = 0.0, positionY = 82.0,
      fontSize = 22, justify = Center, outlineSize = 2, lifetime = 86400.0, textId = 52002)
    hp.DisplayText("<color=\"f6ce2a\">Coins ${hp.GetLeaderboard("coins")}</>", anchorX = 0.5, anchorY = 0.0, pivotX = 0.5, pivotY = 0.0, positionX = 0.0, positionY = 112.0,
      fontSize = 22, justify = Center, outlineSize = 2, lifetime = 86400.0, textId = 52003)
    hudIdx = hudIdx + 1
  }
}

on ChatCommand("coins", "How many coins you have") -> (ctrl, args) {
  ctrl.ShowChatMessage("<color=\"f6ce2a\"><b>${ctrl.GetLeaderboard("coins")} coins</></>")
}
on ChatCommand("level", "Your level and XP") -> (ctrl, args) {
  let total = ctrl.GetLeaderboard("XP")
  let lvl = floor(sqrt(total / 25.0)) + 1
  let next = 25 * lvl * lvl
  ctrl.ShowChatMessage("<color=\"46aaff\"><b>Level ${lvl}</></> - ${total} XP, level ${lvl + 1} at ${next} XP. Kill skeletons for XP (tougher ones give more).")
  ctrl.DisplayText("<b>Level ${lvl}</>", anchorX = 0.5, anchorY = 0.0, pivotX = 0.5, pivotY = 0.0, positionX = 0.0, positionY = 40.0,
    fontSize = 34, justify = Center, outlineSize = 2, lifetime = 86400.0, textId = 52001)
  ctrl.DisplayText("XP ${total} / ${25 * lvl * lvl}", anchorX = 0.5, anchorY = 0.0, pivotX = 0.5, pivotY = 0.0, positionX = 0.0, positionY = 82.0,
    fontSize = 22, justify = Center, outlineSize = 2, lifetime = 86400.0, textId = 52002)
  ctrl.DisplayText("<color=\"f6ce2a\">Coins ${ctrl.GetLeaderboard("coins")}</>", anchorX = 0.5, anchorY = 0.0, pivotX = 0.5, pivotY = 0.0, positionX = 0.0, positionY = 112.0,
    fontSize = 22, justify = Center, outlineSize = 2, lifetime = 86400.0, textId = 52003)
}

on CharacterSpawned() -> (character) {
  let sc = character.ControllerOf()
  let suid = sc.GetUserId()
  if !invLive.has(suid) || invLive.get(suid) != 1 {
    if invHas.has(suid) {
      PrintToConsole("[inv-restored] ${suid}")
      let it0 = invItem.get("${suid}:0").Value
      if it0 == $BRItemBase/Weapon_ArmingSword && sc.GetLeaderboard("SwordTier") > 0 {
        let tier = character.ControllerOf().GetLeaderboard("SwordTier")
        if tier == 1 {
          character.SetInventoryItemAdv($BRItemBase/Weapon_ArmingSword, slot = 0, damage = 0.50, itemName = "Bronze Sword", overrideColors = true, meshColors = [ColorSRGB(123, 72, 0, 255)])
        } else if tier == 2 {
          character.SetInventoryItemAdv($BRItemBase/Weapon_ArmingSword, slot = 0, damage = 0.65, itemName = "Iron Sword", overrideColors = true, meshColors = [ColorSRGB(88, 86, 84, 255)])
        } else if tier == 3 {
          character.SetInventoryItemAdv($BRItemBase/Weapon_ArmingSword, slot = 0, damage = 0.80, itemName = "Steel Sword", overrideColors = true, meshColors = [ColorSRGB(160, 160, 166, 255)])
        } else if tier == 4 {
          character.SetInventoryItemAdv($BRItemBase/Weapon_ArmingSword, slot = 0, damage = 1.00, itemName = "Black Sword", overrideColors = true, meshColors = [ColorSRGB(26, 26, 28, 255)])
        } else if tier == 5 {
          character.SetInventoryItemAdv($BRItemBase/Weapon_ArmingSword, slot = 0, damage = 1.20, itemName = "Mithril Sword", overrideColors = true, meshColors = [ColorSRGB(58, 58, 128, 255)])
        } else if tier == 6 {
          character.SetInventoryItemAdv($BRItemBase/Weapon_ArmingSword, slot = 0, damage = 1.50, itemName = "Adamant Sword", overrideColors = true, meshColors = [ColorSRGB(42, 96, 56, 255)])
        } else if tier == 7 {
          character.SetInventoryItemAdv($BRItemBase/Weapon_ArmingSword, slot = 0, damage = 2.00, itemName = "Rune Sword", overrideColors = true, meshColors = [ColorSRGB(38, 150, 178, 255)])
