          if p0 > 0 && pc0 == e8 {
            p0 = 0
            hp.SetLeaderboard("InvName0", 0)
            hp.SetLeaderboard("InvPend", hp.GetLeaderboard("InvPend") - 1)
            n8 = pn0
            invFix.set("${uid}:8", 1)
            invFixN.set(uid, 1)
          } else if p1 > 0 && pc1 == e8 {
            p1 = 0
            hp.SetLeaderboard("InvName1", 0)
            hp.SetLeaderboard("InvPend", hp.GetLeaderboard("InvPend") - 1)
            n8 = pn1
            invFix.set("${uid}:8", 1)
            invFixN.set(uid, 1)
          } else if p2 > 0 && pc2 == e8 {
            p2 = 0
            hp.SetLeaderboard("InvName2", 0)
            hp.SetLeaderboard("InvPend", hp.GetLeaderboard("InvPend") - 1)
            n8 = pn2
            invFix.set("${uid}:8", 1)
            invFixN.set(uid, 1)
          } else if p3 > 0 && pc3 == e8 {
            p3 = 0
            hp.SetLeaderboard("InvName3", 0)
            hp.SetLeaderboard("InvPend", hp.GetLeaderboard("InvPend") - 1)
            n8 = pn3
            invFix.set("${uid}:8", 1)
            invFixN.set(uid, 1)
          } else if p4 > 0 && pc4 == e8 {
            p4 = 0
            hp.SetLeaderboard("InvName4", 0)
            hp.SetLeaderboard("InvPend", hp.GetLeaderboard("InvPend") - 1)
            n8 = pn4
            invFix.set("${uid}:8", 1)
            invFixN.set(uid, 1)
          } else if p5 > 0 && pc5 == e8 {
            p5 = 0
            hp.SetLeaderboard("InvName5", 0)
            hp.SetLeaderboard("InvPend", hp.GetLeaderboard("InvPend") - 1)
            n8 = pn5
            invFix.set("${uid}:8", 1)
            invFixN.set(uid, 1)
          } else if p6 > 0 && pc6 == e8 {
            p6 = 0
            hp.SetLeaderboard("InvName6", 0)
            hp.SetLeaderboard("InvPend", hp.GetLeaderboard("InvPend") - 1)
            n8 = pn6
            invFix.set("${uid}:8", 1)
            invFixN.set(uid, 1)
          } else if p7 > 0 && pc7 == e8 {
            p7 = 0
            hp.SetLeaderboard("InvName7", 0)
            hp.SetLeaderboard("InvPend", hp.GetLeaderboard("InvPend") - 1)
            n8 = pn7
            invFix.set("${uid}:8", 1)
            invFixN.set(uid, 1)
          } else if p8 > 0 && pc8 == e8 {
            p8 = 0
            hp.SetLeaderboard("InvName8", 0)
            hp.SetLeaderboard("InvPend", hp.GetLeaderboard("InvPend") - 1)
            n8 = pn8
            invFix.set("${uid}:8", 1)
            invFixN.set(uid, 1)
          } else if p9 > 0 && pc9 == e8 {
            p9 = 0
            hp.SetLeaderboard("InvName9", 0)
            hp.SetLeaderboard("InvPend", hp.GetLeaderboard("InvPend") - 1)
            n8 = pn9
            invFix.set("${uid}:8", 1)
            invFixN.set(uid, 1)
          }
        }
        if n9 == "" {
          if p0 > 0 && pc0 == e9 {
            p0 = 0
            hp.SetLeaderboard("InvName0", 0)
            hp.SetLeaderboard("InvPend", hp.GetLeaderboard("InvPend") - 1)
            n9 = pn0
            invFix.set("${uid}:9", 1)
            invFixN.set(uid, 1)
          } else if p1 > 0 && pc1 == e9 {
            p1 = 0
            hp.SetLeaderboard("InvName1", 0)
            hp.SetLeaderboard("InvPend", hp.GetLeaderboard("InvPend") - 1)
            n9 = pn1
            invFix.set("${uid}:9", 1)
