    }
    if Random(0, 99) < 30 {
      let it = Random(1, 4)
      if it == 1 {
        SpawnPrefab(prefab = $./item_soda.brz, offset = at + Vec(0.0, 0.0, 16.0), velocity = Vec(0.0, 50.0, 220.0), lifetime = 30.0, limit = 100)
      } else if it == 2 {
