        } else if tier == 5 {
          character.SetInventoryItemAdv($BRItemBase/Weapon_ArmingSword, slot = 7, damage = 1.20, itemName = "Mithril Sword", overrideColors = true, meshColors = [ColorSRGB(58, 58, 128, 255)])
        } else if tier == 6 {
