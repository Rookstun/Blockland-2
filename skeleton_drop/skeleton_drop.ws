      }
    }
    invLive.set(suid, 1)
  }
  invSeen.set(suid, GetUnixTime())
  let total = sc.GetLeaderboard("XP")
  let lvl = floor(sqrt(total / 25.0)) + 1
  // players only: bots spawn too, with their own health (2026-10-08: capping
  // them as level-1 players left every enemy nearly dead)
  if sc.GetUserName().Length() > 0 {
    let capMaxS = 100.0 * (1.0 + 0.05 * (lvl - 1))
    let capDmgS = character.GetDamage()
    let capHpS = capDmgS.DamageLimit - capDmgS.Damage
    if capHpS > capMaxS {
      character.SetDamage(capDmgS.DamageLimit - capMaxS)
    }
  }
  teamLvl = lvl
  let lteam = GetTeamByName("Chud")
  if lteam.GetTeamName().Length() > 0 && sc.GetUserName().Length() > 0 {
    sc.SetTeam(lteam)
  }
  sc.DisplayText("<b>Level ${lvl}</>", anchorX = 0.5, anchorY = 0.0, pivotX = 0.5, pivotY = 0.0, positionX = 0.0, positionY = 40.0,
    fontSize = 34, justify = Center, outlineSize = 2, lifetime = 86400.0, textId = 52001)
  sc.DisplayText("XP ${total} / ${25 * lvl * lvl}", anchorX = 0.5, anchorY = 0.0, pivotX = 0.5, pivotY = 0.0, positionX = 0.0, positionY = 82.0,
    fontSize = 22, justify = Center, outlineSize = 2, lifetime = 86400.0, textId = 52002)
  sc.DisplayText("<color=\"f6ce2a\">Coins ${sc.GetLeaderboard("coins")}</>", anchorX = 0.5, anchorY = 0.0, pivotX = 0.5, pivotY = 0.0, positionX = 0.0, positionY = 112.0,
    fontSize = 22, justify = Center, outlineSize = 2, lifetime = 86400.0, textId = 52003)
}
