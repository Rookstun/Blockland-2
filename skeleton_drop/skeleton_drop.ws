// catalog id (index + 1, as the progress plugin writes it) -> item class / shop name
mod catClass(id: int) -> entity {
  if id == 1 {
    return $BRItemBase/Weapon_Bow
  }
  if id == 2 {
    return $BRItemBase/Weapon_Bow
  }
  if id == 3 {
    return $BRItemBase/Weapon_Bow
  }
  if id == 4 {
    return $BRItemBase/Weapon_Bow
