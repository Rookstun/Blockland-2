// skeleton_drop.ws -- generated by gen.js (edit the table there, then
// node gen.js && node build.mjs). When a dungeon skeleton dies, it drops coins
// where it died and gives the killer XP: each skeleton gets some rolls; each
// roll drops a coin with its drop chance, brown (+1) / silver (+10) / gold
// (+25) "coins" by its odds; the killer gets the XP on the leaderboard:
//   handaxe                2 rolls,  60% drop, brown 85% silver 15% gold 0%, 5 XP
//   arming                 2 rolls,  70% drop, brown 75% silver 22% gold 3%, 8 XP
//   spear                  3 rolls,  70% drop, brown 65% silver 30% gold 5%, 12 XP
//   longsword              3 rolls,  80% drop, brown 55% silver 35% gold 10%, 18 XP
//   bow                    4 rolls,  80% drop, brown 45% silver 40% gold 15%, 25 XP
//   zweihander             4 rolls,  90% drop, brown 35% silver 45% gold 20%, 35 XP
//   battleaxe              5 rolls, 100% drop, brown 25% silver 45% gold 30%, 50 XP
//   wood goblin            3 rolls,  75% drop, brown 70% silver 25% gold 5%, 10 XP
//   goblin                 2 rolls,  70% drop, brown 80% silver 18% gold 2%, 6 XP
//   wizard                 5 rolls, 100% drop, brown 20% silver 45% gold 35%, 60 XP
//   bloated                4 rolls,  90% drop, brown 40% silver 45% gold 15%, 30 XP
//   zombie                 3 rolls,  75% drop, brown 60% silver 33% gold 7%, 15 XP
//   (any other skeleton)   3 rolls,  70% drop, brown 65% silver 30% gold 5%, 12 XP
// Coins are flung out a little so they scatter. The chip also pulses Died
// and puts the spot on Location (world) / Offset (relative to this chip).

const FLING = 120.0   // sideways speed of a dropped coin
const POP = 250.0     // upward speed

var location: vector = Vec(0.0, 0.0, 0.0)
var offset: vector = Vec(0.0, 0.0, 0.0)
var rolls: int = 0
var xp: int = 0
var dropPct: int = 0
var brownPct: int = 0
var silverPct: int = 0
out Location: vector = location
out Offset: vector = offset
out Died: exec
var kc: controller
var teamLvl: int = 1
// who last hurt each character, for kill credit when CharacterDied gives no killer
var hitBy: Map<character, controller>
on CharacterDamaged() -> (victim, damage, attacker, attackerWeapon, attackerWeaponName) {
  let ac = attacker.ControllerOf()
  PrintToConsole("[hit debug] victim=${victim.ControllerOf().GetUserName()} attacker=${ac.GetUserName()} weapon=${attackerWeaponName} dmg=${damage} total=${victim.GetDamage()}")
  if ac.GetUserName().Length() > 0 {
    hitBy.set(victim, ac)
  }
  // +5% health per level: hand back the share of the hit the bonus soaks up
  let vc = victim.ControllerOf()
  if vc.GetUserName().Length() > 0 {
    let vl = vc.GetLeaderboard("Level")
    if vl > 1 {
      victim.IncDamage(0.0 - damage * (1.0 - 1.0 / (1.0 + 0.05 * (vl - 1))))
    }
    // (owner 2026-10-06) over 100 damage taken and you're done: straight to 400.
    // The per-level cut above shrinks every hit first, so higher levels last
    // longer (level 1 dies at 100, level 10 at ~145, level 50 at ~345)
    let tot = victim.GetDamage()
    if tot > 100.0 && tot < 400.0 {
      victim.IncDamage(400.0 - tot)
    }
  }
}

on CharacterDied() -> (who, killer, killerWeapon, killerWeaponName) {
  let name = who.ControllerOf().GetDisplayName().ToLower()
  let dbgUser = who.ControllerOf().GetUserName()
  let dbgTag = who.GetTag()
  PrintToConsole("[xp debug] died: user=${dbgUser} tag=${dbgTag}")
  if name.Contains("handaxe") {
    xp = 5
    rolls = 2
    dropPct = 60
    brownPct = 85
    silverPct = 15
  } else if name.Contains("arming") {
    xp = 8
    rolls = 2
    dropPct = 70
    brownPct = 75
    silverPct = 22
  } else if name.Contains("spear") {
    xp = 12
    rolls = 3
    dropPct = 70
    brownPct = 65
    silverPct = 30
  } else if name.Contains("longsword") {
    xp = 18
    rolls = 3
    dropPct = 80
    brownPct = 55
    silverPct = 35
  } else if name.Contains("bow") {
    xp = 25
    rolls = 4
    dropPct = 80
    brownPct = 45
    silverPct = 40
  } else if name.Contains("zweihander") {
    xp = 35
    rolls = 4
    dropPct = 90
    brownPct = 35
    silverPct = 45
  } else if name.Contains("battleaxe") {
    xp = 50
    rolls = 5
    dropPct = 100
    brownPct = 25
    silverPct = 45
  } else if name.Contains("wood goblin") {
    xp = 10
    rolls = 3
    dropPct = 75
    brownPct = 70
    silverPct = 25
  } else if name.Contains("goblin") {
    xp = 6
    rolls = 2
    dropPct = 70
    brownPct = 80
    silverPct = 18
  } else if name.Contains("wizard") {
    xp = 60
    rolls = 5
    dropPct = 100
    brownPct = 20
    silverPct = 45
  } else if name.Contains("bloated") {
    xp = 30
    rolls = 4
    dropPct = 90
    brownPct = 40
    silverPct = 45
  } else if name.Contains("zombie") {
    xp = 15
    rolls = 3
    dropPct = 75
    brownPct = 60
    silverPct = 33
  } else if name.Contains("skeleton") || name.Length() == 0 {
    xp = 12
    rolls = 3
    dropPct = 70
    brownPct = 65
    silverPct = 30
  } else {
    rolls = 0
  }
  PrintToConsole("[xp debug] A rolls=${rolls} xp=${xp} len=${name.Length()}")
  if rolls > 0 {
    location = who.GetLocation()
    PrintToConsole("[xp debug] B at ${location}")
    offset = location - GetOwnTransform().Location
    let at = offset + Vec(0.0, 0.0, 20.0)
    if rolls >= 1 && Random(0, 99) < dropPct {
      let ang1 = Random(0, 359) * 0.0174533
      let vel1 = Vec(cos(ang1) * FLING, sin(ang1) * FLING, POP)
      let roll1 = Random(0, 99)
      if roll1 < brownPct {
        SpawnPrefab(prefab = $./coin1.brz, offset = at, velocity = vel1, lifetime = 0.0, limit = 200)
      } else if roll1 < brownPct + silverPct {
        SpawnPrefab(prefab = $./coin10.brz, offset = at, velocity = vel1, lifetime = 0.0, limit = 200)
      } else {
        SpawnPrefab(prefab = $./coin25.brz, offset = at, velocity = vel1, lifetime = 0.0, limit = 200)
      }
    }
    if rolls >= 2 && Random(0, 99) < dropPct {
      let ang2 = Random(0, 359) * 0.0174533
      let vel2 = Vec(cos(ang2) * FLING, sin(ang2) * FLING, POP)
      let roll2 = Random(0, 99)
      if roll2 < brownPct {
        SpawnPrefab(prefab = $./coin1.brz, offset = at, velocity = vel2, lifetime = 0.0, limit = 200)
      } else if roll2 < brownPct + silverPct {
        SpawnPrefab(prefab = $./coin10.brz, offset = at, velocity = vel2, lifetime = 0.0, limit = 200)
      } else {
        SpawnPrefab(prefab = $./coin25.brz, offset = at, velocity = vel2, lifetime = 0.0, limit = 200)
      }
    }
    if rolls >= 3 && Random(0, 99) < dropPct {
      let ang3 = Random(0, 359) * 0.0174533
      let vel3 = Vec(cos(ang3) * FLING, sin(ang3) * FLING, POP)
      let roll3 = Random(0, 99)
      if roll3 < brownPct {
        SpawnPrefab(prefab = $./coin1.brz, offset = at, velocity = vel3, lifetime = 0.0, limit = 200)
      } else if roll3 < brownPct + silverPct {
        SpawnPrefab(prefab = $./coin10.brz, offset = at, velocity = vel3, lifetime = 0.0, limit = 200)
      } else {
        SpawnPrefab(prefab = $./coin25.brz, offset = at, velocity = vel3, lifetime = 0.0, limit = 200)
      }
    }
    if rolls >= 4 && Random(0, 99) < dropPct {
      let ang4 = Random(0, 359) * 0.0174533
      let vel4 = Vec(cos(ang4) * FLING, sin(ang4) * FLING, POP)
      let roll4 = Random(0, 99)
      if roll4 < brownPct {
        SpawnPrefab(prefab = $./coin1.brz, offset = at, velocity = vel4, lifetime = 0.0, limit = 200)
      } else if roll4 < brownPct + silverPct {
        SpawnPrefab(prefab = $./coin10.brz, offset = at, velocity = vel4, lifetime = 0.0, limit = 200)
      } else {
        SpawnPrefab(prefab = $./coin25.brz, offset = at, velocity = vel4, lifetime = 0.0, limit = 200)
      }
    }
    if rolls >= 5 && Random(0, 99) < dropPct {
      let ang5 = Random(0, 359) * 0.0174533
      let vel5 = Vec(cos(ang5) * FLING, sin(ang5) * FLING, POP)
      let roll5 = Random(0, 99)
      if roll5 < brownPct {
        SpawnPrefab(prefab = $./coin1.brz, offset = at, velocity = vel5, lifetime = 0.0, limit = 200)
      } else if roll5 < brownPct + silverPct {
        SpawnPrefab(prefab = $./coin10.brz, offset = at, velocity = vel5, lifetime = 0.0, limit = 200)
      } else {
        SpawnPrefab(prefab = $./coin25.brz, offset = at, velocity = vel5, lifetime = 0.0, limit = 200)
      }
    }
    // XP and level for the killer. CharacterDied leaves the killer empty when a
    // bot dies, so fall back to the last player who damaged it (hitBy)
    kc = killer.ControllerOf()
    if kc.GetUserName().Length() == 0 {
      kc = hitBy.get(who)
    }
    hitBy.remove(who)
    PrintToConsole("[xp debug] C killer=${kc.GetUserName()}")
    if kc.GetUserName().Length() > 0 {
      kc.IncLeaderboard("XP", xp)
      let total = kc.GetLeaderboard("XP")
      let lvl = floor(sqrt(total / 25.0)) + 1
      kc.ShowStatusMessage("+${xp} XP")
      if lvl > kc.GetLeaderboard("Level") {
        kc.SetLeaderboard("Level", lvl)
        kc.ShowStatusMessage("LEVEL UP! You are level ${lvl}")
        teamLvl = lvl
        let lteam = GetTeamByName("Chud")
        if lteam.GetTeamName().Length() > 0 && kc.GetUserName().Length() > 0 {
          kc.SetTeam(lteam)
        }
        kc.ShowChatMessage("<color=\"46aaff\"><b>Level up!</> You reached level ${lvl}. /level shows your progress.</>")
      }
        kc.DisplayText("<b>Level ${lvl}</>", anchorX = 1.0, anchorY = 0.0, pivotX = 1.0, pivotY = 0.0, positionX = -30.0, positionY = 30.0,
        fontSize = 34, justify = Right, outlineSize = 2, lifetime = 86400.0, textId = 52001)
      kc.DisplayText("XP ${total} / ${25 * lvl * lvl}", anchorX = 1.0, anchorY = 0.0, pivotX = 1.0, pivotY = 0.0, positionX = -30.0, positionY = 72.0,
        fontSize = 22, justify = Right, outlineSize = 2, lifetime = 86400.0, textId = 52002)
      kc.DisplayText("<color=\"f6ce2a\">Coins ${kc.GetLeaderboard("coins")}</>", anchorX = 1.0, anchorY = 0.0, pivotX = 1.0, pivotY = 0.0, positionX = -30.0, positionY = 102.0,
        fontSize = 22, justify = Right, outlineSize = 2, lifetime = 86400.0, textId = 52003)

    }
    emit Died
  }
}

// HUD refresh: coins change outside this chip (coin pickups, shops), so every
// 0.25 s redraw the next player's HUD in turn
var hudPlayers: controller[]
var hudIdx: int = 0
var invCoins: Map<string, int>
var invSeen: Map<string, int>
var invLive: Map<string, int>
var invHas: Map<string, int>
var invItem: Map<string, entity>
on ControllerLeft() -> (controller, userId, userName) {
  invLive.set(userId, 0)
}
on Clock(interval = 0.25) {
  hudPlayers.fillFromPlayers()
  let n = hudPlayers.length()
  if n > 0 {
    if hudIdx >= n {
      hudIdx = 0
    }
    let hp = hudPlayers[hudIdx]
    let uid = hp.GetUserId()
    let coinsNow = hp.GetLeaderboard("coins")
    if invCoins.has(uid) {
      let spent = invCoins.get(uid) - coinsNow
      if spent == 150 {
        hp.SetLeaderboard("SwordTier", 1)
      } else if spent == 400 {
        hp.SetLeaderboard("SwordTier", 2)
      } else if spent == 1000 {
        hp.SetLeaderboard("SwordTier", 3)
      } else if spent == 2000 {
        hp.SetLeaderboard("SwordTier", 4)
      } else if spent == 4000 {
        hp.SetLeaderboard("SwordTier", 5)
      } else if spent == 8000 {
        hp.SetLeaderboard("SwordTier", 6)
      } else if spent == 20000 {
        hp.SetLeaderboard("SwordTier", 7)
      }
    }
    invCoins.set(uid, coinsNow)
    invSeen.set(uid, GetUnixTime())
    if invLive.has(uid) && invLive.get(uid) == 1 {
      let ich = hp.CharacterOf()
      invItem.set("${uid}:0", ich.GetInventoryEntry(0).Item)
      invItem.set("${uid}:1", ich.GetInventoryEntry(1).Item)
      invItem.set("${uid}:2", ich.GetInventoryEntry(2).Item)
      invItem.set("${uid}:3", ich.GetInventoryEntry(3).Item)
      invItem.set("${uid}:4", ich.GetInventoryEntry(4).Item)
      invItem.set("${uid}:5", ich.GetInventoryEntry(5).Item)
      invItem.set("${uid}:6", ich.GetInventoryEntry(6).Item)
      invItem.set("${uid}:7", ich.GetInventoryEntry(7).Item)
      invItem.set("${uid}:8", ich.GetInventoryEntry(8).Item)
      invItem.set("${uid}:9", ich.GetInventoryEntry(9).Item)
      invHas.set(uid, 1)
    }
    let total = hp.GetLeaderboard("XP")
    let lvl = floor(sqrt(total / 25.0)) + 1
    hp.DisplayText("<b>Level ${lvl}</>", anchorX = 1.0, anchorY = 0.0, pivotX = 1.0, pivotY = 0.0, positionX = -30.0, positionY = 30.0,
      fontSize = 34, justify = Right, outlineSize = 2, lifetime = 86400.0, textId = 52001)
    hp.DisplayText("XP ${total} / ${25 * lvl * lvl}", anchorX = 1.0, anchorY = 0.0, pivotX = 1.0, pivotY = 0.0, positionX = -30.0, positionY = 72.0,
      fontSize = 22, justify = Right, outlineSize = 2, lifetime = 86400.0, textId = 52002)
    hp.DisplayText("<color=\"f6ce2a\">Coins ${hp.GetLeaderboard("coins")}</>", anchorX = 1.0, anchorY = 0.0, pivotX = 1.0, pivotY = 0.0, positionX = -30.0, positionY = 102.0,
      fontSize = 22, justify = Right, outlineSize = 2, lifetime = 86400.0, textId = 52003)
    hudIdx = hudIdx + 1
  }
}

on ChatCommand("coins", "How many coins you have") -> (ctrl, args) {
  ctrl.ShowChatMessage("<color=\"f6ce2a\"><b>${ctrl.GetLeaderboard("coins")} coins</></>")
}
on ChatCommand("level", "Your level and XP") -> (ctrl, args) {
  let total = ctrl.GetLeaderboard("XP")
  let lvl = floor(sqrt(total / 25.0)) + 1
  let next = 25 * lvl * lvl
  ctrl.ShowChatMessage("<color=\"46aaff\"><b>Level ${lvl}</></> - ${total} XP, level ${lvl + 1} at ${next} XP. Kill skeletons for XP (tougher ones give more).")
  ctrl.DisplayText("<b>Level ${lvl}</>", anchorX = 1.0, anchorY = 0.0, pivotX = 1.0, pivotY = 0.0, positionX = -30.0, positionY = 30.0,
    fontSize = 34, justify = Right, outlineSize = 2, lifetime = 86400.0, textId = 52001)
  ctrl.DisplayText("XP ${total} / ${25 * lvl * lvl}", anchorX = 1.0, anchorY = 0.0, pivotX = 1.0, pivotY = 0.0, positionX = -30.0, positionY = 72.0,
    fontSize = 22, justify = Right, outlineSize = 2, lifetime = 86400.0, textId = 52002)
  ctrl.DisplayText("<color=\"f6ce2a\">Coins ${ctrl.GetLeaderboard("coins")}</>", anchorX = 1.0, anchorY = 0.0, pivotX = 1.0, pivotY = 0.0, positionX = -30.0, positionY = 102.0,
    fontSize = 22, justify = Right, outlineSize = 2, lifetime = 86400.0, textId = 52003)
}

on CharacterSpawned() -> (character) {
  let sc = character.ControllerOf()
  let suid = sc.GetUserId()
  if !invLive.has(suid) || invLive.get(suid) != 1 {
    if invHas.has(suid) {
      let it0 = invItem.get("${suid}:0").Value
      if it0 == $BRItemBase/Weapon_ArmingSword && sc.GetLeaderboard("SwordTier") > 0 {
        let tier = character.ControllerOf().GetLeaderboard("SwordTier")
        if tier == 1 {
          character.SetInventoryItemAdv($BRItemBase/Weapon_ArmingSword, slot = 0, damage = 0.50, itemName = "Bronze Sword", overrideColors = true, meshColors = [ColorSRGB(123, 72, 0, 255)])
        } else if tier == 2 {
          character.SetInventoryItemAdv($BRItemBase/Weapon_ArmingSword, slot = 0, damage = 0.65, itemName = "Iron Sword", overrideColors = true, meshColors = [ColorSRGB(88, 86, 84, 255)])
        } else if tier == 3 {
          character.SetInventoryItemAdv($BRItemBase/Weapon_ArmingSword, slot = 0, damage = 0.80, itemName = "Steel Sword", overrideColors = true, meshColors = [ColorSRGB(160, 160, 166, 255)])
        } else if tier == 4 {
          character.SetInventoryItemAdv($BRItemBase/Weapon_ArmingSword, slot = 0, damage = 1.00, itemName = "Black Sword", overrideColors = true, meshColors = [ColorSRGB(26, 26, 28, 255)])
        } else if tier == 5 {
          character.SetInventoryItemAdv($BRItemBase/Weapon_ArmingSword, slot = 0, damage = 1.20, itemName = "Mithril Sword", overrideColors = true, meshColors = [ColorSRGB(58, 58, 128, 255)])
        } else if tier == 6 {
          character.SetInventoryItemAdv($BRItemBase/Weapon_ArmingSword, slot = 0, damage = 1.50, itemName = "Adamant Sword", overrideColors = true, meshColors = [ColorSRGB(42, 96, 56, 255)])
        } else if tier == 7 {
          character.SetInventoryItemAdv($BRItemBase/Weapon_ArmingSword, slot = 0, damage = 2.00, itemName = "Rune Sword", overrideColors = true, meshColors = [ColorSRGB(38, 150, 178, 255)])
        }
      } else {
        character.SetInventoryItem(it0, 0)
      }
      let it1 = invItem.get("${suid}:1").Value
      if it1 == $BRItemBase/Weapon_ArmingSword && sc.GetLeaderboard("SwordTier") > 0 {
        let tier = character.ControllerOf().GetLeaderboard("SwordTier")
        if tier == 1 {
          character.SetInventoryItemAdv($BRItemBase/Weapon_ArmingSword, slot = 1, damage = 0.50, itemName = "Bronze Sword", overrideColors = true, meshColors = [ColorSRGB(123, 72, 0, 255)])
        } else if tier == 2 {
          character.SetInventoryItemAdv($BRItemBase/Weapon_ArmingSword, slot = 1, damage = 0.65, itemName = "Iron Sword", overrideColors = true, meshColors = [ColorSRGB(88, 86, 84, 255)])
        } else if tier == 3 {
          character.SetInventoryItemAdv($BRItemBase/Weapon_ArmingSword, slot = 1, damage = 0.80, itemName = "Steel Sword", overrideColors = true, meshColors = [ColorSRGB(160, 160, 166, 255)])
        } else if tier == 4 {
          character.SetInventoryItemAdv($BRItemBase/Weapon_ArmingSword, slot = 1, damage = 1.00, itemName = "Black Sword", overrideColors = true, meshColors = [ColorSRGB(26, 26, 28, 255)])
        } else if tier == 5 {
          character.SetInventoryItemAdv($BRItemBase/Weapon_ArmingSword, slot = 1, damage = 1.20, itemName = "Mithril Sword", overrideColors = true, meshColors = [ColorSRGB(58, 58, 128, 255)])
        } else if tier == 6 {
          character.SetInventoryItemAdv($BRItemBase/Weapon_ArmingSword, slot = 1, damage = 1.50, itemName = "Adamant Sword", overrideColors = true, meshColors = [ColorSRGB(42, 96, 56, 255)])
        } else if tier == 7 {
          character.SetInventoryItemAdv($BRItemBase/Weapon_ArmingSword, slot = 1, damage = 2.00, itemName = "Rune Sword", overrideColors = true, meshColors = [ColorSRGB(38, 150, 178, 255)])
        }
      } else {
        character.SetInventoryItem(it1, 1)
      }
      let it2 = invItem.get("${suid}:2").Value
      if it2 == $BRItemBase/Weapon_ArmingSword && sc.GetLeaderboard("SwordTier") > 0 {
        let tier = character.ControllerOf().GetLeaderboard("SwordTier")
        if tier == 1 {
          character.SetInventoryItemAdv($BRItemBase/Weapon_ArmingSword, slot = 2, damage = 0.50, itemName = "Bronze Sword", overrideColors = true, meshColors = [ColorSRGB(123, 72, 0, 255)])
        } else if tier == 2 {
          character.SetInventoryItemAdv($BRItemBase/Weapon_ArmingSword, slot = 2, damage = 0.65, itemName = "Iron Sword", overrideColors = true, meshColors = [ColorSRGB(88, 86, 84, 255)])
        } else if tier == 3 {
          character.SetInventoryItemAdv($BRItemBase/Weapon_ArmingSword, slot = 2, damage = 0.80, itemName = "Steel Sword", overrideColors = true, meshColors = [ColorSRGB(160, 160, 166, 255)])
        } else if tier == 4 {
          character.SetInventoryItemAdv($BRItemBase/Weapon_ArmingSword, slot = 2, damage = 1.00, itemName = "Black Sword", overrideColors = true, meshColors = [ColorSRGB(26, 26, 28, 255)])
        } else if tier == 5 {
          character.SetInventoryItemAdv($BRItemBase/Weapon_ArmingSword, slot = 2, damage = 1.20, itemName = "Mithril Sword", overrideColors = true, meshColors = [ColorSRGB(58, 58, 128, 255)])
        } else if tier == 6 {
          character.SetInventoryItemAdv($BRItemBase/Weapon_ArmingSword, slot = 2, damage = 1.50, itemName = "Adamant Sword", overrideColors = true, meshColors = [ColorSRGB(42, 96, 56, 255)])
        } else if tier == 7 {
          character.SetInventoryItemAdv($BRItemBase/Weapon_ArmingSword, slot = 2, damage = 2.00, itemName = "Rune Sword", overrideColors = true, meshColors = [ColorSRGB(38, 150, 178, 255)])
        }
      } else {
        character.SetInventoryItem(it2, 2)
      }
      let it3 = invItem.get("${suid}:3").Value
      if it3 == $BRItemBase/Weapon_ArmingSword && sc.GetLeaderboard("SwordTier") > 0 {
        let tier = character.ControllerOf().GetLeaderboard("SwordTier")
        if tier == 1 {
          character.SetInventoryItemAdv($BRItemBase/Weapon_ArmingSword, slot = 3, damage = 0.50, itemName = "Bronze Sword", overrideColors = true, meshColors = [ColorSRGB(123, 72, 0, 255)])
        } else if tier == 2 {
          character.SetInventoryItemAdv($BRItemBase/Weapon_ArmingSword, slot = 3, damage = 0.65, itemName = "Iron Sword", overrideColors = true, meshColors = [ColorSRGB(88, 86, 84, 255)])
        } else if tier == 3 {
          character.SetInventoryItemAdv($BRItemBase/Weapon_ArmingSword, slot = 3, damage = 0.80, itemName = "Steel Sword", overrideColors = true, meshColors = [ColorSRGB(160, 160, 166, 255)])
        } else if tier == 4 {
          character.SetInventoryItemAdv($BRItemBase/Weapon_ArmingSword, slot = 3, damage = 1.00, itemName = "Black Sword", overrideColors = true, meshColors = [ColorSRGB(26, 26, 28, 255)])
        } else if tier == 5 {
          character.SetInventoryItemAdv($BRItemBase/Weapon_ArmingSword, slot = 3, damage = 1.20, itemName = "Mithril Sword", overrideColors = true, meshColors = [ColorSRGB(58, 58, 128, 255)])
        } else if tier == 6 {
          character.SetInventoryItemAdv($BRItemBase/Weapon_ArmingSword, slot = 3, damage = 1.50, itemName = "Adamant Sword", overrideColors = true, meshColors = [ColorSRGB(42, 96, 56, 255)])
        } else if tier == 7 {
          character.SetInventoryItemAdv($BRItemBase/Weapon_ArmingSword, slot = 3, damage = 2.00, itemName = "Rune Sword", overrideColors = true, meshColors = [ColorSRGB(38, 150, 178, 255)])
        }
      } else {
        character.SetInventoryItem(it3, 3)
      }
      let it4 = invItem.get("${suid}:4").Value
      if it4 == $BRItemBase/Weapon_ArmingSword && sc.GetLeaderboard("SwordTier") > 0 {
        let tier = character.ControllerOf().GetLeaderboard("SwordTier")
        if tier == 1 {
