var rh: int[] = []

var song: int = -1
var mi0: int = 0
var md0: int = 0
var mt0: int = 0
var mp0: float = 0.0
var mi1: int = 0
var md1: int = 0
var mp1: float = 0.0
var fxId: int = -1
var fxI: int = 0
var aP0: float = 1.0
var aV0: float = 0.0
var aP1: float = 1.0
var aV1: float = 0.0
var aP2: float = 1.0
var aV2: float = 0.0

@right out strip0: string = st0
@right out strip1: string = st1
@right out strip2: string = st2
@right out strip3: string = st3
@right out strip4: string = st4
@right out strip5: string = st5
@right out strip6: string = st6
@right out strip7: string = st7
@right out strip8: string = st8
@right out msg_: string = msg
@right out hud_: string = hud
@right out title_: string = if state == 0 then "SUPER PENIS MAN" else ""
@right out P0: float = aP0
@right out V0: float = aV0
@right out P1: float = aP1
@right out V1: float = aV1
@right out P2: float = aP2
@right out V2: float = aV2
@right out state_: int = state

// ---------- helpers
mod say(s: string, n: int) {
  msg = s
  msgT = n
}
mod playSong(s: int) {
  song = s
  mi0 = 0
  md0 = 0
  mi1 = 0
  md1 = 0
  mp0 = 0.0
  mp1 = 0.0
}
mod sfx(k: int) {
  fxId = k
  fxI = 0
}
mod overlap(ax: float, ay: float, aw: float, ah: float, bx0: float, by0: float, bw: float, bh: float) -> bool {
  return ax < bx0 + bw && bx0 < ax + aw && ay < by0 + bh && by0 < ay + ah
}

// ---------- sound
mod audio() {
  if song >= 0 {
    md0 -= 1
    if md0 <= 0 {
      if mi0 >= VL0[song] && SLOOP[song] > 0 { mi0 = 0 }
      if mi0 < VL0[song] {
        let n = VO0[song] + mi0
        mp0 = NP0[n]
        md0 = ND0[n]
        mt0 = 0
        mi0 += 1
      } else {
        mp0 = 0.0
        md0 = 100000
      }
    }
    md1 -= 1
    if md1 <= 0 {
      if mi1 >= VL1[song] && SLOOP[song] > 0 { mi1 = 0 }
      if mi1 < VL1[song] {
        let n = VO1[song] + mi1
        mp1 = NP1[n]
        md1 = ND1[n]
        mi1 += 1
      } else {
        mp1 = 0.0
        md1 = 100000
      }
    }
    mt0 += 1
  }
  if mp0 > 0.0 {
    aP0 = mp0
    aV0 = if md0 <= 1 then 0.0 else 0.3 * max(0.4, 1.0 - mt0 * 0.06)
  } else { aV0 = 0.0 }
  if mp1 > 0.0 {
    aP1 = mp1
    aV1 = if md1 <= 1 then 0.0 else 0.55
  } else { aV1 = 0.0 }
  if fxId >= 0 {
    if fxI < FXL[fxId] {
      aP2 = FXP[FXO[fxId] + fxI]
      aV2 = 0.5
      fxI += 1
    } else {
      fxId = -1
      aV2 = 0.0
    }
  } else { aV2 = 0.0 }
}

// ---------- drawing
mod eraseRect(x: int, y: int, w: int, h: int) {
  for j in 0..w * h {
    let cx = x + j % w
    let cy = y + j / w
    if cx >= 0 && cx < W && cy >= 0 && cy < H {
      let i = cy * W + cx
      if fb[i] != bg[i] {
        fb[i] = bg[i]
        dirty[cy] = 1
      }
    }
  }
}
mod put(cx: int, cy: int, c: int) {
  if cx >= 0 && cx < W && cy >= 0 && cy < H {
    let i = cy * W + cx
    if fb[i] != c {
      fb[i] = c
      dirty[cy] = 1
    }
  }
}
mod track(x: int, y: int, w: int, h: int) {
  rx.push(x)
  ry.push(y)
  rw.push(w)
  rh.push(h)
}
mod drawSpr(s: int, x: int, y: int, white: int) {
  let w = SW[s]
  let o = SOFF[s]
  for j in 0..w * SH[s] {
    let c = SPR[o + j]
    if c >= 0 { put(x + j % w, y + j / w, if white > 0 then 6 else c) }
  }
  track(x, y, w, SH[s])
}
mod fillRect(x: int, y: int, w: int, h: int, c: int) {
  for j in 0..w * h { put(x + j % w, y + j / w, c) }
  track(x, y, w, h)
}
mod encRow(r: int) {
  var s: string = ""
  var c0: int = -1
  var n: int = 0
  for c in 0..W {
    let p = fb[r * W + c]
    if p == c0 {
      n += 1
    } else {
      if n > 0 { s = s .. OPEN[c0] .. BLK[n] .. CLOSE[c0] }
      c0 = p
      n = 1
    }
  }
  rows[r] = s .. OPEN[c0] .. BLK[n] .. CLOSE[c0]
}
mod setScene() {
  bg.copyFrom(BGCITY)
  fb.copyFrom(bg)
  for i in 0..H { dirty[i] = 1 }
  rx.clear()
  ry.clear()
  rw.clear()
  rh.clear()
}
mod draw() {
  for i in 0..rx.length() { eraseRect(rx[i], ry[i], rw[i], rh[i]) }
  rx.clear()
  ry.clear()
  rw.clear()
  rh.clear()
  let fx: int = floor(hx)
  let fy: int = floor(hy)
  if state == 0 {
    drawSpr(if (t / 6) % 2 == 0 then 0 else 1, 19, 13 + (t / 10) % 2, 0)
  } else {
    if bigT > 0 { fillRect(fx + 9, fy + 1, 48 - fx - 9, 3, if bigT % 4 < 2 then 4 else 6) }
    for k in 0..NK {
      if kt[k] > 0 { drawSpr(KSPR[kt[k]], floor(kx[k]), floor(ky[k]), 0) }
    }
    for i in 0..NB {
      if ba[i] > 0 { drawSpr(2, floor(bx[i]), floor(by[i]), 0) }
    }
    for i in 0..NE {
      if ea[i] > 0 { drawSpr(8, floor(ex[i]), floor(ey[i]), 0) }
    }
    if bossOn { drawSpr(BOSS[lv - 1], floor(bossX), floor(bossY), if bossF > 0 then 1 else 0) }
    if state != 5 && (inv == 0 || t % 4 < 2) {
      drawSpr(if (t / 4) % 2 == 0 then 0 else 1, fx, fy, 0)
    }
    for i in 0..5 { put(1 + i * 2, 0, if i < hp then 5 else 11) }
    for i in 0..3 { put(13 + i * 2, 0, if i < pow then 7 else 11) }
    let bm: int = bigM * 16 / 100
    for i in 0..16 { put(31 + i, 0, if i < bm then (if bigM >= 100 && t % 8 < 4 then 6 else 4) else 11) }
    if bossOn {
      let hb: int = bossHp * 46 / bossMax
      for i in 0..46 { put(1 + i, 1, if i < hb then 12 else 11) }
    } else {
      let prog: int = min(46, floor(dist / GOAL[lv - 1] * 46.0))
      for i in 0..46 { put(1 + i, 1, if i < prog then 9 else 11) }
    }
  }
}
mod encode(r0: int, r1: int) {
  for r in r0..r1 {
    if dirty[r] > 0 {
      encRow(r)
      dirty[r] = 0
      sdirty[r / 4] = 1
    }
  }
  if sdirty[0] > 0 {
    st0 = rows[0] .. "\n" .. rows[1] .. "\n" .. rows[2] .. "\n" .. rows[3]
    sdirty[0] = 0
  }
  if sdirty[1] > 0 {
    st1 = rows[4] .. "\n" .. rows[5] .. "\n" .. rows[6] .. "\n" .. rows[7]
    sdirty[1] = 0
  }
  if sdirty[2] > 0 {
    st2 = rows[8] .. "\n" .. rows[9] .. "\n" .. rows[10] .. "\n" .. rows[11]
    sdirty[2] = 0
  }
  if sdirty[3] > 0 {
    st3 = rows[12] .. "\n" .. rows[13] .. "\n" .. rows[14] .. "\n" .. rows[15]
    sdirty[3] = 0
  }
  if sdirty[4] > 0 {
    st4 = rows[16] .. "\n" .. rows[17] .. "\n" .. rows[18] .. "\n" .. rows[19]
    sdirty[4] = 0
  }
  if sdirty[5] > 0 {
    st5 = rows[20] .. "\n" .. rows[21] .. "\n" .. rows[22] .. "\n" .. rows[23]
    sdirty[5] = 0
  }
  if sdirty[6] > 0 {
    st6 = rows[24] .. "\n" .. rows[25] .. "\n" .. rows[26] .. "\n" .. rows[27]
    sdirty[6] = 0
  }
  if sdirty[7] > 0 {
    st7 = rows[28] .. "\n" .. rows[29] .. "\n" .. rows[30] .. "\n" .. rows[31]
    sdirty[7] = 0
  }
  if sdirty[8] > 0 {
    st8 = rows[32] .. "\n" .. rows[33] .. "\n" .. rows[34] .. "\n" .. rows[35]
    sdirty[8] = 0
  }
}

// ---------- spawning
mod clearAll() {
  for k in 0..NK { kt[k] = 0 }
  for i in 0..NB { ba[i] = 0 }
  for i in 0..NE { ea[i] = 0 }
}
mod spawnEnemy(kind: int, y: float) {
  let k = kt.find(0)
  if k >= 0 {
    kt[k] = kind
    kx[k] = 48.0
    ky[k] = y
    kvy[k] = if Random(0, 1) == 0 then 0.35 else -0.35
    khp[k] = KHP[kind]
  }
}
mod spawnEB(x: float, y: float, vx: float, vy: float) {
  let i = ea.find(0)
  if i >= 0 {
    ea[i] = 1
    ex[i] = x
    ey[i] = y
    evx[i] = vx
    evy[i] = vy
  }
}
mod shoot(dy: float) {
  let i = ba.find(0)
  if i >= 0 {
    ba[i] = 1
    bx[i] = hx + 9.0
    by[i] = hy + 2.0
    bdy[i] = dy
  }
}

// ---------- damage
mod hurt() {
  if inv == 0 && bigT == 0 {
    hp -= 1
    inv = 40
    sfx(3)
    if pow > 1 { pow -= 1 }
    if hp <= 0 {
      state = 5
      stT = 0
      if score > hi { hi = score }
      playSong(4)
      say("Super Penis Man has gone soft. SPACE retry", 100000)
    } else { say("OUCH. Stiffness " .. hp .. "/5", 25) }
  }
}
mod kill(k: int) {
  let kind = kt[k]
  score += KSC[kind] * lv
  if bigM < 100 {
    bigM = min(100, bigM + 8)
    if bigM >= 100 {
      sfx(8)
      say("THE BIG ONE is ready! SPACE!", 40)
    } else { sfx(2) }
  } else { sfx(2) }
  let r = Random(0, 11)
  kt[k] = if r == 0 then 4 else (if r == 1 && hp < 5 then 5 else 0)
}
mod levelClear() {
  bossOn = false
  clearAll()
  state = 3
  stT = 0
  score += 1000 * lv
  if score > hi { hi = score }
  playSong(3)
  say(BDEFEAT[lv - 1] .. " +" .. 1000 * lv, 100000)
}
mod bossHit(n: int) {
  bossHp -= n
  bossF = 3
  sfx(1)
  if bossHp <= 0 { levelClear() }
}

// ---------- levels
mod startLevel() {
  state = 1
  stT = 0
  setScene()
  clearAll()
  bossOn = false
  dist = 0.0
  spawnT = 30.0
  hx = 6.0
  hy = 16.0
  inv = 30
  playSong(1)
  say("DAY " .. day .. " - " .. LVMSG[lv - 1], 90)
}
mod startBoss() {
  bossOn = true
  bossX = 48.0
  bossY = 12.0
  bossV = 0.25 + lv * 0.08 + day * 0.04
  bossHp = BHP[lv - 1] + (day - 1) * 10
  bossMax = bossHp
  bossT = 0
  playSong(2)
  sfx(7)
  say(BINTRO[lv - 1], 90)
}
mod newGame() {
  day = 1
  lv = 1
  score = 0
  hp = 5
  pow = 1
  bigM = 0
  startLevel()
}

mod flyTick() {
  // the hero
  let sp = 0.7
  if kL { hx = hx - sp }
  if kR { hx = hx + sp }
  if kU { hy = hy - sp }
  if kD { hy = hy + sp }
  hx = max(0.0, min(30.0, hx))
  hy = max(3.0, min(29.0, hy))
  if inv > 0 { inv -= 1 }
  if fireT > 0 { fireT -= 1 }
  if kS && fireT == 0 {
    shoot(0.0)
    if pow >= 2 {
      shoot(-0.3)
      shoot(0.3)
    }
    fireT = if pow >= 3 then 4 else 6
    if fxId < 0 { sfx(0) }
  }
  if kJ && !pJ && bigM >= 100 {
    bigM = 0
    bigT = 24
    sfx(6)
    say("THE BIG ONE!!!", 30)
    for k in 0..NK {
      if kt[k] > 0 && kt[k] < 4 { kill(k) }
    }
    for i in 0..NE { ea[i] = 0 }
    if bossOn { bossHit(8) }
  }
  if bigT > 0 { bigT -= 1 }
  if bossF > 0 { bossF -= 1 }

  // the level scrolls on until the boss
  if !bossOn && state == 1 {
    dist = dist + 1.0
    spawnT = spawnT - 1.0
    if spawnT <= 0.0 {
      let r = Random(0, 9)
      let y: float = Random(3, 28) * 1.0
      if r < 4 + (if lv == 1 then 3 else 0) { spawnEnemy(1, y) }
      else if r < 7 && lv >= 2 { spawnEnemy(2, y) }
      else if lv >= 2 || r < 9 { spawnEnemy(3, y) }
      else { spawnEnemy(1, y) }
      if Random(0, 2) == 0 { spawnEnemy(1, max(3.0, min(28.0, y + 6.0))) }
      spawnT = Random(14, 30) * 1.0 - lv * 2.0 - day * 2.0
    }
    if dist >= GOAL[lv - 1] { startBoss() }
  }

  // enemies
  for k in 0..NK {
    let kind = kt[k]
    if kind > 0 {
      kx[k] = kx[k] - KSP[kind] - day * 0.05
      if kind == 1 {
        ky[k] = ky[k] + kvy[k]
        if ky[k] < 3.0 || ky[k] > 28.0 { kvy[k] = 0.0 - kvy[k] }
      } else if kind == 3 {
        ky[k] = ky[k] + (if ky[k] < hy then 0.2 else -0.2)
      } else if kind == 2 && kx[k] < 46.0 && Random(0, 45) == 0 {
        spawnEB(kx[k] - 2.0, ky[k] + 2.0, -1.0, 0.0)
      }
      if kx[k] < -6.0 { kt[k] = 0 }
      else if overlap(hx + 2.0, hy + 1.0, 7.0, 3.0, kx[k], ky[k], KW[kind], KH[kind]) {
        if kind == 4 {
          kt[k] = 0
          pow = min(3, pow + 1)
          score += 500
          sfx(4)
          say("STIFFNESS PILL! Power up. See a doctor after 4 hours.", 40)
        } else if kind == 5 {
          kt[k] = 0
          hp = min(5, hp + 1)
          sfx(5)
          say("+1 STIFFNESS", 25)
        } else {
          kt[k] = 0
          hurt()
        }
      }
    }
  }

  // laser vision
  for i in 0..NB {
    if ba[i] > 0 {
      bx[i] = bx[i] + 1.6
      by[i] = by[i] + bdy[i]
      if bx[i] > 48.0 || by[i] < 2.0 || by[i] > 33.0 { ba[i] = 0 }
      else {
        for k in 0..NK {
          let kind = kt[k]
          if ba[i] > 0 && kind > 0 && kind < 4 && overlap(bx[i], by[i], 2.0, 1.0, kx[k], ky[k], KW[kind], KH[kind]) {
            ba[i] = 0
            khp[k] -= 1
            if khp[k] <= 0 { kill(k) } else { sfx(1) }
          }
        }
        if ba[i] > 0 && bossOn && overlap(bx[i], by[i], 2.0, 1.0, bossX, bossY, SW[BOSS[lv - 1]], SH[BOSS[lv - 1]]) {
          ba[i] = 0
          bossHit(1)
        }
      }
    }
  }

  // enemy shots
  for i in 0..NE {
    if ea[i] > 0 {
      ex[i] = ex[i] + evx[i]
      ey[i] = ey[i] + evy[i]
      if ex[i] < -2.0 || ey[i] < 2.0 || ey[i] > 34.0 { ea[i] = 0 }
      else if overlap(hx + 2.0, hy + 1.0, 7.0, 3.0, ex[i], ey[i], 2.0, 1.0) {
        ea[i] = 0
        hurt()
      }
    }
  }

  // the boss
  if bossOn && state == 1 {
    let bw = SW[BOSS[lv - 1]]
    let bh = SH[BOSS[lv - 1]]
    if bossX > 46.0 - bw { bossX = bossX - 0.3 }
    bossY = bossY + bossV
    if bossY < 3.0 || bossY > 33.0 - bh { bossV = 0.0 - bossV }
    bossT += 1
    if bossT % (34 - lv * 4 - min(day, 4) * 2) == 0 {
      let cy = bossY + bh / 2.0
      let aim = max(-0.6, min(0.6, (hy + 2.0 - cy) / max(4.0, (bossX - hx) / 0.9)))
      spawnEB(bossX - 2.0, cy, -0.9, aim)
      if lv >= 2 {
        spawnEB(bossX - 2.0, cy, -0.9, aim - 0.3)
        spawnEB(bossX - 2.0, cy, -0.9, aim + 0.3)
      }
    }
    if overlap(hx + 2.0, hy + 1.0, 7.0, 3.0, bossX, bossY, bw, bh) { hurt() }
  }
}

// ---------- power
mod powerOn() {
  booted = true
  state = 0
  stT = 0
  setScene()
  clearAll()
  bossOn = false
  playSong(0)
  say("SPACE start. He's hard on crime. W A S D fly, E lasers.", 100000)
}
mod powerOff() {
  booted = false
  state = -1
  song = -1
  fxId = -1
  aV0 = 0.0
  aV1 = 0.0
  aV2 = 0.0
  msg = ""
  hud = ""
  st0 = ""
  st1 = ""
  st2 = ""
  st3 = ""
  st4 = ""
  st5 = ""
  st6 = ""
  st7 = ""
  st8 = ""
}

on tick {
  let pwr = seated
  if !pwr {
    if booted { powerOff() }
  } else {
    if !booted { powerOn() }
    kL = left
    kR = right
    kU = up
    kD = down
    kJ = big
    kS = fire
    t += 1
    stT += 1
    if state == 0 {
      if stT > 10 && ((kJ && !pJ) || (kS && !pS)) {
        newGame()
        pJ = true
        pS = true
      }
    } else if state == 1 {
      flyTick()
    } else if state == 3 {
      if stT > 90 {
        if lv < 3 {
          lv += 1
          startLevel()
        } else {
          state = 4
          stT = 0
          say("WANGTOWN IS SAFE. The key to the city is shaped like you. SPACE", 100000)
        }
      }
    } else if state == 4 {
      if stT > 30 && kJ && !pJ {
        day += 1
        lv = 1
        startLevel()
        pJ = true
      }
    } else if state == 5 {
      if stT > 30 && kJ && !pJ {
        newGame()
        pJ = true
      }
    }
    if msgT > 0 {
      msgT -= 1
      if msgT == 0 { msg = "" }
    }
    hud = if state == 0 then ("HARD ON CRIME SINCE 1987. HI " .. hi)
      else ("SCORE " .. score .. "  STIFF " .. hp .. "  POW " .. pow .. "  BIG " .. bigM .. "%  DAY " .. day .. "-" .. lv)
    audio()
    if t % 2 == 0 {
      draw()
      encode(0, 18)
    } else {
      encode(18, H)
    }
    pJ = kJ
    pS = kS
  }
}
