// GENERATED by upgrades/gen.mjs: edit that, not this
var players: controller[]
var idx: int = 0
var lastAmmo: Map<string, float>
// who last hurt each character, for kill credit when CharacterDied gives no killer
var hitBy: Map<character, controller>

on GlobalCustomEvent("upg") -> (who: character, id: int) {
  let ctrl = who.ControllerOf()
  let col = floor(id / 10)
  let want = id - col * 10
  let coins = ctrl.GetLeaderboard("coins")
  if col == 0 {
    let c0 = ctrl.GetLeaderboard("up_ammo")
    if want == 1 && c0 > 0 {
      let back = 100 * (pow(2.0, c0) - 1.0)
      ctrl.IncLeaderboard("coins", back)
      ctrl.SetLeaderboard("up_ammo", 0)
      ctrl.ShowStatusMessage("<color=\"ffd34d\">Ammo Regen</> sold back for <color=\"f6ce2a\">${back} coins</>. Level 0.")
    } else if want <= c0 {
      ctrl.ShowStatusMessage("<color=\"ffd34d\">Ammo Regen</> is already level ${c0}. Click Level 1 to sell it all back.")
    } else {
      let top = floor(log(coins / 100.0 + pow(2.0, c0), 2.0) + 0.000001)
      let lv = min(want, top)
      if lv > c0 {
        let spent = 100 * (pow(2.0, lv) - pow(2.0, c0))
        ctrl.IncLeaderboard("coins", 0 - spent)
        ctrl.SetLeaderboard("up_ammo", lv)
        ctrl.ShowStatusMessage("<color=\"ffd34d\">Ammo Regen</> level ${lv} for <color=\"f6ce2a\">${spent} coins</>.")
      } else {
        ctrl.ShowStatusMessage("<color=\"ff8888\">Ammo Regen level ${c0 + 1} costs ${100 * pow(2.0, c0)} coins. You have ${coins}.</>")
      }
    }
  }
  if col == 1 {
    let c0 = ctrl.GetLeaderboard("up_regen")
    if want == 1 && c0 > 0 {
      let back = 100 * (pow(2.0, c0) - 1.0)
      ctrl.IncLeaderboard("coins", back)
      ctrl.SetLeaderboard("up_regen", 0)
      ctrl.ShowStatusMessage("<color=\"ffd34d\">Health Regen</> sold back for <color=\"f6ce2a\">${back} coins</>. Level 0.")
    } else if want <= c0 {
      ctrl.ShowStatusMessage("<color=\"ffd34d\">Health Regen</> is already level ${c0}. Click Level 1 to sell it all back.")
    } else {
      let top = floor(log(coins / 100.0 + pow(2.0, c0), 2.0) + 0.000001)
      let lv = min(want, top)
      if lv > c0 {
        let spent = 100 * (pow(2.0, lv) - pow(2.0, c0))
        ctrl.IncLeaderboard("coins", 0 - spent)
        ctrl.SetLeaderboard("up_regen", lv)
        ctrl.ShowStatusMessage("<color=\"ffd34d\">Health Regen</> level ${lv} for <color=\"f6ce2a\">${spent} coins</>.")
      } else {
        ctrl.ShowStatusMessage("<color=\"ff8888\">Health Regen level ${c0 + 1} costs ${100 * pow(2.0, c0)} coins. You have ${coins}.</>")
      }
    }
  }
  if col == 2 {
    let c0 = ctrl.GetLeaderboard("up_magnet")
    if want == 1 && c0 > 0 {
      let back = 100 * (pow(2.0, c0) - 1.0)
      ctrl.IncLeaderboard("coins", back)
      ctrl.SetLeaderboard("up_magnet", 0)
      ctrl.ShowStatusMessage("<color=\"ffd34d\">Coin Magnet</> sold back for <color=\"f6ce2a\">${back} coins</>. Level 0.")
    } else if want <= c0 {
      ctrl.ShowStatusMessage("<color=\"ffd34d\">Coin Magnet</> is already level ${c0}. Click Level 1 to sell it all back.")
    } else {
      let top = floor(log(coins / 100.0 + pow(2.0, c0), 2.0) + 0.000001)
      let lv = min(want, top)
      if lv > c0 {
        let spent = 100 * (pow(2.0, lv) - pow(2.0, c0))
        ctrl.IncLeaderboard("coins", 0 - spent)
        ctrl.SetLeaderboard("up_magnet", lv)
        ctrl.ShowStatusMessage("<color=\"ffd34d\">Coin Magnet</> level ${lv} for <color=\"f6ce2a\">${spent} coins</>.")
      } else {
        ctrl.ShowStatusMessage("<color=\"ff8888\">Coin Magnet level ${c0 + 1} costs ${100 * pow(2.0, c0)} coins. You have ${coins}.</>")
      }
    }
  }
  if col == 3 {
    let c0 = ctrl.GetLeaderboard("up_vamp")
    if want == 1 && c0 > 0 {
      let back = 100 * (pow(2.0, c0) - 1.0)
      ctrl.IncLeaderboard("coins", back)
      ctrl.SetLeaderboard("up_vamp", 0)
      ctrl.ShowStatusMessage("<color=\"ffd34d\">Vampirism</> sold back for <color=\"f6ce2a\">${back} coins</>. Level 0.")
    } else if want <= c0 {
      ctrl.ShowStatusMessage("<color=\"ffd34d\">Vampirism</> is already level ${c0}. Click Level 1 to sell it all back.")
    } else {
      let top = floor(log(coins / 100.0 + pow(2.0, c0), 2.0) + 0.000001)
      let lv = min(want, top)
      if lv > c0 {
        let spent = 100 * (pow(2.0, lv) - pow(2.0, c0))
        ctrl.IncLeaderboard("coins", 0 - spent)
        ctrl.SetLeaderboard("up_vamp", lv)
        ctrl.ShowStatusMessage("<color=\"ffd34d\">Vampirism</> level ${lv} for <color=\"f6ce2a\">${spent} coins</>.")
      } else {
        ctrl.ShowStatusMessage("<color=\"ff8888\">Vampirism level ${c0 + 1} costs ${100 * pow(2.0, c0)} coins. You have ${coins}.</>")
      }
    }
  }
  if col == 4 {
    let c0 = ctrl.GetLeaderboard("up_hp")
    if want == 1 && c0 > 0 {
      let back = 100 * (pow(2.0, c0) - 1.0)
      ctrl.IncLeaderboard("coins", back)
      ctrl.SetLeaderboard("up_hp", 0)
      ctrl.ShowStatusMessage("<color=\"ffd34d\">Max HP</> sold back for <color=\"f6ce2a\">${back} coins</>. Level 0.")
    } else if want <= c0 {
      ctrl.ShowStatusMessage("<color=\"ffd34d\">Max HP</> is already level ${c0}. Click Level 1 to sell it all back.")
    } else {
      let top = floor(log(coins / 100.0 + pow(2.0, c0), 2.0) + 0.000001)
      let lv = min(want, top)
      if lv > c0 {
        let spent = 100 * (pow(2.0, lv) - pow(2.0, c0))
        ctrl.IncLeaderboard("coins", 0 - spent)
        ctrl.SetLeaderboard("up_hp", lv)
        ctrl.ShowStatusMessage("<color=\"ffd34d\">Max HP</> level ${lv} for <color=\"f6ce2a\">${spent} coins</>.")
      } else {
        ctrl.ShowStatusMessage("<color=\"ff8888\">Max HP level ${c0 + 1} costs ${100 * pow(2.0, c0)} coins. You have ${coins}.</>")
      }
    }
  }
  // every click answers with all of that player's levels
  ctrl.ShowChatMessage("<color=\"88ccff\">Ammo Regen ${ctrl.GetLeaderboard("up_ammo")} | Health Regen ${ctrl.GetLeaderboard("up_regen")} | Coin Magnet ${ctrl.GetLeaderboard("up_magnet")} | Vampirism ${ctrl.GetLeaderboard("up_vamp")} | Max HP ${ctrl.GetLeaderboard("up_hp")}</> | <color=\"f6ce2a\">${ctrl.GetLeaderboard("coins")} coins</>")
}

// one player per tick, round robin: each visit covers (players x 0.2 s)
on Clock(interval = 0.2) {
  players.fillFromPlayers()
  let n = players.length()
  if n > 0 {
    if idx >= n {
      idx = 0
    }
    let p = players[idx]
    idx = idx + 1
    let ch = p.CharacterOf()
    let d = ch.GetDamage()
    if d.DamageLimit > 0.0 {
      let dt = n * 0.2
      let lRegen = p.GetLeaderboard("up_regen")
      let lHp = p.GetLeaderboard("up_hp")
      let cap = min(d.DamageLimit, 100.0 + 66.6667 * lHp)
      let floorDmg = d.DamageLimit - cap
      // only touch damage when it changes (owner: the game's own regen healed past the level cap and
      // ticked the hurt sound forever); dead characters left alone
      let target = max(floorDmg, d.Damage - lRegen * dt)
      if d.Damage < d.DamageLimit && target != d.Damage {
        ch.SetDamage(target)
      }
      let lAmmo = p.GetLeaderboard("up_ammo")
      let uid = p.GetUserId()
      let now = ServerUptime()
      if lAmmo > 0 && (!lastAmmo.has(uid) || now - lastAmmo.get(uid) >= 5.0 || now < lastAmmo.get(uid)) {
        lastAmmo.set(uid, now)
        let aArrow = ch.GetAmmo($BRWeaponResource/WeaponResource_Ammo_Arrow)
        ch.SetAmmo($BRWeaponResource/WeaponResource_Ammo_Arrow, aArrow + 1 * lAmmo)
        let aLight = ch.GetAmmo($BRWeaponResource/WeaponResource_Ammo_Light)
        ch.SetAmmo($BRWeaponResource/WeaponResource_Ammo_Light, aLight + 3 * lAmmo)
        let aMedium = ch.GetAmmo($BRWeaponResource/WeaponResource_Ammo_Medium)
        ch.SetAmmo($BRWeaponResource/WeaponResource_Ammo_Medium, aMedium + 2 * lAmmo)
        let aHeavy = ch.GetAmmo($BRWeaponResource/WeaponResource_Ammo_Heavy)
        ch.SetAmmo($BRWeaponResource/WeaponResource_Ammo_Heavy, aHeavy + 1 * lAmmo)
        let aMagnum = ch.GetAmmo($BRWeaponResource/WeaponResource_Ammo_Magnum)
        ch.SetAmmo($BRWeaponResource/WeaponResource_Ammo_Magnum, aMagnum + 1 * lAmmo)
        let aShotgun = ch.GetAmmo($BRWeaponResource/WeaponResource_Ammo_Shotgun)
        ch.SetAmmo($BRWeaponResource/WeaponResource_Ammo_Shotgun, aShotgun + 1 * lAmmo)
        let aBlackPowder = ch.GetAmmo($BRWeaponResource/WeaponResource_Ammo_BlackPowder)
        ch.SetAmmo($BRWeaponResource/WeaponResource_Ammo_BlackPowder, aBlackPowder + 1 * lAmmo)
      }
    }
  }
}

on CharacterDamaged() -> (victim, damage, attacker, attackerWeapon, attackerWeaponName) {
  let ac = attacker.ControllerOf()
  if ac.GetUserName().Length() > 0 && victim != attacker {
    hitBy.set(victim, ac)
    let lVamp = ac.GetLeaderboard("up_vamp")
    if lVamp > 0 {
      let ad = attacker.GetDamage()
      attacker.SetDamage(max(ad.DamageLimit - min(ad.DamageLimit, 100.0 + 66.6667 * ac.GetLeaderboard("up_hp")), ad.Damage - damage * 0.05 * lVamp))
    }
  }
}

on CharacterDied() -> (who, killer, killerWeapon, killerWeaponName) {
  if who.ControllerOf().GetUserName().Length() == 0 {
    var kc = killer.ControllerOf()
    if kc.GetUserName().Length() == 0 && hitBy.has(who) {
      kc = hitBy.get(who)
    }
    hitBy.remove(who)
    if kc.GetUserName().Length() > 0 {
      let lMag = kc.GetLeaderboard("up_magnet")
      if lMag > 0 && Random(0, 99) < 10 * lMag {
        let pay = floor(who.GetDamage().DamageLimit / 20.0) + 5
        kc.IncLeaderboard("coins", pay)
        kc.ShowStatusMessage("<color=\"f6ce2a\">Coin Magnet: +${pay} coins</>")
      }
    }
  }
}
