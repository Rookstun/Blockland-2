// per panel: the press records act (1 show tpK, 2 hide) and ONE buffered flush at the very end fires them next tick
// (a buffer emit ends its exec chain: emitting per slot mid-handler ran only the first changed slot and no status line)
let flush: exec
out tp0: int
out show0: exec
out hide0: exec
var act0: int = 0
on flush {
  let a = act0
  act0 = 0
  if a == 1 {
    emit show0
  } else if a == 2 {
    emit hide0
  }
}
out tp1: int
out show1: exec
out hide1: exec
var act1: int = 0
on flush {
  let a = act1
  act1 = 0
  if a == 1 {
    emit show1
  } else if a == 2 {
    emit hide1
  }
}
out tp2: int
out show2: exec
out hide2: exec
var act2: int = 0
on flush {
  let a = act2
  act2 = 0
  if a == 1 {
    emit show2
  } else if a == 2 {
    emit hide2
  }
}
out tp3: int
out show3: exec
out hide3: exec
var act3: int = 0
on flush {
  let a = act3
  act3 = 0
  if a == 1 {
    emit show3
  } else if a == 2 {
    emit hide3
  }
}
out tp4: int
out show4: exec
out hide4: exec
var act4: int = 0
on flush {
  let a = act4
  act4 = 0
  if a == 1 {
    emit show4
  } else if a == 2 {
    emit hide4
  }
}

