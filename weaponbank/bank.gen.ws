          who.AddInventoryItemAdv($BRItemBase/Weapon_Bow, damage = 0.800, speed = 2.250, itemName = "Oak Bow", overrideColors = true, meshColors = [ColorSRGB(186, 137, 0, 255), ColorSRGB(255, 255, 255, 255), ColorSRGB(207, 0, 0, 255), ColorSRGB(170, 170, 170, 255), ColorSRGB(255, 255, 255, 255), ColorSRGB(255, 255, 255, 255), ColorSRGB(255, 255, 255, 255), ColorSRGB(255, 255, 255, 255)])
        } else if cur == 44 {
          who.AddInventoryItemAdv($BRItemBase/Weapon_Bow, speed = 2.500, itemName = "Willow Bow", overrideColors = true, meshColors = [ColorSRGB(183, 186, 130, 255), ColorSRGB(255, 255, 255, 255), ColorSRGB(207, 0, 0, 255), ColorSRGB(170, 170, 170, 255), ColorSRGB(255, 255, 255, 255), ColorSRGB(255, 255, 255, 255), ColorSRGB(255, 255, 255, 255), ColorSRGB(255, 255, 255, 255)])
        } else if cur == 45 {
          who.AddInventoryItemAdv($BRItemBase/Weapon_Bow, damage = 1.100, speed = 2.750, itemName = "Maple Bow", overrideColors = true, meshColors = [ColorSRGB(186, 140, 157, 255), ColorSRGB(255, 255, 255, 255), ColorSRGB(207, 0, 0, 255), ColorSRGB(170, 170, 170, 255), ColorSRGB(255, 255, 255, 255), ColorSRGB(255, 255, 255, 255), ColorSRGB(255, 255, 255, 255), ColorSRGB(255, 255, 255, 255)])
        } else if cur == 46 {
          who.AddInventoryItemAdv($BRItemBase/Weapon_Bow, damage = 1.300, speed = 3.250, itemName = "Yew Bow", overrideColors = true, meshColors = [ColorSRGB(185, 157, 0, 255), ColorSRGB(255, 255, 255, 255), ColorSRGB(207, 0, 0, 255), ColorSRGB(170, 170, 170, 255), ColorSRGB(255, 255, 255, 255), ColorSRGB(255, 255, 255, 255), ColorSRGB(255, 255, 255, 255), ColorSRGB(255, 255, 255, 255)])
        } else if cur == 47 {
          who.AddInventoryItemAdv($BRItemBase/Weapon_Bow, damage = 1.500, speed = 3.750, itemName = "Magic Bow", overrideColors = true, meshColors = [ColorSRGB(4, 210, 255, 255), ColorSRGB(255, 255, 255, 255), ColorSRGB(207, 0, 0, 255), ColorSRGB(170, 170, 170, 255), ColorSRGB(255, 255, 255, 255), ColorSRGB(255, 255, 255, 255), ColorSRGB(255, 255, 255, 255), ColorSRGB(255, 255, 255, 255)])
        } else if cur == 48 {
          who.AddInventoryItemAdv($BRItemBase/Weapon_GuardPistol, itemName = "Guard Pistol")
        } else if cur == 49 {
          who.AddInventoryItemAdv($BRItemBase/Weapon_Derringer, itemName = "Derringer")
        } else if cur == 50 {
          who.AddInventoryItemAdv($BRItemBase/Weapon_Revolver, itemName = "Revolver")
        } else if cur == 51 {
          who.AddInventoryItemAdv($BRItemBase/Weapon_HuntingShotgun, itemName = "Hunting Shotgun")
        } else if cur == 52 {
          who.AddInventoryItemAdv($BRItemBase/Weapon_LeverActionRifle, itemName = "Lever-Action Rifle")
        } else if cur == 53 {
          who.AddInventoryItemAdv($BRItemBase/Weapon_BoltActionRifle, itemName = "Bolt-Action Rifle")
        } else if cur == 54 {
          who.AddInventoryItemAdv($BRItemBase/Weapon_MagnumPistol, itemName = "Magnum")
        }
        // skeleton_drop names the plain slot it finds next (as after a restart), so it keeps its name
        pc.SetLeaderboard("InvName0", catIds.get(cur))
        pc.SetLeaderboard("InvName1", 0)
        pc.SetLeaderboard("InvName2", 0)
        pc.SetLeaderboard("InvName3", 0)
        pc.SetLeaderboard("InvName4", 0)
        pc.SetLeaderboard("InvName5", 0)
        pc.SetLeaderboard("InvName6", 0)
        pc.SetLeaderboard("InvName7", 0)
        pc.SetLeaderboard("InvName8", 0)
        pc.SetLeaderboard("InvName9", 0)
        pc.SetLeaderboard("InvPend", 1)
        pc.ShowStatusMessage("<color=\"88ff88\">${nm}</> taken from your bank.")
      }
    } else {
      pc.ShowStatusMessage("<color=\"ffd34d\">${nm}</> (${pos}/${count}) - middle button: take it")
    }
  }
  buffer emit flush
}
