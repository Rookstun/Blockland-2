on GlobalCustomEvent("bank.act") -> (who: character, op: int) {
  let pc = who.ControllerOf()
  let uid = pc.GetUserId()
  let b0 = owned.get(uid)
  let bits = if b0.Length() == 55 then b0 else "0000000000000000000000000000000000000000000000000000000"
  let r0 = ownedR.get(uid)
  let rev = if r0.Length() == 55 then r0 else "0000000000000000000000000000000000000000000000000000000"
  let first = bits.Find("1")
  PrintToConsole("bankdbg|${op}|${uid}|${first}")
  // nothing to show: the user left, or has nothing yet
  let none = (op == 4 && uid == viewer) || (op != 4 && first < 0)
  if none {
    if shown.get(0) > 0 {
      act0 = 2
    }
    if shown.get(1) > 0 {
      act1 = 2
    }
    if shown.get(2) > 0 {
      act2 = 2
    }
    if shown.get(3) > 0 {
      act3 = 2
    }
    if shown.get(4) > 0 {
      act4 = 2
    }
    shown.clear()
    viewer = ""
    if op != 4 {
      pc.ShowStatusMessage("<color=\"ffd34d\">Weapon bank</>: empty. Weapons you buy at the shops show up here, free to take again.")
    }
  } else if op != 4 {
    viewer = uid
    let sv = sel.get(uid) - 1
    let cur0 = if sv >= 0 && bits.Substring(sv, 1) == "1" then sv else first
    let nx = bits.Find("1", false, cur0 + 1)
    let pq = rev.Find("1", false, 55 - cur0)
    let lastQ = rev.Find("1")
    let cur = if op == 1 then (if pq < 0 then 54 - lastQ else 54 - pq) else (if op == 2 then (if nx < 0 then first else nx) else cur0)
    sel.set(uid, cur + 1)
    let r1 = bits.Find("1", false, cur + 1)
    let r2 = if r1 < 0 then -1 else bits.Find("1", false, r1 + 1)
    let lq1 = rev.Find("1", false, 55 - cur)
    let l1 = if lq1 < 0 then -1 else 54 - lq1
    let lq2 = if l1 < 0 then -1 else rev.Find("1", false, 55 - l1)
    let l2 = if lq2 < 0 then -1 else 54 - lq2
    let was0 = shown.get(0) - 1
    let was1 = shown.get(1) - 1
    let was2 = shown.get(2) - 1
    let was3 = shown.get(3) - 1
    let was4 = shown.get(4) - 1
    PrintToConsole("bankdisp|${l2},${l1},${cur},${r1},${r2}|was ${was0},${was1},${was2},${was3},${was4}")
    if was0 != l2 {
      if l2 >= 0 {
        out tp0 = l2
        act0 = 1
      } else {
        act0 = 2
      }
      shown.set(0, l2 + 1)
    }
    if was1 != l1 {
      if l1 >= 0 {
        out tp1 = l1
        act1 = 1
      } else {
        act1 = 2
      }
      shown.set(1, l1 + 1)
    }
    if was2 != cur {
      if cur >= 0 {
        out tp2 = cur
        act2 = 1
      } else {
        act2 = 2
      }
      shown.set(2, cur + 1)
    }
    if was3 != r1 {
      if r1 >= 0 {
        out tp3 = r1
        act3 = 1
      } else {
        act3 = 2
      }
      shown.set(3, r1 + 1)
    }
    if was4 != r2 {
      if r2 >= 0 {
        out tp4 = r2
        act4 = 1
      } else {
        act4 = 2
      }
      shown.set(4, r2 + 1)
    }
    let count = 55 - bits.Replace("1", "").Length()
    let pos = bits.Substring(0, cur + 1).Replace("0", "").Length()
    let nm = names.get(cur)
    if op == 3 {
      let key = "${uid}:${cur}"
      let last = gaveAt.get(key)
      let now = GetUnixTime()
      if held.get(uid).Contains("|${nm}|") || (last > 0 && now - last < 15) {
        pc.ShowStatusMessage("<color=\"ff8888\">You already have a ${nm}.</> One at a time.")
      } else {
